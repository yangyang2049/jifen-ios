"scoreboard_usage_hint_snooker" = "🔴 Za točkovanje tapnite gumbe za rdečo kroglo, barvne krogle ali točke\n⚠️ Kazenske točke zabeležite z možnostjo Prekršek\n🔁 Tapnite Zamenjaj igralca, da zamenjate igralca na potezi\n↩️ Napako najprej razveljavite ali uporabite urejanje\n☑️ Po potrebi odprite Obračunaj v spodnjem desnem meniju";
"scoreboard_usage_hint_guandan" = "👆 Z levimi in desnimi kontrolniki beležite rezultate in napredovanje po ravneh\n↕️ V načinu urejanja povlecite navpično na katerikoli strani za hitro spremembo njene ravni\n🅰️ Uspešno A, ponastavitev, razveljavitev in ročni zaključek so na tabli ali v meniju\n↩️ Pred nadaljevanjem s trenutne ravni razveljavite napako";
"scoreboard_usage_hint_shengji" = "👆 Najprej za katerokoli ekipo tapnite Poteguj se za delivca\n🏆 Vsak krog zabeležite z možnostjo Prevzemi vlogo delivca ali gumbi +1, +2 in +3\n↩️ Prejšnji krog razveljavite v meniju\n✏️ S svinčnikom zgoraj desno uredite imena ekip in ravni\n🔄 Tekmo lahko ročno ponastavite ali končate";
"scoreboard_usage_hint_uno" = "👆 Tapnite igralca, da odprete ploščo za točkovanje\n✏️ Dolgo pritisnite igralca, da uredite ime in rezultat\n↩️ Razveljavi prejšnji krog\n☑️ Poravnajte ali končajte tekmo ročno\n🖼️ Nastavitve zaslona in posnetki zaslona so v meniju";
"scoreboard_usage_hint_doudizhu" = "➕ Tapnite gumb plus na sredini spodaj, da odprete obračun kroga\n🧮 Izberite osnovni rezultat, množitelj in enega zmagovalca ali vse razen enega poraženca\n↩️ Povlecite v levo ali uporabite meni za razveljavitev prejšnjega kroga\n✏️ Dotaknite se svinčnika zgoraj desno, da uredite igralce in rezultate\n🔄 Ponastavite ali dokončajte igro ročno";
"scoreboard_usage_hint_foosball" = "👆 Dotaknite se levo/desno območja rezultatov, da dodate 1 gol\n⬆️ Za dodajanje povlecite navzgor\n⬇️ Za odštevanje povlecite navzdol\n↩️ Za razveljavitev povlecite v levo\n☑️ Ko se tekma konča, uporabite Obračunaj ali Končaj";
"scoreboard_usage_hint_foosball_doubles" = "👆 Dotaknite se levo/desno območja rezultatov, da dodate 1 gol\n⬆️ Za dodajanje povlecite navzgor\n⬇️ Za odštevanje povlecite navzdol\n↩️ Za razveljavitev povlecite v levo\n👥 Imena 2V2 so nastavljena pred tekmo\n☑️ Ko se tekma konča, uporabite Obračunaj ali Končaj";
"scoreboard_usage_hint_simple_score" = "👆 Tapnite levo/desno območje rezultatov, da dodate\n⬆️ Za dodajanje povlecite navzgor\n⬇️ Za odštevanje povlecite navzdol\n↩️ Za razveljavitev povlecite v levo\n✏️ Dolgo pritisnite ali uredite, da spremenite imena in rezultate";
