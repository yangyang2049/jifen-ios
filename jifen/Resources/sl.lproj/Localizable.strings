"faq_question_1" = "Kako hitro začnem tekmo?";
"faq_answer_1" = "Na zavihku Domov izberite šport ali odprite Nova igra za več možnosti. Pogosto uporabljene športe in nastavitve dodajte v Hitri začetek, da se naslednja tekma odpre hitreje.\n\nPri športih, ki zahtevajo imena ekip, nize, format ali pravila serviranja, se najprej odpre nastavitev igre. Po potrditvi se odpre semafor; nekatere nastavitve lahko prilagodite tudi med točkovanjem.";
"faq_question_2" = "Kako beležim rezultate in popravljam napake?";
"faq_answer_2" = "Športi z žogo običajno omogočajo, da tapnete levo/desno ali zgornjo/spodnjo stran, da dodelite točko, medtem ko nizi, servisi in menjave strani sledijo pravilom. Košarka, nogomet in preprosti semaforji prikazujejo skupne vrednosti točk. Biljard, lokostrelstvo, boks in igre s kartami uporabljajo plošče z rezultati, krogi ali rezultati.\n\nČe se zmotite, najprej uporabite Razveljavi ali Nazaj. Za ročne popravke odprite vnos za urejanje/nastavitve na preglednici. Vsak šport nima ločenih gumbov plus in minus.";
"faq_question_3" = "Zapustil sem semafor. Kako naj nadaljujem ali ga pregledam?";
"faq_answer_3" = "Na zavihku Domov se pri nedokončani tekmi spodaj prikaže pasica za nadaljevanje. Tapnite jo, da nadaljujete točkovanje tam, kjer ste končali. Končane in shranjene tekme najdete na zavihku Zapisi.\n\nČe vnosa ni več, se je tekma morda končala, bila izbrisana ali pa so bili izbrisani lokalni podatki. Zapisi so namenjeni predvsem pregledovanju rezultatov in morda ne omogočajo nadaljevanja prvotne tekme.";
"faq_question_4" = "Kako izbrišem zapise ali podatke?";
"faq_answer_4" = "Med tekmo uporabite Razveljavi, Nazaj ali urejanje, če izbrani šport to podpira.\n\nShranjeno tekmo odprite na zavihku Zapisi in jo tam izbrišite. Jaz → Počisti podatke odstrani lokalne rezultate, časovnike, nedokončane tekme, shranjene zapise in nekatere lokalne nastavitve. Tega ni mogoče razveljaviti.";
"faq_question_5" = "Kako povežem zaslon ali drug telefon?";
"faq_answer_5" = "Uporabite dve napravi skupaj: ena beleži rezultate, druga jih prikazuje na celotnem zaslonu. Naprava za deljenje: prijavite se in zaženite sinhronizacijo, da dobite 6-mestno kodo. Prikazna naprava: prijavite se in vnesite 6-mestno kodo iz naprave za deljenje. Začnite beležiti rezultate — sinhronizirajo se samodejno.\n\nPriporočamo zrcaljenje zaslona prek AirPlay. Ko je zaslon povezan in zaznan, se semafor samodejno prikaže na velikem zaslonu. Odprite Nadzorni center in tapnite Zrcaljenje zaslona (AirPlay). Povezavo AirPlay najprej vzpostavite v sistemskih nastavitvah; aplikacija lahko uporablja le en povezan zaslon hkrati in sama ne more iskati televizorjev ali projektorjev. Prekinitev povezave AirPlay konča tudi prenos zaslona.";
"faq_question_6" = "Ne najdem svojega športa. Kaj naj storim?";
"faq_answer_6" = "Začnite z najbližjim športom. Če se razlikujejo le imena, nizi, ekipe ali začetni vrstni red, jih prilagodite v nastavitvah igre in dodajte nastavitve v Hitri začetek.\n\nČe trenutni športi ne pokrivajo pravil, pošljite povratne informacije z imenom športa, običajnim formatom, načinom točkovanja in pričakovanim tokom.";
"faq_question_7" = "Kako delujejo članstvo, prijava in nove naprave?";
"faq_answer_7" = "Članske ugodnosti in zapisi nakupov so vezani na trenutni račun. Pred nakupom, unovčenjem kode ali obnovitvijo članstva se prijavite. V novi napravi se prijavite z istim računom in osvežite stran Članstvo.\n\nČe je plačilo uspelo, članstvo pa ni aktivno, najprej osvežite stran za članstvo. Če težava ostaja, odprite Povratne informacije in navedite številko naročila, čas nakupa ter prijavljeni račun.";
"faq_question_8" = "Kako prijavim težavo ali predlagam funkcijo?";
"faq_answer_8" = "Odprite Jaz → Povratne informacije in izberite prijavo napake ali predlog funkcije. Navedite šport, korake, pričakovani in dejanski rezultat. Pri težavah s prikazom ali članstvom dodajte še model naprave, različico sistema in aplikacije.";
"faq_question_10" = "Kako naredim varnostno kopijo svojih podatkov ali jih premaknem v nov telefon?";
"faq_answer_10" = "Prijavite se za sinhronizacijo shranjenih imen ekip, igralcev in krajev med napravami. Na novem telefonu se prijavite z istim računom, da pridobite te pogoste podatke. Zapisi tekem, zapisi časovnikov in nedokončane tekme ostanejo na trenutni napravi; varnostno kopiranje in obnovitev teh zapisov iz oblaka nista na voljo.";
"faq_question_11" = "Kako se obravnavajo moji podatki in zasebnost?";
"faq_answer_11" = "Pravilnik o zasebnosti pojasnjuje, kateri podatki se uporabljajo in zakaj. Mikrofon se uporablja za snemanje glasovnih beležk. Kamera se uporablja za skeniranje zaupanja vrednih prijavnih kod QR in fotografiranje za vaš avatar.";
