"faq_question_1" = "போட்டியை விரைவாக எப்படி தொடங்குவது?";
"faq_answer_1" = "முகப்பில், விளையாட்டைத் தேர்ந்தெடுக்கவும் அல்லது கூடுதல் விருப்பங்களுக்கு புதிய போட்டியைத் திறக்கவும். விரைவு தொடக்கத்தில் அடிக்கடி விளையாட்டு மற்றும் அமைப்புகளைச் சேர்க்கவும், இதனால் அடுத்த போட்டி வேகமாகத் திறக்கப்படும்.\n\nஅணியின் பெயர்கள், செட்கள், வடிவம் அல்லது சேவை விதிகள் தேவைப்படும் விளையாட்டுகள் முதலில் கேம் அமைப்பைத் திறக்கும். உறுதிப்படுத்திய பிறகு, ஸ்கோர்போர்டு திறக்கிறது; ஸ்கோரிங் செய்யும் போது சில அமைப்புகளை இன்னும் சரிசெய்ய முடியும்.";
"faq_question_2" = "எப்படி ஸ்கோர் செய்து தவறுகளைச் சரிசெய்வது?";
"faq_answer_2" = "பந்து விளையாட்டு பொதுவாக ஒரு புள்ளியை வழங்க இடது/வலது அல்லது மேல்/கீழ் பக்கத்தைத் தட்டவும், அதே நேரத்தில் செட், சர்வ் மற்றும் பக்க மாற்றங்கள் விதிகளைப் பின்பற்றுகின்றன. கூடைப்பந்து, கால்பந்து மற்றும் எளிய ஸ்கோர்போர்டுகள் பொதுவான புள்ளி மதிப்புகளைக் காட்டுகின்றன. பில்லியர்ட்ஸ், வில்வித்தை, குத்துச்சண்டை மற்றும் அட்டை விளையாட்டுகள் ஸ்கோர், ரவுண்ட் அல்லது ரிசல்ட் பேனல்களைப் பயன்படுத்துகின்றன.\n\nநீங்கள் தவறு செய்தால், முதலில் செயல்தவிர் அல்லது பின்செல்லுங்கள். கைமுறை திருத்தங்களுக்கு, ஸ்கோர்போர்டில் இருந்து திருத்து/அமைப்புகள் உள்ளீட்டைத் திறக்கவும். ஒவ்வொரு விளையாட்டுக்கும் தனித்தனி பிளஸ் மற்றும் மைனஸ் பொத்தான்கள் இல்லை.";
"faq_question_3" = "நான் ஸ்கோர்போர்டை விட்டுவிட்டேன். அதை எவ்வாறு தொடர்வது அல்லது மதிப்பாய்வு செய்வது?";
"faq_answer_3" = "முகப்புத் தாவலில், முடிக்கப்படாத போட்டியானது கீழே உள்ள பேனரைக் காட்டுகிறது (போட்டியைத் தொடரவும்); நீங்கள் விட்ட இடத்திலேயே ஸ்கோரைத் தொடங்க அதைத் தட்டவும். முடிக்கப்பட்ட மற்றும் சேமிக்கப்பட்ட போட்டிகள் பதிவுகளில் கிடைக்கின்றன.\n\nஉள்ளீடு இல்லாமல் போனால், போட்டி முடிந்திருக்கலாம், நீக்கப்பட்டிருக்கலாம் அல்லது உள்ளூர் தரவு அழிக்கப்பட்டிருக்கலாம். பதிவுகள் முக்கியமாக முடிவுகளை மதிப்பாய்வு செய்வதற்காகவே உள்ளன, மேலும் அசல் போட்டி ஓட்டத்தைத் தொடர்வதை ஆதரிக்காமல் போகலாம்.";
"faq_question_4" = "பதிவுகளை எப்படி நீக்குவது அல்லது தரவை அழிப்பது?";
"faq_answer_4" = "போட்டியின் போது, ​​தற்போதைய விளையாட்டு ஆதரிக்கும் பட்சத்தில் செயல்தவிர், பின் அல்லது எடிட் உள்ளீட்டைப் பயன்படுத்தவும்.\n\nசேமித்த போட்டிகளுக்கு, பதிவுகளில் உருப்படியைத் திறந்து, அதை அங்கேயே நீக்கவும். நான் → தரவை அழி உள்ளூர் ஸ்கோரிங், டைமர், முடிக்காத போட்டி, சேமிக்கப்பட்ட பதிவு மற்றும் சில உள்ளூர் அமைப்பு தரவு ஆகியவற்றை நீக்குகிறது. இதை செயல்தவிர்க்க முடியாது.";
"faq_question_5" = "டிஸ்பிளே அல்லது வேறொரு ஃபோனை எப்படி இணைப்பது?";
"faq_answer_5" = "இரண்டு சாதனங்களை ஒன்றாகப் பயன்படுத்தவும்: ஒன்று புள்ளிகளைப் பதிவு செய்யும், மற்றொன்று முழுத் திரையில் காட்டும். பகிரும் சாதனம்: உள்நுழைந்து ஒத்திசைவைத் தொடங்கி 6 இலக்கக் குறியீட்டைப் பெறவும். காட்சி சாதனம்: உள்நுழைந்து பகிரும் சாதனத்தின் 6 இலக்கக் குறியீட்டை உள்ளிடவும். புள்ளிகளைப் பதிவு செய்யத் தொடங்குங்கள் — அவை தானாக ஒத்திசையும்.\n\nAirPlay திரைப் பிரதிபலிப்பு பரிந்துரைக்கப்படுகிறது. இணைப்பு கண்டறியப்பட்டதும் ஸ்கோர்போர்டு பெரிய திரையில் தானாகக் காட்டப்படும். கட்டுப்பாட்டு மையத்தைத் திறந்து திரைப் பிரதிபலிப்பு (AirPlay) என்பதைத் தட்டவும். முதலில் சிஸ்டம் அமைப்புகளில் AirPlay இணைப்பை ஏற்படுத்தவும்; பயன்பாடு ஒரே நேரத்தில் ஒரு இணைக்கப்பட்ட திரையை மட்டுமே பயன்படுத்த முடியும், மேலும் டிவிகள் அல்லது புரொஜெக்டர்களைத் தானாகத் தேட முடியாது. AirPlay இணைப்பைத் துண்டித்தால் திரை ஒளிபரப்பும் முடிவடையும்.";
"faq_question_6" = "எனது விளையாட்டை என்னால் கண்டுபிடிக்க முடியவில்லை. நான் என்ன செய்ய வேண்டும்?";
"faq_answer_6" = "நெருங்கிய விளையாட்டுடன் தொடங்கவும். பெயர்கள், செட்கள், அணிகள் அல்லது தொடக்க வரிசை மட்டும் வேறுபட்டால், அவற்றை கேம் அமைப்பில் சரிசெய்து, விரைவு தொடக்கத்தில் அமைப்பைச் சேர்க்கவும்.\n\nதற்போதைய விளையாட்டு விதிகளைப் பின்பற்ற முடியாவிட்டால், விளையாட்டின் பெயர், பொதுவான வடிவம், மதிப்பெண் முறை மற்றும் எதிர்பார்க்கப்படும் ஓட்டம் ஆகியவற்றைக் கொண்டு கருத்துக்களை அனுப்பவும்.";
"faq_question_7" = "உறுப்பினர், உள்நுழைவு மற்றும் புதிய சாதனங்கள் எவ்வாறு செயல்படுகின்றன?";
"faq_answer_7" = "உறுப்பினர் பலன்கள் மற்றும் கொள்முதல் பதிவுகள் நடப்புக் கணக்குடன் இணைக்கப்பட்டுள்ளன. மெம்பர்ஷிப்பை வாங்குவதற்கு, ரிடீம் செய்வதற்கு அல்லது மீட்டெடுப்பதற்கு முன் உள்நுழையவும். புதிய சாதனத்தில், அதே கணக்கில் உள்நுழைந்து உறுப்பினர் மையத்தைப் புதுப்பிக்கவும்.\n\nபணம் செலுத்துதல் வெற்றியடைந்தாலும் உறுப்பினர் செயலில் இல்லை என்றால், முதலில் உறுப்பினர் பக்கத்தைப் புதுப்பிக்கவும். அது இன்னும் தவறாக இருந்தால், ஆர்டர் எண், வாங்கும் நேரம் மற்றும் உள்நுழைந்த கணக்கு ஆகியவற்றைக் கொண்டு கருத்தை அனுப்பவும்.";
"faq_question_8" = "சிக்கலைப் புகாரளிப்பது அல்லது அம்சத்தைப் பரிந்துரைப்பது எப்படி?";
"faq_answer_8" = "நான் → கருத்து என்பதைத் திறந்து பிழை அறிக்கை அல்லது அம்சப் பரிந்துரையைத் தேர்ந்தெடுக்கவும். விளையாட்டு, படிகள், எதிர்பார்க்கப்படும் முடிவு மற்றும் கிடைத்த முடிவைக் குறிப்பிடவும். காட்சி அல்லது உறுப்பினர் சிக்கல்களுக்கு, சாதன மாதிரி, சிஸ்டம் பதிப்பு மற்றும் ஆப்ஸ் பதிப்பையும் குறிப்பிடவும்.";
"faq_question_10" = "எனது தரவை எவ்வாறு காப்புப் பிரதி எடுப்பது அல்லது புதிய மொபைலுக்கு நகர்த்துவது?";
"faq_answer_10" = "சேமித்த அணி மற்றும் வீரர் பெயர்களையும் இடங்களையும் சாதனங்களுக்கு இடையில் ஒத்திசைக்க உள்நுழையவும். புதிய ஃபோனில் அதே கணக்கில் உள்நுழைந்து இந்தப் பொதுவான தரவைப் பெறவும். போட்டிப் பதிவுகள், டைமர் பதிவுகள் மற்றும் முடிக்காத போட்டிகள் தற்போதைய சாதனத்திலேயே இருக்கும்; இவற்றுக்கு கிளவுட் காப்புப்பிரதி மற்றும் மீட்டெடுப்பு வசதி இல்லை.";
"faq_question_11" = "எனது தரவு மற்றும் தனியுரிமை எவ்வாறு கையாளப்படுகிறது?";
"faq_answer_11" = "எந்தத் தரவு ஏன் பயன்படுத்தப்படுகிறது என்பதைத் தனியுரிமைக் கொள்கை விளக்குகிறது. குரல் குறிப்புகளைப் பதிவு செய்ய மைக்ரோஃபோன் பயன்படுத்தப்படுகிறது. நம்பகமான உள்நுழைவு QR குறியீடுகளை ஸ்கேன் செய்யவும் உங்கள் அவதாருக்குப் புகைப்படம் எடுக்கவும் கேமரா பயன்படுத்தப்படுகிறது.";
