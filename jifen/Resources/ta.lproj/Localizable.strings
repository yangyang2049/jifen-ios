"scoreboard_usage_hint_eight_ball" = "👆 ரேக்கை பதிவு செய்ய இடது/வலது மதிப்பெண் பகுதியைத் தட்டவும்\n⬆️ 1 ரேக்கைச் சேர்க்க மேலே ஸ்வைப் செய்யவும்\n⬇️ 1 ரேக்கைக் கழிக்க கீழே ஸ்வைப் செய்யவும்\n↩️ செயல்தவிர்க்க இடதுபுறமாக ஸ்வைப் செய்யவும்\n🏁 போட்டி இலக்கு ரேக்குகளால் முடிவடைகிறது";
"scoreboard_usage_hint_nine_ball" = "👆 சேஸ் புள்ளிகளைப் பதிவு செய்ய ஒரு வீரர், பந்து அல்லது நிகழ்வு பொத்தானைத் தட்டவும்\n🎱 இது சேஸ்-பாயின்ட் பயிற்சி; திரையில் காட்டப்படும் பந்துகள் மற்றும் நிகழ்வுகளைப் பயன்படுத்தவும்\n↩️ இடதுபுறமாக ஸ்வைப் செய்யவும் அல்லது தவறு நடந்தால் முதலில் செயல்தவிர் என்பதைப் பயன்படுத்தவும்\n✏️ விரிவான திருத்தம் தேவைப்படும்போது திருத்தத்தைப் பயன்படுத்தவும்";
"scoreboard_usage_hint_snooker" = "🔴 மதிப்பெண் பெற சிவப்பு, வண்ணம் அல்லது மதிப்பெண் பொத்தான்களைத் தட்டவும்\n⚠️ பெனால்டி புள்ளிகளைப் பதிவு செய்ய ஃபௌலைப் பயன்படுத்தவும்\n🔁 ஸ்ட்ரைக்கரை மாற்ற ஸ்விட்ச் டர்ன் என்பதைத் தட்டவும்\n↩️ முதலில் தவறுகளைச் செயல்தவிர்க்கவும் அல்லது திருத்தத்தைப் பயன்படுத்தவும்\n☑️ தேவைப்படும்போது கீழ்-வலது மெனுவிலிருந்து தீர்வு என்பதைத் திறக்கவும்";
"scoreboard_usage_hint_guandan" = "👆 ஒவ்வொரு முடிவையும் நிலை முன்னேற்றத்தையும் பதிவு செய்ய இடது மற்றும் வலது கட்டுப்பாடுகளைப் பயன்படுத்தவும்\n↕️ எடிட் பயன்முறையில், அதன் நிலையை விரைவாக மாற்ற, இருபுறமும் செங்குத்தாக ஸ்வைப் செய்யவும்\n🅰️ பாஸிங் ஏ, மீட்டமைத்தல், செயல்தவிர்த்தல் மற்றும் கைமுறையாக முடித்தல் ஆகியவை போர்டு அல்லது மெனுவில் கிடைக்கும்\n↩️ தற்போதைய நிலையில் இருந்து தொடர்வதற்கு முன் ஒரு தவறைச் செயல்தவிர்க்கவும்";
"scoreboard_usage_hint_shengji" = "👆 எந்த அணிக்கும் டீலராக ஏலம் கோரவும் என்பதைத் தட்டுவதன் மூலம் தொடங்கவும்\n🏆 டீலர் பொறுப்பை ஏற்கவும் அல்லது +1, +2 மற்றும் +3 பொத்தான்கள் மூலம் ஒவ்வொரு சுற்றுகளையும் பதிவு செய்யவும்\n↩️ மெனுவிலிருந்து முந்தைய சுற்றை செயல்தவிர்க்கவும்\n✏️ அணியின் பெயர்கள் மற்றும் நிலைகளைத் திருத்த, மேல் வலதுபுறத்தில் உள்ள பென்சிலைத் தட்டவும்\n🔄 போட்டியை கைமுறையாக மீட்டமைக்கவும் அல்லது முடிக்கவும்";
"scoreboard_usage_hint_uno" = "👆 ரவுண்ட்-ஸ்கோரிங் பேனலைத் திறக்க ஒரு வீரரைத் தட்டவும்\n✏️ பெயரையும் ஸ்கோரையும் திருத்த பிளேயரை நீண்ட நேரம் அழுத்தவும்\n↩️ முந்தைய சுற்றை செயல்தவிர்க்கவும்\n☑️ போட்டியை கைமுறையாகத் தீர்க்கவும் அல்லது முடிக்கவும்\n🖼️ காட்சி அமைப்புகள் மற்றும் திரைக்காட்சிகள் மெனுவில் உள்ளன";
"scoreboard_usage_hint_doudizhu" = "➕ ரவுண்ட் செட்டில்மென்ட்டைத் திறக்க கீழ் மையத்தில் உள்ள பிளஸ் பட்டனைத் தட்டவும்\n🧮 அடிப்படை மதிப்பெண், பெருக்கி மற்றும் ஒரு வெற்றியாளரைத் தேர்வு செய்யவும் அல்லது ஒரே தோல்வியாளரைத் தவிர மற்ற அனைவரையும் தேர்வு செய்யவும்\n↩️ இடதுபுறமாக ஸ்வைப் செய்யவும் அல்லது முந்தைய சுற்றை செயல்தவிர்க்க மெனுவைப் பயன்படுத்தவும்\n✏️ பிளேயர்களையும் மதிப்பெண்களையும் திருத்த, மேல் வலதுபுறத்தில் உள்ள பென்சிலைத் தட்டவும்\n🔄 போட்டியை கைமுறையாக மீட்டமைக்கவும் அல்லது முடிக்கவும்";
"scoreboard_usage_hint_foosball" = "👆 1 கோலைச் சேர்க்க இடது/வலது ஸ்கோர் பகுதியைத் தட்டவும்\n⬆️ சேர்க்க மேலே ஸ்வைப் செய்யவும்\n⬇️ கழிப்பதற்கு கீழே ஸ்வைப் செய்யவும்\n↩️ செயல்தவிர்க்க இடதுபுறமாக ஸ்வைப் செய்யவும்\n☑️ போட்டி முடியும் போது தீர்வு அல்லது முடி ஐப் பயன்படுத்தவும்";
"scoreboard_usage_hint_foosball_doubles" = "👆 1 கோலைச் சேர்க்க இடது/வலது ஸ்கோர் பகுதியைத் தட்டவும்\n⬆️ சேர்க்க மேலே ஸ்வைப் செய்யவும்\n⬇️ கழிக்க கீழே ஸ்வைப் செய்யவும்\n↩️ செயல்தவிர்க்க இடதுபுறமாக ஸ்வைப் செய்யவும்\n👥 2V2 பெயர்கள் போட்டிக்கு முன் அமைக்கப்பட்டன\n☑️ போட்டி முடிந்ததும் தீர்வு அல்லது முடி ஐப் பயன்படுத்தவும்";
"scoreboard_usage_hint_simple_score" = "👆 சேர்க்க இடது/வலது மதிப்பெண் பகுதியைத் தட்டவும்\n⬆️ சேர்க்க மேலே ஸ்வைப் செய்யவும்\n⬇️ கழிக்க கீழே ஸ்வைப் செய்யவும்\n↩️ செயல்தவிர்க்க இடதுபுறமாக ஸ்வைப் செய்யவும்\n✏️ பெயர்கள் மற்றும் மதிப்பெண்களை மாற்ற நீண்ட நேரம் அழுத்தவும் அல்லது திருத்தவும்";
"scoreboard_usage_hint_multi_scoreboard" = "👆 1 புள்ளியைச் சேர்க்க, பிளேயர் டைலைத் தட்டவும்\n⬆️ 1 ஐச் சேர்க்க மேலே ஸ்வைப் செய்யவும்; ⬇️ 1ஐக் கழிக்க கீழே ஸ்வைப் செய்யவும்\n↩️ செயல்தவிர்க்க இடதுபுறமாக ஸ்வைப் செய்யவும்\n✏️ பெயரையும் ஸ்கோரையும் திருத்த பிளேயரை நீண்ட நேரம் அழுத்தவும்\n🎛️ தனிப்பயன் சரிப்படுத்தும் பயன்முறையில், பிளேயரைத் தட்டினால், சரிசெய்தல் பேனலைத் திறக்கும்";
