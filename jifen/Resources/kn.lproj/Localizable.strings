"scoreboard_usage_hint_archery" = "👆 ಸ್ಪರ್ಧಿಯ ಪ್ರದೇಶವನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ ಬಾಣದ ಅಂಕವನ್ನು ಆಯ್ಕೆ ಮಾಡಿ ಪ್ರತಿ ಬಾಣ ಮತ್ತು ಬಾಣಗಳ ಸುತ್ತನ್ನು ದಾಖಲಿಸಿ\n↩️ ತಪ್ಪನ್ನು ರದ್ದುಗೊಳಿಸಲು ಎಡಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿ\n🏹 ಸೆಟ್ ಅಂಕಗಳು ಆಯ್ದ ಬಿಲ್ಲುಗಾರಿಕೆ ಸ್ವರೂಪವನ್ನು ಅನುಸರಿಸುತ್ತವೆ\n🎯 5–5 ಆದಾಗ ಪರದೆಯಲ್ಲಿನ ಕೇಂದ್ರಕ್ಕೆ ಹತ್ತಿರದ ಬಾಣದಿಂದ ನಿರ್ಧರಿಸುವ ಶೂಟ್-ಆಫ್ ಸೂಚನೆಗಳನ್ನು ಅನುಸರಿಸಿ";
"scoreboard_usage_hint_boxing" = "🥊 ಸುತ್ತಿನಲ್ಲಿ ಎರಡೂ ಬಾಕ್ಸರ್‌ಗಳ ಸ್ಕೋರ್‌ಗಳನ್ನು ನಮೂದಿಸಲು ಸುತ್ತಿನ ಕ್ರಿಯೆಯನ್ನು ಬಳಸಿ\n📊 ಸುತ್ತನ್ನು ಪೂರ್ಣಗೊಳಿಸಿದಾಗ ಒಟ್ಟು ಅಂಕಗಳು ಮತ್ತು ಗೆದ್ದ ಸುತ್ತುಗಳ ಸಂಖ್ಯೆ ನವೀಕರಿಸಲಾಗುತ್ತದೆ\n↩️ ಮೆನುವಿನಿಂದ ತಪ್ಪುಗಳನ್ನು ರದ್ದುಗೊಳಿಸಿ\n✏️ ತಿದ್ದುಪಡಿಯ ಅಗತ್ಯವಿದ್ದಾಗ ಸಂಪಾದನೆಯನ್ನು ಬಳಸಿ ಅಥವಾ ಮುಗಿಸಿ";
"scoreboard_usage_hint_billiards" = "👆 ಸೇರಿಸಲು ಎಡ/ಬಲ ಸ್ಕೋರ್ ಪ್ರದೇಶವನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ\n⬆️ ಸೇರಿಸಲು ಮೇಲಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿ\n⬇️ ಕಳೆಯಲು ಕೆಳಗೆ ಸ್ವೈಪ್ ಮಾಡಿ\n↩️ ರದ್ದುಗೊಳಿಸಲು ಎಡಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿ\n✏️ ಸರಿಪಡಿಸಲು, ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ಮಾಡಲು ಅಥವಾ ಮುಗಿಸಲು ಸಂಪಾದನೆ ಅಥವಾ ಮೆನು ಬಳಸಿ";
"scoreboard_usage_hint_eight_ball" = "👆 ರ್ಯಾಕ್ ಅನ್ನು ರೆಕಾರ್ಡ್ ಮಾಡಲು ಎಡ/ಬಲ ಸ್ಕೋರ್ ಪ್ರದೇಶವನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ\n⬆️ 1 ರ್ಯಾಕ್ ಸೇರಿಸಲು ಮೇಲಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿ\n⬇️ 1 ರ್ಯಾಕ್ ಕಳೆಯಲು ಕೆಳಗೆ ಸ್ವೈಪ್ ಮಾಡಿ\n↩️ ರದ್ದುಗೊಳಿಸಲು ಎಡಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿ\n🏁 ಗುರಿ ರ್ಯಾಕ್‌ಗಳ ಸಂಖ್ಯೆಗೆ ತಲುಪಿದಾಗ ಪಂದ್ಯ ಕೊನೆಗೊಳ್ಳುತ್ತದೆ";
"scoreboard_usage_hint_nine_ball" = "👆 ಚೇಸ್ ಪಾಯಿಂಟ್‌ಗಳನ್ನು ರೆಕಾರ್ಡ್ ಮಾಡಲು ಆಟಗಾರ, ಚೆಂಡು ಅಥವಾ ಈವೆಂಟ್ ಬಟನ್ ಅನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ\n🎱 ಇದು ಚೇಸ್-ಪಾಯಿಂಟ್ ಅಭ್ಯಾಸ; ಪರದೆಯ ಮೇಲೆ ತೋರಿಸಿರುವ ಚೆಂಡುಗಳು ಮತ್ತು ಈವೆಂಟ್‌ಗಳನ್ನು ಬಳಸಿ\n↩️ ಎಡಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿ ಅಥವಾ ತಪ್ಪು ಮಾಡಿದಾಗ ಮೊದಲು ರದ್ದುಮಾಡಿ ಬಳಸಿ\n✏️ ವಿವರವಾದ ತಿದ್ದುಪಡಿಯ ಅಗತ್ಯವಿರುವಾಗ ಸಂಪಾದನೆಯನ್ನು ಬಳಸಿ";
"scoreboard_usage_hint_snooker" = "🔴 ಸ್ಕೋರ್ ಮಾಡಲು ಕೆಂಪು, ಬಣ್ಣ ಅಥವಾ ಸ್ಕೋರ್ ಬಟನ್‌ಗಳನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ\n⚠️ ಪೆನಾಲ್ಟಿ ಅಂಕಗಳನ್ನು ದಾಖಲಿಸಲು ಫೌಲ್ ಬಳಸಿ\n🔁 ಸ್ಟ್ರೈಕರ್ ಅನ್ನು ಬದಲಾಯಿಸಲು ಸ್ವಿಚ್ ಟರ್ನ್ ಟ್ಯಾಪ್ ಮಾಡಿ\n↩️ ಮೊದಲು ತಪ್ಪುಗಳನ್ನು ರದ್ದುಮಾಡಿ ಅಥವಾ ಸಂಪಾದನೆಯನ್ನು ಬಳಸಿ\n☑️ ಅಗತ್ಯವಿದ್ದಾಗ ಕೆಳಗಿನ ಬಲ ಮೆನುವಿನಿಂದ ಸೆಟ್ಲ್ ತೆರೆಯಿರಿ";
"scoreboard_usage_hint_guandan" = "👆 ಪ್ರತಿ ಫಲಿತಾಂಶ ಮತ್ತು ಮಟ್ಟದ ಪ್ರಗತಿಯನ್ನು ದಾಖಲಿಸಲು ಎಡ ಮತ್ತು ಬಲ ನಿಯಂತ್ರಣಗಳನ್ನು ಬಳಸಿ\n↕️ ಎಡಿಟ್ ಮೋಡ್‌ನಲ್ಲಿ, ಅದರ ಮಟ್ಟವನ್ನು ತ್ವರಿತವಾಗಿ ಬದಲಾಯಿಸಲು ಎರಡೂ ಬದಿಗಳಲ್ಲಿ ಲಂಬವಾಗಿ ಸ್ವೈಪ್ ಮಾಡಿ\n🅰️ ಪಾಸಿಂಗ್ ಎ, ಮರುಹೊಂದಿಸಿ, ರದ್ದುಗೊಳಿಸು ಮತ್ತು ಕೈಯಿಂದ ಮಾಡಿದ ಮುಕ್ತಾಯವು ಬೋರ್ಡ್ ಅಥವಾ ಮೆನುವಿನಲ್ಲಿ ಲಭ್ಯವಿದೆ\n↩️ ಪ್ರಸ್ತುತ ಹಂತದಿಂದ ಮುಂದುವರಿಯುವ ಮೊದಲು ತಪ್ಪನ್ನು ರದ್ದುಗೊಳಿಸಿ";
"scoreboard_usage_hint_shengji" = "👆 ಯಾವುದಾದರೂ ಒಂದು ತಂಡಕ್ಕೆ ಬಿಡ್ ಡೀಲರ್ ಅನ್ನು ಟ್ಯಾಪ್ ಮಾಡುವ ಮೂಲಕ ಪ್ರಾರಂಭಿಸಿ\n🏆 ಟೇಕ್ ಡೀಲರ್ ಅಥವಾ +1, +2, ಮತ್ತು +3 ಬಟನ್‌ಗಳೊಂದಿಗೆ ಪ್ರತಿ ಸುತ್ತನ್ನು ರೆಕಾರ್ಡ್ ಮಾಡಿ\n↩️ ಮೆನುವಿನಿಂದ ಹಿಂದಿನ ಸುತ್ತನ್ನು ರದ್ದುಗೊಳಿಸಿ\n✏️ ತಂಡದ ಹೆಸರುಗಳು ಮತ್ತು ಹಂತಗಳನ್ನು ಎಡಿಟ್ ಮಾಡಲು ಮೇಲಿನ ಬಲಭಾಗದಲ್ಲಿರುವ ಪೆನ್ಸಿಲ್ ಅನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ\n🔄 ಪಂದ್ಯವನ್ನು ಹಸ್ತಚಾಲಿತವಾಗಿ ಮರುಹೊಂದಿಸಿ ಅಥವಾ ಮುಗಿಸಿ";
"scoreboard_usage_hint_uno" = "👆 ರೌಂಡ್ ಸ್ಕೋರಿಂಗ್ ಫಲಕವನ್ನು ತೆರೆಯಲು ಆಟಗಾರನನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ\n✏️ ಹೆಸರು ಮತ್ತು ಸ್ಕೋರ್ ಅನ್ನು ಎಡಿಟ್ ಮಾಡಲು ಆಟಗಾರನನ್ನು ದೀರ್ಘಕಾಲ ಒತ್ತಿರಿ\n↩️ ಹಿಂದಿನ ಸುತ್ತನ್ನು ರದ್ದುಗೊಳಿಸಿ\n☑️ ಪಂದ್ಯವನ್ನು ಹಸ್ತಚಾಲಿತವಾಗಿ ಇತ್ಯರ್ಥಗೊಳಿಸಿ ಅಥವಾ ಮುಗಿಸಿ\n🖼️ ಡಿಸ್‌ಪ್ಲೇ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಮತ್ತು ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ಗಳು ಮೆನುವಿನಲ್ಲಿವೆ";
"scoreboard_usage_hint_doudizhu" = "➕ ರೌಂಡ್ ಸೆಟಲ್‌ಮೆಂಟ್ ತೆರೆಯಲು ಕೆಳಭಾಗದ ಮಧ್ಯದಲ್ಲಿರುವ ಪ್ಲಸ್ ಬಟನ್ ಟ್ಯಾಪ್ ಮಾಡಿ\n🧮 ಬೇಸ್ ಸ್ಕೋರ್, ಗುಣಕ ಮತ್ತು ಒಬ್ಬ ವಿಜೇತರನ್ನು ಆಯ್ಕೆ ಮಾಡಿ ಅಥವಾ ಒಬ್ಬ ಸೋತವರನ್ನು ಹೊರತುಪಡಿಸಿ ಎಲ್ಲರೂ\n↩️ ಎಡಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿ ಅಥವಾ ಹಿಂದಿನ ಸುತ್ತನ್ನು ರದ್ದುಗೊಳಿಸಲು ಮೆನು ಬಳಸಿ\n✏️ ಆಟಗಾರರು ಮತ್ತು ಸ್ಕೋರ್‌ಗಳನ್ನು ಸಂಪಾದಿಸಲು ಮೇಲಿನ ಬಲಭಾಗದಲ್ಲಿರುವ ಪೆನ್ಸಿಲ್ ಅನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ\n🔄 ಪಂದ್ಯವನ್ನು ಹಸ್ತಚಾಲಿತವಾಗಿ ಮರುಹೊಂದಿಸಿ ಅಥವಾ ಮುಗಿಸಿ";
"scoreboard_usage_hint_foosball" = "👆 1 ಗೋಲು ಸೇರಿಸಲು ಎಡ/ಬಲ ಸ್ಕೋರ್ ಪ್ರದೇಶವನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ\n⬆️ ಸೇರಿಸಲು ಮೇಲಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿ\n⬇️ ಕಳೆಯಲು ಕೆಳಗೆ ಸ್ವೈಪ್ ಮಾಡಿ\n↩️ ರದ್ದುಗೊಳಿಸಲು ಎಡಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿ\n☑️ ಪಂದ್ಯ ಮುಗಿದಾಗ ಸೆಟ್ಲ್ ಅಥವಾ ಫಿನಿಶ್ ಬಳಸಿ";
