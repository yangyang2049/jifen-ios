"faq_question_1" = "ನಾನು ಪಂದ್ಯವನ್ನು ತ್ವರಿತವಾಗಿ ಪ್ರಾರಂಭಿಸುವುದು ಹೇಗೆ?";
"faq_answer_1" = "ಹೋಮ್‌ನಲ್ಲಿ, ಕ್ರೀಡೆಯನ್ನು ಆರಿಸಿ ಅಥವಾ ಹೆಚ್ಚಿನ ಆಯ್ಕೆಗಳಿಗಾಗಿ ಹೊಸ ಪಂದ್ಯವನ್ನು ತೆರೆಯಿರಿ. ತ್ವರಿತ ಪ್ರಾರಂಭಕ್ಕೆ ಆಗಾಗ್ಗೆ ಕ್ರೀಡೆಗಳು ಮತ್ತು ಸೆಟಪ್‌ಗಳನ್ನು ಸೇರಿಸಿ ಇದರಿಂದ ಮುಂದಿನ ಪಂದ್ಯವು ವೇಗವಾಗಿ ತೆರೆಯುತ್ತದೆ.\n\nತಂಡದ ಹೆಸರುಗಳು, ಸೆಟ್‌ಗಳು, ಫಾರ್ಮ್ಯಾಟ್ ಅಥವಾ ಸರ್ವಿಂಗ್ ನಿಯಮಗಳ ಅಗತ್ಯವಿರುವ ಕ್ರೀಡೆಗಳು ಮೊದಲು ಗೇಮ್ ಸೆಟಪ್ ಅನ್ನು ತೆರೆಯುತ್ತವೆ. ದೃಢೀಕರಿಸಿದ ನಂತರ, ಸ್ಕೋರ್ಬೋರ್ಡ್ ತೆರೆಯುತ್ತದೆ; ಸ್ಕೋರಿಂಗ್ ಸಮಯದಲ್ಲಿ ಕೆಲವು ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಇನ್ನೂ ಸರಿಹೊಂದಿಸಬಹುದು.";
"faq_question_2" = "ನಾನು ಹೇಗೆ ಸ್ಕೋರ್ ಮಾಡುವುದು ಮತ್ತು ತಪ್ಪುಗಳನ್ನು ಸರಿಪಡಿಸುವುದು?";
"faq_answer_2" = "ಬಾಲ್ ಕ್ರೀಡೆಗಳು ಸಾಮಾನ್ಯವಾಗಿ ಎಡ/ಬಲ ಅಥವಾ ಮೇಲ್ಭಾಗ/ಕೆಳಭಾಗವನ್ನು ಟ್ಯಾಪ್ ಮಾಡಲು ನಿಮಗೆ ಅವಕಾಶ ನೀಡುತ್ತದೆ, ಆದರೆ ಸೆಟ್‌ಗಳು, ಸರ್ವ್ ಮತ್ತು ಬದಿಯ ಬದಲಾವಣೆಗಳು ನಿಯಮಗಳನ್ನು ಅನುಸರಿಸುತ್ತವೆ. ಬಾಸ್ಕೆಟ್‌ಬಾಲ್, ಫುಟ್‌ಬಾಲ್ ಮತ್ತು ಸರಳ ಸ್ಕೋರ್‌ಬೋರ್ಡ್‌ಗಳು ಸಾಮಾನ್ಯ ಪಾಯಿಂಟ್ ಮೌಲ್ಯಗಳನ್ನು ತೋರಿಸುತ್ತವೆ. ಬಿಲಿಯರ್ಡ್ಸ್, ಬಿಲ್ಲುಗಾರಿಕೆ, ಬಾಕ್ಸಿಂಗ್ ಮತ್ತು ಕಾರ್ಡ್ ಆಟಗಳು ಸ್ಕೋರ್, ರೌಂಡ್ ಅಥವಾ ಫಲಿತಾಂಶ ಫಲಕಗಳನ್ನು ಬಳಸುತ್ತವೆ.\n\nನೀವು ತಪ್ಪು ಮಾಡಿದರೆ, ಮೊದಲು ರದ್ದುಗೊಳಿಸಿ ಅಥವಾ ಹಿಂದೆ ಬಳಸಿ. ಹಸ್ತಚಾಲಿತ ಪರಿಹಾರಗಳಿಗಾಗಿ, ಸ್ಕೋರ್‌ಬೋರ್ಡ್‌ನಿಂದ ಸಂಪಾದನೆ/ಸೆಟ್ಟಿಂಗ್‌ಗಳ ನಮೂದನ್ನು ತೆರೆಯಿರಿ. ಪ್ರತಿಯೊಂದು ಕ್ರೀಡೆಯು ಪ್ರತ್ಯೇಕ ಪ್ಲಸ್ ಮತ್ತು ಮೈನಸ್ ಬಟನ್‌ಗಳನ್ನು ಹೊಂದಿಲ್ಲ.";
"faq_question_3" = "ನಾನು ಸ್ಕೋರ್‌ಬೋರ್ಡ್ ಅನ್ನು ಬಿಟ್ಟಿದ್ದೇನೆ. ನಾನು ಅದನ್ನು ಹೇಗೆ ಮುಂದುವರಿಸುವುದು ಅಥವಾ ಪರಿಶೀಲಿಸುವುದು?";
"faq_answer_3" = "ಮುಖಪುಟ ಟ್ಯಾಬ್‌ನಲ್ಲಿ, ಅಪೂರ್ಣ ಪಂದ್ಯವು ಕೆಳಭಾಗದ ಬ್ಯಾನರ್ ಅನ್ನು ತೋರಿಸುತ್ತದೆ (ಪಂದ್ಯವನ್ನು ಮುಂದುವರಿಸಿ); ನೀವು ನಿಲ್ಲಿಸಿದ ಸ್ಥಳದಲ್ಲಿಯೇ ಸ್ಕೋರಿಂಗ್ ಅನ್ನು ಪುನರಾರಂಭಿಸಲು ಅದನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ. ಮುಗಿದ ಮತ್ತು ಉಳಿಸಿದ ಪಂದ್ಯಗಳು ರೆಕಾರ್ಡ್‌ಗಳಲ್ಲಿ ಲಭ್ಯವಿವೆ.\n\nನಮೂದು ಹೋಗಿದ್ದರೆ, ಪಂದ್ಯವು ಕೊನೆಗೊಂಡಿರಬಹುದು, ಅಳಿಸಿರಬಹುದು ಅಥವಾ ಸ್ಥಳೀಯ ಡೇಟಾವನ್ನು ತೆರವುಗೊಳಿಸಿರಬಹುದು. ದಾಖಲೆಗಳು ಮುಖ್ಯವಾಗಿ ಫಲಿತಾಂಶಗಳನ್ನು ಪರಿಶೀಲಿಸಲು ಮತ್ತು ಮೂಲ ಪಂದ್ಯದ ಕ್ರಮವನ್ನು ಮುಂದುವರಿಸುವುದನ್ನು ಬೆಂಬಲಿಸದಿರಬಹುದು.";
"faq_question_4" = "ನಾನು ದಾಖಲೆಗಳನ್ನು ಅಳಿಸುವುದು ಅಥವಾ ಡೇಟಾವನ್ನು ತೆರವುಗೊಳಿಸುವುದು ಹೇಗೆ?";
"faq_answer_4" = "ಪಂದ್ಯದ ಸಮಯದಲ್ಲಿ, ಪ್ರಸ್ತುತ ಕ್ರೀಡೆಯು ಅದನ್ನು ಬೆಂಬಲಿಸಿದರೆ ರದ್ದುಗೊಳಿಸಿ, ಹಿಂತಿರುಗಿ ಅಥವಾ ಎಡಿಟ್ ನಮೂದನ್ನು ಬಳಸಿ.\n\nಉಳಿಸಿದ ಪಂದ್ಯಗಳಿಗಾಗಿ, ರೆಕಾರ್ಡ್ಸ್‌ನಲ್ಲಿ ಐಟಂ ಅನ್ನು ತೆರೆಯಿರಿ ಮತ್ತು ಅದನ್ನು ಅಲ್ಲಿ ಅಳಿಸಿ. ನಾನು → ಡೇಟಾವನ್ನು ತೆರವುಗೊಳಿಸಿ ಎಂಬುದು ಸ್ಥಳೀಯ ಸ್ಕೋರಿಂಗ್, ಟೈಮರ್, ಅಪೂರ್ಣ ಪಂದ್ಯ, ಉಳಿಸಿದ ದಾಖಲೆ ಮತ್ತು ಕೆಲವು ಸ್ಥಳೀಯ ಸೆಟ್ಟಿಂಗ್ ಡೇಟಾವನ್ನು ತೆಗೆದುಹಾಕುತ್ತದೆ. ಇದನ್ನು ರದ್ದುಗೊಳಿಸಲಾಗುವುದಿಲ್ಲ.";
"faq_question_5" = "ನಾನು ಡಿಸ್ಪ್ಲೇ ಅಥವಾ ಇನ್ನೊಂದು ಫೋನ್ ಅನ್ನು ಹೇಗೆ ಸಂಪರ್ಕಿಸುವುದು?";
"faq_answer_5" = "ಎರಡು ಸಾಧನಗಳನ್ನು ಒಟ್ಟಿಗೆ ಬಳಸಿ: ಒಂದು ಅಂಕಗಳನ್ನು ದಾಖಲಿಸುತ್ತದೆ, ಇನ್ನೊಂದು ಪೂರ್ಣ ಪರದೆಯಲ್ಲಿ ತೋರಿಸುತ್ತದೆ. ಹಂಚುವ ಸಾಧನ: ಸೈನ್ ಇನ್ ಮಾಡಿ ಸಿಂಕ್ ಪ್ರಾರಂಭಿಸಿ 6 ಅಂಕಿಯ ಕೋಡ್ ಪಡೆಯಿರಿ. ಪ್ರದರ್ಶಿಸುವ ಸಾಧನ: ಸೈನ್ ಇನ್ ಮಾಡಿ ಹಂಚುವ ಸಾಧನದ 6 ಅಂಕಿಯ ಕೋಡ್ ನಮೂದಿಸಿ. ಅಂಕಗಳನ್ನು ದಾಖಲಿಸಲು ಪ್ರಾರಂಭಿಸಿ — ಅಂಕಗಳು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸಿಂಕ್ ಆಗುತ್ತವೆ.\n\nAirPlay ಪರದೆ ಪ್ರತಿಬಿಂಬಿಸುವಿಕೆ ಶಿಫಾರಸು ಮಾಡಲಾಗಿದೆ. ಸಂಪರ್ಕವನ್ನು ಗುರುತಿಸಿದ ನಂತರ ಸ್ಕೋರ್‌ಬೋರ್ಡ್ ದೊಡ್ಡ ಪರದೆಯಲ್ಲಿ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಕಾಣಿಸುತ್ತದೆ. ನಿಯಂತ್ರಣ ಕೇಂದ್ರ ತೆರೆದು ಪರದೆ ಪ್ರತಿಬಿಂಬಿಸುವಿಕೆ (AirPlay) ಟ್ಯಾಪ್ ಮಾಡಿ. ಮೊದಲು ಸಿಸ್ಟಮ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ AirPlay ಸಂಪರ್ಕ ಮಾಡಿಕೊಳ್ಳಿ; ಅಪ್ಲಿಕೇಶನ್ ಒಂದು ಸಮಯದಲ್ಲಿ ಒಂದೇ ಸಂಪರ್ಕಿತ ಪರದೆಯನ್ನು ಬಳಸಬಹುದು ಮತ್ತು ಟಿವಿಗಳು ಅಥವಾ ಪ್ರೊಜೆಕ್ಟರ್‌ಗಳನ್ನು ಸ್ವತಃ ಹುಡುಕಲಾಗುವುದಿಲ್ಲ. AirPlay ಸಂಪರ್ಕ ಕಡಿತಗೊಳಿಸಿದರೆ ಪ್ರಸಾರದ ಅವಧಿಯೂ ಕೊನೆಗೊಳ್ಳುತ್ತದೆ.";
"faq_question_6" = "ನನ್ನ ಕ್ರೀಡೆಯನ್ನು ಹುಡುಕಲಾಗಲಿಲ್ಲ. ನಾನು ಏನು ಮಾಡಬೇಕು?";
"faq_answer_6" = "ಹತ್ತಿರದ ಕ್ರೀಡೆಯೊಂದಿಗೆ ಪ್ರಾರಂಭಿಸಿ. ಹೆಸರುಗಳು, ಸೆಟ್‌ಗಳು, ತಂಡಗಳು ಅಥವಾ ಆರಂಭಿಕ ಕ್ರಮವು ಮಾತ್ರ ಭಿನ್ನವಾಗಿದ್ದರೆ, ಅವುಗಳನ್ನು ಗೇಮ್ ಸೆಟಪ್‌ನಲ್ಲಿ ಹೊಂದಿಸಿ ಮತ್ತು ತ್ವರಿತ ಪ್ರಾರಂಭಕ್ಕೆ ಸೆಟಪ್ ಸೇರಿಸಿ.\n\nಪ್ರಸ್ತುತ ಕ್ರೀಡೆಗಳು ನಿಯಮಗಳನ್ನು ಒಳಗೊಂಡಿರದಿದ್ದರೆ, ಕ್ರೀಡೆಯ ಹೆಸರು, ಸಾಮಾನ್ಯ ಸ್ವರೂಪ, ಸ್ಕೋರಿಂಗ್ ವಿಧಾನ ಮತ್ತು ನಿರೀಕ್ಷಿತ ಹರಿವಿನೊಂದಿಗೆ ಪ್ರತಿಕ್ರಿಯೆಯನ್ನು ಕಳುಹಿಸಿ.";
"faq_question_7" = "ಸದಸ್ಯತ್ವ, ಸೈನ್-ಇನ್ ಮತ್ತು ಹೊಸ ಸಾಧನಗಳು ಹೇಗೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತವೆ?";
"faq_answer_7" = "ಸದಸ್ಯತ್ವದ ಪ್ರಯೋಜನಗಳು ಮತ್ತು ಖರೀದಿ ದಾಖಲೆಗಳನ್ನು ಪ್ರಸ್ತುತ ಖಾತೆಗೆ ಜೋಡಿಸಲಾಗಿದೆ. ಸದಸ್ಯತ್ವವನ್ನು ಖರೀದಿಸುವ, ರಿಡೀಮ್ ಮಾಡುವ ಅಥವಾ ಮರುಸ್ಥಾಪಿಸುವ ಮೊದಲು ಸೈನ್ ಇನ್ ಮಾಡಿ. ಹೊಸ ಸಾಧನದಲ್ಲಿ, ಅದೇ ಖಾತೆಯೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ ಮತ್ತು ಸದಸ್ಯತ್ವ ಕೇಂದ್ರವನ್ನು ರಿಫ್ರೆಶ್ ಮಾಡಿ.\n\nಪಾವತಿ ಯಶಸ್ವಿಯಾದರೆ ಸದಸ್ಯತ್ವ ಸಕ್ರಿಯವಾಗಿಲ್ಲದಿದ್ದರೆ, ಮೊದಲು ಸದಸ್ಯತ್ವ ಪುಟವನ್ನು ರಿಫ್ರೆಶ್ ಮಾಡಿ. ಅದು ಇನ್ನೂ ತಪ್ಪಾಗಿದ್ದರೆ, ಆರ್ಡರ್ ಸಂಖ್ಯೆ, ಖರೀದಿ ಸಮಯ ಮತ್ತು ಸೈನ್ ಇನ್ ಮಾಡಿದ ಖಾತೆಯೊಂದಿಗೆ ಪ್ರತಿಕ್ರಿಯೆಯನ್ನು ಕಳುಹಿಸಿ.";
"faq_question_8" = "ನಾನು ಸಮಸ್ಯೆಯನ್ನು ಹೇಗೆ ವರದಿ ಮಾಡುವುದು ಅಥವಾ ವೈಶಿಷ್ಟ್ಯವನ್ನು ಸೂಚಿಸುವುದು ಹೇಗೆ?";
"faq_answer_8" = "ನಾನು → ಪ್ರತಿಕ್ರಿಯೆ ತೆರೆಯಿರಿ ಮತ್ತು ದೋಷ ವರದಿ ಅಥವಾ ವೈಶಿಷ್ಟ್ಯದ ಸಲಹೆಯನ್ನು ಆಯ್ಕೆಮಾಡಿ. ಕ್ರೀಡೆ, ಹಂತಗಳು, ನಿರೀಕ್ಷಿತ ಫಲಿತಾಂಶ ಮತ್ತು ನಿಜವಾದ ಫಲಿತಾಂಶವನ್ನು ಸೇರಿಸಿ. ಪ್ರದರ್ಶನ ಅಥವಾ ಸದಸ್ಯತ್ವ ಸಮಸ್ಯೆಗಳಿಗಾಗಿ, ಸಾಧನದ ಮಾದರಿ, ಸಿಸ್ಟಮ್ ಆವೃತ್ತಿ ಮತ್ತು ಅಪ್ಲಿಕೇಶನ್ ಆವೃತ್ತಿಯನ್ನು ಸಹ ಸೇರಿಸಿ.";
"faq_question_10" = "ನನ್ನ ಡೇಟಾವನ್ನು ಬ್ಯಾಕಪ್ ಮಾಡುವುದು ಅಥವಾ ಅದನ್ನು ಹೊಸ ಫೋನ್‌ಗೆ ಸರಿಸುವುದು ಹೇಗೆ?";
"faq_answer_10" = "ಉಳಿಸಿದ ತಂಡ ಮತ್ತು ಆಟಗಾರರ ಹೆಸರುಗಳು ಹಾಗೂ ಸ್ಥಳಗಳನ್ನು ಸಾಧನಗಳ ನಡುವೆ ಸಿಂಕ್ ಮಾಡಲು ಸೈನ್ ಇನ್ ಮಾಡಿ. ಹೊಸ ಫೋನ್‌ನಲ್ಲಿ ಅದೇ ಖಾತೆಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ ಈ ಸಾಮಾನ್ಯ ಡೇಟಾವನ್ನು ಪಡೆಯಿರಿ. ಪಂದ್ಯದ ದಾಖಲೆಗಳು, ಟೈಮರ್ ದಾಖಲೆಗಳು ಮತ್ತು ಅಪೂರ್ಣ ಪಂದ್ಯಗಳು ಪ್ರಸ್ತುತ ಸಾಧನದಲ್ಲೇ ಉಳಿಯುತ್ತವೆ; ಇವುಗಳಿಗೆ ಕ್ಲೌಡ್ ಬ್ಯಾಕಪ್ ಮತ್ತು ಮರುಸ್ಥಾಪನೆ ಲಭ್ಯವಿಲ್ಲ.";
"faq_question_11" = "ನನ್ನ ಡೇಟಾ ಮತ್ತು ಗೌಪ್ಯತೆಯನ್ನು ಹೇಗೆ ನಿರ್ವಹಿಸಲಾಗುತ್ತದೆ?";
"faq_answer_11" = "ಯಾವ ಡೇಟಾವನ್ನು ಏಕೆ ಬಳಸಲಾಗುತ್ತದೆ ಎಂಬುದನ್ನು ಗೌಪ್ಯತಾ ನೀತಿ ವಿವರಿಸುತ್ತದೆ. ಧ್ವನಿ ಟಿಪ್ಪಣಿಗಳನ್ನು ದಾಖಲಿಸಲು ಮೈಕ್ರೊಫೋನ್ ಬಳಸಲಾಗುತ್ತದೆ. ವಿಶ್ವಾಸಾರ್ಹ ಸೈನ್-ಇನ್ QR ಕೋಡ್‌ಗಳನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಲು ಮತ್ತು ನಿಮ್ಮ ಅವತಾರಕ್ಕಾಗಿ ಫೋಟೋ ತೆಗೆಯಲು ಕ್ಯಾಮರಾ ಬಳಸಲಾಗುತ್ತದೆ.";
