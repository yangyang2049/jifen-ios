"scoreboard_usage_hint_billiards" = "👆 Eklemek için sol/sağ puan alanına dokunun\n⬆️ Eklemek için yukarı kaydırın\n⬇️ Çıkarmak için aşağı kaydırın\n↩️ Geri almak için sola kaydırın\n✏️ Düzeltmek, ekran görüntüsünü almak veya bitirmek için düzenlemeyi veya menüyü kullanın";
"scoreboard_usage_hint_eight_ball" = "👆 Bir frameı kaydetmek için sol/sağ skor alanına dokunun\n⬆️ 1 frame eklemek için yukarı kaydırın\n⬇️ 1 frame çıkarmak için aşağı kaydırın\n↩️ Geri almak için sola kaydırın\n🏁 Maç hedef framelara göre biter";
"scoreboard_usage_hint_nine_ball" = "👆 Takip noktalarını kaydetmek için bir oyuncuya, topa veya etkinlik düğmesine dokunun\n🎱 Bu, takip noktaları uygulamasıdır; ekranda gösterilen topları ve etkinlikleri kullanın\n↩️ Bir hata yapıldığında sola kaydırın veya ilk önce Geri Al'ı kullanın\n✏️ Ayrıntılı düzeltme gerektiğinde düzenlemeyi kullanın";
"scoreboard_usage_hint_snooker" = "🔴 Puan almak için kırmızı, renk veya puan düğmelerine dokunun\n⚠️ Ceza puanlarını kaydetmek için Faul'ü kullanın\n🔁 Vuruş yapan oyuncuyu değiştirmek için Sırayı Değiştir’e dokunun\n↩️ Önce hataları geri alın veya düzenlemeyi kullanın\n☑️Gerektiğinde sağ alt menüden Sonuçlandır'i açın";
"scoreboard_usage_hint_guandan" = "👆 Her sonucu ve seviye ilerlemesini kaydetmek için sol ve sağ kontrolleri kullanın\n↕️ Düzenleme modunda, seviyesini hızlı bir şekilde değiştirmek için her iki tarafta dikey olarak kaydırın\n🅰️ A'yı geçme, sıfırlama, geri alma ve manuel bitirme tahtada veya menüde mevcuttur\n↩️ Mevcut seviyeden devam etmeden önce bir hatayı geri alın";
"scoreboard_usage_hint_shengji" = "👆 Her iki takım için de Dağıtıcı Olmak İçin Teklif Ver'e dokunarak başlayın\n🏆 Her turu Dağıtıcı Ol veya +1, +2 ve +3 düğmeleriyle kaydedin\n↩️ Menüden önceki turu geri al\n✏️ Takım adlarını ve seviyelerini düzenlemek için sağ üstteki kaleme dokunun\n🔄 Maçı manuel olarak sıfırlayın veya bitirin";
"scoreboard_usage_hint_uno" = "👆 Tur puanlama panelini açmak için bir oyuncuya dokunun\n✏️ Adını ve skorunu düzenlemek için bir oyuncuya uzun basın\n↩️ Önceki turu geri al\n☑️ Maçı manuel olarak sonuçlandırın veya bitirin\n🖼️ Ekran ayarları ve ekran görüntüleri menüdedir";
"scoreboard_usage_hint_doudizhu" = "➕ Tur hesaplaşmasını açmak için alt ortadaki artı düğmesine dokunun\n🧮 Temel puanı, çarpanı ve bir kazananı veya bir kaybeden hariç herkesi seçin\n↩️ Önceki turu geri almak için sola kaydırın veya menüyü kullanın\n✏️ Oyuncuları ve skorları düzenlemek için sağ üstteki kaleme dokunun\n🔄 Maçı manuel olarak sıfırlayın veya bitirin";
"scoreboard_usage_hint_foosball" = "👆 1 gol eklemek için sol/sağ skor alanına dokunun\n⬆️ Eklemek için yukarı kaydırın\n⬇️ Çıkarmak için aşağı kaydırın\n↩️ Geri almak için sola kaydırın\n☑️ Maç bittiğinde Sonuçlandır veya Bitir'i kullanın";
"scoreboard_usage_hint_foosball_doubles" = "👆 1 gol eklemek için sol/sağ skor alanına dokunun\n⬆️ Eklemek için yukarı kaydırın\n⬇️ Çıkarmak için aşağı kaydırın\n↩️ Geri almak için sola kaydırın\n👥 2V2 isimleri maç öncesi belirlendi\n☑️ Maç bittiğinde Sonuçlandır veya Bitir'i kullanın";
"scoreboard_usage_hint_simple_score" = "👆 Eklemek için sol/sağ puan alanına dokunun\n⬆️ Eklemek için yukarı kaydırın\n⬇️ Çıkarmak için aşağı kaydırın\n↩️ Geri almak için sola kaydırın\n✏️ İsimleri ve puanları değiştirmek için uzun basın veya düzenleyin";
"scoreboard_usage_hint_multi_scoreboard" = "👆 1 puan eklemek için bir oyuncu karosuna dokunun\n⬆️ 1 eklemek için yukarı kaydırın;⬇️ 1 çıkarmak için aşağı kaydırın\n↩️ Geri almak için sola kaydırın\n✏️ Adını ve skorunu düzenlemek için bir oyuncuya uzun basın\n🎛️ Özel ayarlama modunda, bir oyuncuya dokunulduğunda ayar paneli açılır";
