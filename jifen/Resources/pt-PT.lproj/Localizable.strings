"scoreboard_usage_hint_badminton_doubles" = "👆 Toque na área de pontuação esquerda/direita para adicionar\n ⬆️ Deslize para cima para adicionar\n ⬇️ Deslize para baixo para subtrair\n ↩️ Deslize para a esquerda para desfazer\n 🏁 Sets e pontos de jogo seguem as regras do badminton\n 👥 Duplas mostra os jogadores desde a configuração";
"scoreboard_usage_hint_pickleball" = "👆 Toque na área de pontuação esquerda/direita para adicionar\n ⬆️ Deslize para cima para adicionar\n ⬇️ Deslize para baixo para subtrair\n ↩️ Deslize para a esquerda para desfazer\n 🏁 Pontuação e sets seguem as regras do pickleball";
"scoreboard_usage_hint_pickleball_doubles" = "👆 Toque na área de pontuação esquerda/direita para adicionar\n ⬆️ Deslize para cima para adicionar\n ⬇️ Deslize para baixo para subtrair\n ↩️ Deslize para a esquerda para desfazer\n 🏁 Pontuação e sets seguem as regras do pickleball\n 👥 Duplas mostra os jogadores desde a configuração";
"scoreboard_usage_hint_archery" = "👆 Toque na área de um competidor e escolha o valor para registar cada seta e série\n↩️ Deslize para a esquerda para desfazer um erro\n🏹 Os pontos de set seguem o formato de tiro com arco selecionado\n🎯 Em 5–5, siga o desempate pela seta mais próxima do centro apresentado no ecrã";
"scoreboard_usage_hint_boxing" = "🥊 Utilize a ação do assalto para introduzir a pontuação dos dois pugilistas\n📊 Ao concluir um assalto, os pontos totais e os assaltos ganhos são atualizados\n↩️ Desfaça os erros através do menu\n✏️ Utilize Editar ou Terminar quando precisar de corrigir algo";
"scoreboard_usage_hint_billiards" = "👆 Toque na área de pontuação esquerda/direita para adicionar\n⬆️ Deslize para cima para adicionar\n⬇️ Deslize para baixo para subtrair\n↩️ Deslize para a esquerda para desfazer\n✏️ Utilize Editar ou o menu para corrigir, fazer uma captura de ecrã ou terminar";
"scoreboard_usage_hint_eight_ball" = "👆 Toque na área de pontuação esquerda/direita para gravar um rack\n ⬆️ Deslize para cima para adicionar 1 rack\n ⬇️ Deslize para baixo para subtrair 1 rack\n ↩️ Deslize para a esquerda para desfazer\n 🏁 A partida termina nos racks alvo";
"scoreboard_usage_hint_nine_ball" = "👆 Toque num jogador, numa bola ou num botão de evento para registar pontos da disputa\n🎱 Este é um treino de disputa por pontos; utilize as bolas e os eventos apresentados no ecrã\n↩️ Se se enganar, deslize para a esquerda ou utilize primeiro Desfazer\n✏️ Utilize Editar quando precisar de uma correção detalhada";
"scoreboard_usage_hint_snooker" = "🔴 Toque nos botões de bola vermelha, colorida ou pontuação para marcar\n⚠️ Utilize Falta para registar pontos de penalização\n🔁 Toque em Trocar vez para mudar o jogador em jogo\n↩️ Desfaça primeiro os erros ou utilize Editar\n☑️ Abra Encerrar no menu inferior direito quando necessário";
"scoreboard_usage_hint_guandan" = "👆 Use os controlos esquerdo e direito para registar cada resultado e o progresso de nível\n↕️ No modo de edição, deslize verticalmente em qualquer lado para alterar rapidamente o respetivo nível\n🅰️ Passar A, repor, desfazer e terminar manualmente estão disponíveis no quadro ou no menu\n↩️ Desfaça um erro antes de continuar a partir do nível atual";
