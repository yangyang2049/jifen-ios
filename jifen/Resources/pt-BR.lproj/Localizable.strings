"scoreboard_usage_hint_pickleball_doubles" = "👆 Toque na área de pontuação esquerda/direita para adicionar\n ⬆️ Deslize para cima para adicionar\n ⬇️ Deslize para baixo para subtrair\n ↩️ Deslize para a esquerda para desfazer\n 🏁 Pontuação e sets seguem as regras do pickleball\n 👥 Duplas mostra os jogadores desde a configuração";
"scoreboard_usage_hint_archery" = "👆 Toque na área de um competidor e escolha o valor para registrar cada flecha e série\n↩️ Deslize para a esquerda para desfazer um erro\n🏹 Os pontos de set seguem o formato de tiro com arco selecionado\n🎯 Em 5–5, siga o desempate pela flecha mais próxima do centro mostrado na tela";
"scoreboard_usage_hint_boxing" = "🥊 Use a ação da rodada para inserir a pontuação dos dois boxeadores\n📊 Ao concluir uma rodada, os pontos totais e as rodadas vencidas são atualizados\n↩️ Desfaça os erros pelo menu\n✏️ Use Editar ou Finalizar quando precisar corrigir algo";
"scoreboard_usage_hint_billiards" = "👆 Toque na área de pontuação esquerda/direita para adicionar\n⬆️ Deslize para cima para adicionar\n⬇️ Deslize para baixo para subtrair\n↩️ Deslize para a esquerda para desfazer\n✏️ Use Editar ou o menu para corrigir, fazer uma captura de tela ou finalizar";
"scoreboard_usage_hint_eight_ball" = "👆 Toque na área de pontuação esquerda/direita para gravar um rack\n ⬆️ Deslize para cima para adicionar 1 rack\n ⬇️ Deslize para baixo para subtrair 1 rack\n ↩️ Deslize para a esquerda para desfazer\n 🏁 A partida termina nos racks alvo";
"scoreboard_usage_hint_nine_ball" = "👆 Toque em um jogador, uma bola ou um botão de evento para registrar pontos da disputa\n🎱 Este é um treino de disputa por pontos; use as bolas e os eventos mostrados na tela\n↩️ Ao errar, deslize para a esquerda ou use Desfazer primeiro\n✏️ Use Editar quando precisar de uma correção detalhada";
