"scoreboard_usage_hint_shengji" = "👆 התחילו בהקשה על „הצעת מחלק” של אחת הקבוצות\n🏆 תעדו כל סיבוב באמצעות „לקיחת מחלק” או הכפתורים +1, +2 ו-+3\n↩️ בטלו את הסיבוב הקודם מהתפריט\n✏️ הקישו על העיפרון בפינה הימנית העליונה כדי לערוך שמות ורמות של קבוצות\n🔄 אפסו או סיימו את המשחק ידנית";
"scoreboard_usage_hint_uno" = "👆 הקש על שחקן כדי לפתוח את חלונית הניקוד העגול\n ✏️ לחץ לחיצה ארוכה על שחקן כדי לערוך את השם והניקוד\n ↩️ בטל את הסיבוב הקודם\n ☑️ קבע או סיים את המשחק באופן ידני\n 🖼️ הגדרות תצוגה וצילומי מסך נמצאים בתפריט";
"scoreboard_usage_hint_doudizhu" = "➕ הקישו על כפתור הפלוס במרכז התחתון כדי לפתוח את תוצאת הסיבוב\n🧮 בחרו ניקוד בסיס, מכפיל ומנצח אחד, או כולם מלבד מפסיד אחד\n↩️ החליקו שמאלה או השתמשו בתפריט כדי לבטל את הסיבוב הקודם\n✏️ הקישו על העיפרון בפינה הימנית העליונה כדי לערוך שחקנים וניקוד\n🔄 אפסו או סיימו את המשחק ידנית";
"scoreboard_usage_hint_foosball" = "👆 הקישו על אזור הניקוד השמאלי או הימני כדי להוסיף שער לצד המתאים\n⬆️ החליקו למעלה להוספת שער\n⬇️ החליקו למטה להפחתת שער\n↩️ החליקו שמאלה לביטול הפעולה האחרונה\n☑️ בסיום המשחק השתמשו ברישום התוצאה או בסיום המשחק";
"scoreboard_usage_hint_foosball_doubles" = "👆 הקישו על אזור הניקוד השמאלי או הימני כדי להוסיף שער לצד המתאים\n⬆️ החליקו למעלה להוספת שער\n⬇️ החליקו למטה להפחתת שער\n↩️ החליקו שמאלה לביטול הפעולה האחרונה\n👥 הגדירו שמות לזוגות לפני המשחק\n☑️ בסיום המשחק השתמשו ברישום התוצאה או בסיום המשחק";
"scoreboard_usage_hint_simple_score" = "👆 הקש על אזור הניקוד שמאלה/ימינה כדי להוסיף\n ⬆️ החלק למעלה כדי להוסיף\n ⬇️ החלק מטה כדי לגרוע\n ↩️ החלק שמאלה כדי לבטל\n ✏️ לחץ לחיצה ארוכה או ערוך כדי לשנות שמות וציונים";
