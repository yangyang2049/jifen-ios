"scoreboard_usage_hint_pingpong" = "👆 ചേർക്കാൻ ഇടത്/വലത് സ്കോർ ഏരിയ ടാപ്പ് ചെയ്യുക\n⬆️ ചേർക്കാൻ മുകളിലേക്ക് സ്വൈപ്പ് ചെയ്യുക\n⬇️ കുറയ്ക്കാൻ താഴേക്ക് സ്വൈപ്പ് ചെയ്യുക\n↩️ പഴയപടിയാക്കാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക\n🏁 സെറ്റുകൾ, ഗെയിം പോയിൻ്റ്, ഫിനിഷ് ടേബിൾ ടെന്നീസ് നിയമങ്ങൾ പാലിക്കുക";
"scoreboard_usage_hint_pingpong_doubles" = "👆 ചേർക്കാൻ ഇടത്/വലത് സ്കോർ ഏരിയ ടാപ്പ് ചെയ്യുക\n⬆️ ചേർക്കാൻ മുകളിലേക്ക് സ്വൈപ്പ് ചെയ്യുക\n⬇️ കുറയ്ക്കാൻ താഴേക്ക് സ്വൈപ്പ് ചെയ്യുക\n↩️ പഴയപടിയാക്കാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക\n🏁 സെറ്റുകൾ, ഗെയിം പോയിൻ്റ്, ഫിനിഷ് ടേബിൾ ടെന്നീസ് നിയമങ്ങൾ പാലിക്കുക\n👥 ഡബിൾസിൽ സജ്ജീകരണത്തിലെ കളിക്കാരും സെർവ് ക്രമവും കാണിക്കുന്നു";
"scoreboard_usage_hint_tennis" = "👆 പോയിൻ്റ് രേഖപ്പെടുത്താൻ ഇടത്/വലത് സ്കോർ ഏരിയയിൽ ടാപ്പ് ചെയ്യുക\n⬆️ ചേർക്കാൻ മുകളിലേക്ക് സ്വൈപ്പ് ചെയ്യുക\n⬇️ കുറയ്ക്കാൻ താഴേക്ക് സ്വൈപ്പ് ചെയ്യുക\n↩️ പഴയപടിയാക്കാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക\n🎾 0/15/30/40, ഡ്യൂസ്, അഡ്വാന്റേജ്, ഗെയിമുകൾ, സെറ്റുകൾ എന്നിവ സ്വയമേവയാണ്";
"scoreboard_usage_hint_tennis_doubles" = "👆 പോയിൻ്റ് രേഖപ്പെടുത്താൻ ഇടത്/വലത് സ്കോർ ഏരിയയിൽ ടാപ്പ് ചെയ്യുക\n⬆️ ചേർക്കാൻ മുകളിലേക്ക് സ്വൈപ്പ് ചെയ്യുക\n⬇️ കുറയ്ക്കാൻ താഴേക്ക് സ്വൈപ്പ് ചെയ്യുക\n↩️ പഴയപടിയാക്കാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക\n🎾 0/15/30/40, ഡ്യൂസ്, അഡ്വാന്റേജ്, ഗെയിമുകൾ, സെറ്റുകൾ എന്നിവ സ്വയമേവയാണ്\n👥 ഡബിൾസ് സജ്ജീകരണത്തിൽ നിന്നുള്ള കളിക്കാരെ കാണിക്കുന്നു";
"scoreboard_usage_hint_badminton" = "👆 ചേർക്കാൻ ഇടത്/വലത് സ്കോർ ഏരിയ ടാപ്പ് ചെയ്യുക\n⬆️ ചേർക്കാൻ മുകളിലേക്ക് സ്വൈപ്പ് ചെയ്യുക\n⬇️ കുറയ്ക്കാൻ താഴേക്ക് സ്വൈപ്പ് ചെയ്യുക\n↩️ പഴയപടിയാക്കാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക\n🏁 സെറ്റുകളും ഗെയിം പോയിൻ്റും ബാഡ്മിൻ്റൺ നിയമങ്ങൾ പാലിക്കുന്നു";
"scoreboard_usage_hint_badminton_doubles" = "👆 ചേർക്കാൻ ഇടത്/വലത് സ്കോർ ഏരിയ ടാപ്പ് ചെയ്യുക\n⬆️ ചേർക്കാൻ മുകളിലേക്ക് സ്വൈപ്പ് ചെയ്യുക\n⬇️ കുറയ്ക്കാൻ താഴേക്ക് സ്വൈപ്പ് ചെയ്യുക\n↩️ പഴയപടിയാക്കാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക\n🏁 സെറ്റുകളും ഗെയിം പോയിൻ്റും ബാഡ്മിൻ്റൺ നിയമങ്ങൾ പാലിക്കുന്നു\n👥 ഡബിൾസ് സജ്ജീകരണത്തിൽ നിന്നുള്ള കളിക്കാരെ കാണിക്കുന്നു";
"scoreboard_usage_hint_pickleball" = "👆 ചേർക്കാൻ ഇടത്/വലത് സ്കോർ ഏരിയ ടാപ്പ് ചെയ്യുക\n⬆️ ചേർക്കാൻ മുകളിലേക്ക് സ്വൈപ്പ് ചെയ്യുക\n⬇️ കുറയ്ക്കാൻ താഴേക്ക് സ്വൈപ്പ് ചെയ്യുക\n↩️ പഴയപടിയാക്കാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക\n🏁 സ്‌കോറും സെറ്റുകളും പിക്കിൾബോൾ നിയമങ്ങൾ പാലിക്കുന്നു";
"scoreboard_usage_hint_pickleball_doubles" = "👆 ചേർക്കാൻ ഇടത്/വലത് സ്കോർ ഏരിയയിൽ ടാപ്പ് ചെയ്യുക\n⬆️ ചേർക്കാൻ മുകളിലേക്ക് സ്വൈപ്പ് ചെയ്യുക\n⬇️ കുറയ്ക്കാൻ താഴേക്ക് സ്വൈപ്പ് ചെയ്യുക\n↩️ പഴയപടിയാക്കാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക\n🏁 സ്‌കോറും സെറ്റുകളും പിക്കിൾബോൾ നിയമങ്ങൾ പാലിക്കുന്നു\n👥 ഡബിൾസ് സജ്ജീകരണത്തിൽ നിന്നുള്ള കളിക്കാരെ കാണിക്കുന്നു";
"scoreboard_usage_hint_archery" = "👆 മത്സരാർത്ഥിയുടെ ഭാഗത്ത് ടാപ്പുചെയ്ത് അമ്പിന്റെ പോയിന്റ് മൂല്യം തിരഞ്ഞെടുത്ത് ഓരോ അമ്പും അമ്പുകളുടെ റൗണ്ടും രേഖപ്പെടുത്തുക\n↩️ തെറ്റ് പഴയപടിയാക്കാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക\n🏹 സെറ്റ് പോയിന്റുകൾ തിരഞ്ഞെടുത്ത അമ്പെയ്ത്ത് ഫോർമാറ്റ് അനുസരിച്ചാണ്\n🎯 5–5 ആയാൽ കേന്ദ്രത്തിന് ഏറ്റവും അടുത്തുള്ള അമ്പ് നിർണയിക്കുന്ന സ്ക്രീനിലെ ഷൂട്ട്-ഓഫ് നിർദ്ദേശങ്ങൾ പാലിക്കുക";
"scoreboard_usage_hint_boxing" = "🥊 റൗണ്ടിനുള്ള രണ്ട് ബോക്സർമാരുടെയും സ്കോറുകൾ നൽകാൻ റൗണ്ട് ആക്ഷൻ ഉപയോഗിക്കുക\n📊 ഒരു റൗണ്ട് പൂർത്തിയാക്കിയാൽ മൊത്തം പോയിന്റുകളും ജയിച്ച റൗണ്ടുകളുടെ എണ്ണവും പുതുക്കും\n↩️ മെനുവിൽ നിന്നുള്ള തെറ്റുകൾ പഴയപടിയാക്കുക\n✏️ തിരുത്തൽ ആവശ്യമുള്ളപ്പോൾ എഡിറ്റ് ചെയ്യുക അല്ലെങ്കിൽ പൂർത്തിയാക്കുക";
"scoreboard_usage_hint_billiards" = "👆 ചേർക്കാൻ ഇടത്/വലത് സ്കോർ ഏരിയ ടാപ്പ് ചെയ്യുക\n⬆️ ചേർക്കാൻ മുകളിലേക്ക് സ്വൈപ്പ് ചെയ്യുക\n⬇️ കുറയ്ക്കാൻ താഴേക്ക് സ്വൈപ്പ് ചെയ്യുക\n↩️ പഴയപടിയാക്കാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക\n✏️ തിരുത്താനോ സ്‌ക്രീൻഷോട്ട് ചെയ്യാനോ പൂർത്തിയാക്കാനോ എഡിറ്റ് അല്ലെങ്കിൽ മെനു ഉപയോഗിക്കുക";
"scoreboard_usage_hint_eight_ball" = "👆 ഒരു റാക്ക് റെക്കോർഡ് ചെയ്യാൻ ഇടത്/വലത് സ്കോർ ഏരിയയിൽ ടാപ്പ് ചെയ്യുക\n⬆️ 1 റാക്ക് ചേർക്കാൻ മുകളിലേക്ക് സ്വൈപ്പ് ചെയ്യുക\n⬇️ 1 റാക്ക് കുറയ്ക്കാൻ താഴേക്ക് സ്വൈപ്പ് ചെയ്യുക\n↩️ പഴയപടിയാക്കാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക\n🏁 ടാർഗെറ്റ് റാക്കുകൾ വഴി മത്സരം അവസാനിക്കുന്നു";
"scoreboard_usage_hint_nine_ball" = "👆 ചേസ് പോയിൻ്റുകൾ രേഖപ്പെടുത്താൻ ഒരു കളിക്കാരൻ, പന്ത് അല്ലെങ്കിൽ ഇവൻ്റ് ബട്ടൺ ടാപ്പ് ചെയ്യുക\n🎱 ഇത് ചേസ് പോയിൻ്റ് പരിശീലനമാണ്; സ്ക്രീനിൽ കാണിച്ചിരിക്കുന്ന പന്തുകളും ഇവൻ്റുകളും ഉപയോഗിക്കുക\n↩️ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക അല്ലെങ്കിൽ ഒരു തെറ്റ് സംഭവിക്കുമ്പോൾ ആദ്യം പഴയപടിയാക്കുക\n✏️ വിശദമായ തിരുത്തൽ ആവശ്യമുള്ളപ്പോൾ എഡിറ്റ് ഉപയോഗിക്കുക";
"scoreboard_usage_hint_snooker" = "🔴 സ്കോർ ചെയ്യുന്നതിന് ചുവപ്പ്, നിറം അല്ലെങ്കിൽ സ്കോർ ബട്ടണുകൾ ടാപ്പ് ചെയ്യുക\n⚠️ പെനാൽറ്റി പോയിൻ്റുകൾ രേഖപ്പെടുത്താൻ ഫൗൾ ഉപയോഗിക്കുക\n🔁 സ്‌ട്രൈക്കറെ മാറ്റാൻ സ്വിച്ച് ടേൺ ടാപ്പ് ചെയ്യുക\n↩️ ആദ്യം തെറ്റുകൾ പഴയപടിയാക്കുക, അല്ലെങ്കിൽ എഡിറ്റ് ഉപയോഗിക്കുക\n☑️ ആവശ്യമുള്ളപ്പോൾ താഴെ-വലത് മെനുവിൽ നിന്ന് സെറ്റിൽ തുറക്കുക";
"scoreboard_usage_hint_guandan" = "👆 ഓരോ ഫലവും ലെവൽ പുരോഗതിയും രേഖപ്പെടുത്താൻ ഇടത് വലത് നിയന്ത്രണങ്ങൾ ഉപയോഗിക്കുക\n↕️ എഡിറ്റ് മോഡിൽ, അതിൻ്റെ ലെവൽ വേഗത്തിൽ മാറ്റാൻ ഇരുവശത്തേക്കും ലംബമായി സ്വൈപ്പ് ചെയ്യുക\n🅰️ പാസിംഗ് എ, റീസെറ്റ്, പഴയപടിയാക്കൽ, മാനുവൽ ഫിനിഷ് എന്നിവ ബോർഡിലോ മെനുവിലോ ലഭ്യമാണ്\n↩️ നിലവിലെ ലെവലിൽ നിന്ന് തുടരുന്നതിന് മുമ്പ് ഒരു തെറ്റ് പഴയപടിയാക്കുക";
"scoreboard_usage_hint_shengji" = "👆 ഏതെങ്കിലും ടീമിന് വേണ്ടി ബിഡ് ഡീലർ ടാപ്പ് ചെയ്തുകൊണ്ട് ആരംഭിക്കുക\n🏆 ടേക്ക് ഡീലർ അല്ലെങ്കിൽ +1, +2, +3 ബട്ടണുകൾ ഉപയോഗിച്ച് ഓരോ റൗണ്ടും റെക്കോർഡ് ചെയ്യുക\n↩️ മെനുവിൽ നിന്ന് മുമ്പത്തെ റൗണ്ട് പഴയപടിയാക്കുക\n✏️ ടീമിൻ്റെ പേരുകളും ലെവലുകളും എഡിറ്റ് ചെയ്യാൻ മുകളിൽ വലതുവശത്തുള്ള പെൻസിൽ ടാപ്പ് ചെയ്യുക\n🔄 മത്സരം സ്വമേധയാ പുനഃസജ്ജമാക്കുക അല്ലെങ്കിൽ പൂർത്തിയാക്കുക";
"scoreboard_usage_hint_uno" = "👆 റൗണ്ട് സ്കോറിംഗ് പാനൽ തുറക്കാൻ ഒരു കളിക്കാരനെ ടാപ്പ് ചെയ്യുക\n✏️ പേരും സ്‌കോറും എഡിറ്റ് ചെയ്യാൻ ഒരു പ്ലെയറിൽ ദീർഘനേരം അമർത്തുക\n↩️ മുമ്പത്തെ റൗണ്ട് പഴയപടിയാക്കുക\n☑️ മത്സരം സ്വമേധയാ പരിഹരിക്കുക അല്ലെങ്കിൽ പൂർത്തിയാക്കുക\n🖼️ ഡിസ്പ്ലേ ക്രമീകരണങ്ങളും സ്ക്രീൻഷോട്ടുകളും മെനുവിലാണ്";
"scoreboard_usage_hint_doudizhu" = "➕ റൗണ്ട് സെറ്റിൽമെൻ്റ് തുറക്കാൻ താഴെയുള്ള മധ്യഭാഗത്തുള്ള പ്ലസ് ബട്ടൺ ടാപ്പ് ചെയ്യുക\n🧮 അടിസ്ഥാന സ്‌കോർ, ഗുണിതം, ഒന്നുകിൽ ഒരു വിജയിയെ അല്ലെങ്കിൽ ഒരു പരാജിതനെ ഒഴികെ എല്ലാവരും തിരഞ്ഞെടുക്കുക\n↩️ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക അല്ലെങ്കിൽ മുൻ റൗണ്ട് പഴയപടിയാക്കാൻ മെനു ഉപയോഗിക്കുക\n✏️ കളിക്കാരും സ്കോറുകളും എഡിറ്റ് ചെയ്യാൻ മുകളിൽ വലതുവശത്തുള്ള പെൻസിൽ ടാപ്പ് ചെയ്യുക\n🔄 മത്സരം സ്വമേധയാ പുനഃസജ്ജമാക്കുക അല്ലെങ്കിൽ പൂർത്തിയാക്കുക";
"scoreboard_usage_hint_foosball" = "👆 1 ഗോൾ ചേർക്കാൻ ഇടത്/വലത് സ്കോർ ഏരിയയിൽ ടാപ്പ് ചെയ്യുക\n⬆️ ചേർക്കാൻ മുകളിലേക്ക് സ്വൈപ്പ് ചെയ്യുക\n⬇️ കുറയ്ക്കാൻ താഴേക്ക് സ്വൈപ്പ് ചെയ്യുക\n↩️ പഴയപടിയാക്കാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക\n☑️ മത്സരം അവസാനിക്കുമ്പോൾ സെറ്റിൽ അല്ലെങ്കിൽ ഫിനിഷ് ഉപയോഗിക്കുക";
"scoreboard_usage_hint_foosball_doubles" = "👆 1 ഗോൾ ചേർക്കാൻ ഇടത്/വലത് സ്കോർ ഏരിയയിൽ ടാപ്പ് ചെയ്യുക\n⬆️ ചേർക്കാൻ മുകളിലേക്ക് സ്വൈപ്പ് ചെയ്യുക\n⬇️ കുറയ്ക്കാൻ താഴേക്ക് സ്വൈപ്പ് ചെയ്യുക\n↩️ പഴയപടിയാക്കാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക\n👥 2V2 പേരുകൾ മത്സരത്തിന് മുമ്പ് സജ്ജീകരിച്ചിരിക്കുന്നു\n☑️ മത്സരം അവസാനിക്കുമ്പോൾ സെറ്റിൽ അല്ലെങ്കിൽ ഫിനിഷ് ഉപയോഗിക്കുക";
"scoreboard_usage_hint_simple_score" = "👆 ചേർക്കാൻ ഇടത്/വലത് സ്കോർ ഏരിയ ടാപ്പ് ചെയ്യുക\n⬆️ ചേർക്കാൻ മുകളിലേക്ക് സ്വൈപ്പ് ചെയ്യുക\n⬇️ കുറയ്ക്കാൻ താഴേക്ക് സ്വൈപ്പ് ചെയ്യുക\n↩️ പഴയപടിയാക്കാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക\n✏️ പേരുകളും സ്കോറുകളും മാറ്റാൻ ദീർഘനേരം അമർത്തുക അല്ലെങ്കിൽ എഡിറ്റ് ചെയ്യുക";
"scoreboard_usage_hint_multi_scoreboard" = "👆 1 പോയിൻ്റ് ചേർക്കാൻ ഒരു പ്ലെയർ ടൈൽ ടാപ്പ് ചെയ്യുക\n⬆️ 1 ചേർക്കാൻ മുകളിലേക്ക് സ്വൈപ്പ് ചെയ്യുക; ⬇️ 1 കുറയ്ക്കാൻ താഴേക്ക് സ്വൈപ്പ് ചെയ്യുക\n↩️ പഴയപടിയാക്കാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക\n✏️ പേരും സ്‌കോറും എഡിറ്റ് ചെയ്യാൻ ഒരു കളിക്കാരനെ ദീർഘനേരം അമർത്തുക\n🎛️ ഇഷ്‌ടാനുസൃത ക്രമീകരണ മോഡിൽ, ഒരു പ്ലെയർ ടാപ്പുചെയ്യുന്നത് ക്രമീകരണ പാനൽ തുറക്കുന്നു";
