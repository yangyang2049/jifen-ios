"faq_answer_1" = "ഹോമിൽ, ഒരു കായിക വിനോദം തിരഞ്ഞെടുക്കുക അല്ലെങ്കിൽ കൂടുതൽ ഓപ്ഷനുകൾക്കായി പുതിയ മത്സരം തുറക്കുക. ക്വിക്ക് സ്റ്റാർട്ടിലേക്ക് പതിവ് സ്പോർട്സും സജ്ജീകരണങ്ങളും ചേർക്കുക, അങ്ങനെ അടുത്ത മത്സരം വേഗത്തിൽ തുറക്കും.\n\nടീമിൻ്റെ പേരുകൾ, സെറ്റുകൾ, ഫോർമാറ്റുകൾ അല്ലെങ്കിൽ സെർവിംഗ് നിയമങ്ങൾ എന്നിവ ആവശ്യമുള്ള സ്‌പോർട്‌സ് ആദ്യം ഗെയിം സജ്ജീകരണം തുറക്കുക. സ്ഥിരീകരിച്ച ശേഷം, സ്കോർബോർഡ് തുറക്കുന്നു; സ്കോറിംഗ് സമയത്ത് ചില ക്രമീകരണങ്ങൾ ഇപ്പോഴും ക്രമീകരിക്കാവുന്നതാണ്.";
"faq_question_2" = "ഞാൻ എങ്ങനെ സ്കോർ ചെയ്യുകയും തെറ്റുകൾ പരിഹരിക്കുകയും ചെയ്യും?";
"faq_answer_2" = "ബോൾ സ്‌പോർട്‌സ് സാധാരണയായി ഒരു പോയിൻ്റ് നൽകുന്നതിന് ഇടത്/വലത് അല്ലെങ്കിൽ മുകളിൽ/താഴെ വശത്ത് ടാപ്പുചെയ്യാൻ നിങ്ങളെ അനുവദിക്കുന്നു, അതേസമയം സെറ്റ്, സെർവ്, സൈഡ് മാറ്റങ്ങൾ എന്നിവ നിയമങ്ങൾ പാലിക്കുന്നു. ബാസ്കറ്റ്ബോൾ, ഫുട്ബോൾ, ലളിതമായ സ്കോർബോർഡുകൾ എന്നിവ പൊതുവായ പോയിൻ്റ് മൂല്യങ്ങൾ കാണിക്കുന്നു. ബില്ല്യാർഡ്സ്, അമ്പെയ്ത്ത്, ബോക്സിംഗ്, കാർഡ് ഗെയിമുകൾ എന്നിവ സ്കോർ, റൗണ്ട് അല്ലെങ്കിൽ ഫല പാനലുകൾ ഉപയോഗിക്കുന്നു.\n\nനിങ്ങൾ ഒരു തെറ്റ് ചെയ്താൽ, ആദ്യം പഴയപടിയാക്കുക അല്ലെങ്കിൽ തിരികെ ഉപയോഗിക്കുക. സ്വമേധയാലുള്ള പരിഹാരങ്ങൾക്കായി, സ്കോർബോർഡിൽ നിന്ന് എഡിറ്റ്/ക്രമീകരണ എൻട്രി തുറക്കുക. എല്ലാ കായിക ഇനങ്ങൾക്കും പ്രത്യേകം പ്ലസ്, മൈനസ് ബട്ടണുകൾ ഇല്ല.";
"faq_question_3" = "ഞാൻ സ്കോർബോർഡ് വിട്ടു. ഞാൻ അത് എങ്ങനെ തുടരുകയോ അവലോകനം ചെയ്യുകയോ ചെയ്യും?";
"faq_answer_3" = "ഹോം ടാബിൽ, പൂർത്തിയാകാത്ത ഒരു മത്സരം താഴെയുള്ള ബാനർ കാണിക്കുന്നു (മത്സരം തുടരുക); നിങ്ങൾ നിർത്തിയിടത്ത് നിന്ന് സ്‌കോറിംഗ് പുനരാരംഭിക്കാൻ അത് ടാപ്പുചെയ്യുക. പൂർത്തിയായതും സൂക്ഷിച്ചതുമായ മത്സരങ്ങൾ റെക്കോർഡുകളിൽ ലഭ്യമാണ്.\n\nഎൻട്രി പോയെങ്കിൽ, മത്സരം അവസാനിച്ചിരിക്കാം, ഇല്ലാതാക്കപ്പെടാം, അല്ലെങ്കിൽ പ്രാദേശിക ഡാറ്റ മായ്‌ച്ചിരിക്കാം. രേഖകൾ പ്രധാനമായും ഫലങ്ങൾ അവലോകനം ചെയ്യുന്നതിനാണ്, യഥാർത്ഥ മാച്ച് ഫ്ലോ തുടരുന്നതിനെ പിന്തുണച്ചേക്കില്ല.";
"faq_question_4" = "ഞാൻ എങ്ങനെയാണ് റെക്കോർഡുകൾ ഇല്ലാതാക്കുകയോ ഡാറ്റ മായ്‌ക്കുകയോ ചെയ്യുക?";
"faq_answer_4" = "ഒരു മത്സരത്തിനിടയിൽ, നിലവിലെ സ്‌പോർട്‌സ് പിന്തുണയ്‌ക്കുകയാണെങ്കിൽ, പഴയപടിയാക്കുക, തിരികെ നൽകുക അല്ലെങ്കിൽ എഡിറ്റ് എൻട്രി ഉപയോഗിക്കുക.\n\nസൂക്ഷിച്ച മത്സരങ്ങൾക്കായി, റെക്കോർഡുകളിൽ ഇനം തുറന്ന് അത് അവിടെ ഇല്ലാതാക്കുക. ഞാൻ → ഡാറ്റ മായ്‌ക്കുക ലോക്കൽ സ്കോറിംഗ്, ടൈമർ, പൂർത്തിയാകാത്ത മത്സരം, സംരക്ഷിച്ച റെക്കോർഡ്, ചില പ്രാദേശിക ക്രമീകരണ ഡാറ്റ എന്നിവ നീക്കം ചെയ്യുന്നു. ഇത് പഴയപടിയാക്കാനാകില്ല.";
"faq_question_5" = "ഒരു ഡിസ്‌പ്ലേയോ മറ്റൊരു ഫോണോ എങ്ങനെ ബന്ധിപ്പിക്കും?";
"faq_answer_5" = "രണ്ട് ഉപകരണങ്ങൾ ഒരുമിച്ച് ഉപയോഗിക്കുക: ഒന്ന് സ്കോർ രേഖപ്പെടുത്തും, മറ്റൊന്ന് പൂർണ സ്ക്രീനിൽ കാണിക്കും. പങ്കിടുന്ന ഉപകരണം: സൈൻ ഇൻ ചെയ്ത് സമന്വയം ആരംഭിച്ച് 6 അക്ക കോഡ് നേടുക. പ്രദർശിപ്പിക്കുന്ന ഉപകരണം: സൈൻ ഇൻ ചെയ്ത് പങ്കിടുന്ന ഉപകരണത്തിൽനിന്നുള്ള 6 അക്ക കോഡ് നൽകുക. സ്കോർ രേഖപ്പെടുത്തിത്തുടങ്ങുക — സ്കോർ സ്വയമേവ സമന്വയിക്കും.\n\nAirPlay സ്ക്രീൻ മിററിംഗ് ശുപാർശ ചെയ്യുന്നു. കണക്ഷൻ തിരിച്ചറിഞ്ഞാൽ സ്കോർബോർഡ് വലിയ സ്ക്രീനിൽ സ്വയമേവ കാണിക്കും. കൺട്രോൾ സെന്റർ തുറന്ന് സ്ക്രീൻ മിററിംഗ് (AirPlay) ടാപ്പുചെയ്യുക. ആദ്യം സിസ്റ്റം ക്രമീകരണങ്ങളിൽ AirPlay കണക്ഷൻ സ്ഥാപിക്കുക; ആപ്പിന് ഒരേസമയം ബന്ധിപ്പിച്ച ഒരു ഡിസ്പ്ലേ മാത്രമേ ഉപയോഗിക്കാനാകൂ, ടിവികളോ പ്രൊജക്ടറുകളോ സ്വന്തമായി തിരയാനാകില്ല. AirPlay വിച്ഛേദിച്ചാൽ കാസ്റ്റ് സെഷനും അവസാനിക്കും.";
"faq_question_6" = "എനിക്ക് എൻ്റെ കായിക വിനോദം കണ്ടെത്താൻ കഴിയുന്നില്ല. ഞാൻ എന്ത് ചെയ്യണം?";
"faq_answer_6" = "ഏറ്റവും അടുത്തുള്ള കായിക വിനോദത്തിൽ നിന്ന് ആരംഭിക്കുക. പേരുകൾ, സെറ്റുകൾ, ടീമുകൾ അല്ലെങ്കിൽ ആരംഭ ക്രമം എന്നിവ മാത്രം വ്യത്യാസപ്പെട്ടാൽ, ഗെയിം സജ്ജീകരണത്തിൽ അവ ക്രമീകരിക്കുകയും ക്വിക്ക് സ്റ്റാർട്ടിലേക്ക് സജ്ജീകരണം ചേർക്കുകയും ചെയ്യുക.\n\nനിലവിലെ സ്‌പോർട്‌സിന് നിയമങ്ങൾ ഉൾക്കൊള്ളാൻ കഴിയുന്നില്ലെങ്കിൽ, സ്‌പോർട്‌സിൻ്റെ പേര്, പൊതുവായ ഫോർമാറ്റ്, സ്‌കോറിംഗ് രീതി, പ്രതീക്ഷിക്കുന്ന ഫ്ലോ എന്നിവ സഹിതം ഫീഡ്‌ബാക്ക് അയയ്‌ക്കുക.";
"faq_question_7" = "അംഗത്വം, സൈൻ ഇൻ, പുതിയ ഉപകരണങ്ങൾ എന്നിവ എങ്ങനെ പ്രവർത്തിക്കും?";
"faq_answer_7" = "അംഗത്വ ആനുകൂല്യങ്ങളും വാങ്ങൽ രേഖകളും കറൻ്റ് അക്കൗണ്ടുമായി ബന്ധിപ്പിച്ചിരിക്കുന്നു. അംഗത്വം വാങ്ങുന്നതിനോ റിഡീം ചെയ്യുന്നതിനോ പുനഃസ്ഥാപിക്കുന്നതിനോ മുമ്പ് സൈൻ ഇൻ ചെയ്യുക. ഒരു പുതിയ ഉപകരണത്തിൽ, അതേ അക്കൗണ്ട് ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്‌ത് അംഗത്വ കേന്ദ്രം പുതുക്കുക.\n\nപേയ്‌മെൻ്റ് വിജയിച്ചെങ്കിലും അംഗത്വം സജീവമല്ലെങ്കിൽ, ആദ്യം അംഗത്വ പേജ് പുതുക്കുക. ഇത് ഇപ്പോഴും തെറ്റാണെങ്കിൽ, ഓർഡർ നമ്പർ, വാങ്ങൽ സമയം, സൈൻ ഇൻ ചെയ്‌ത അക്കൗണ്ട് എന്നിവ സഹിതം ഫീഡ്‌ബാക്ക് അയയ്‌ക്കുക.";
"faq_question_8" = "ഞാൻ എങ്ങനെയാണ് ഒരു പ്രശ്നം റിപ്പോർട്ട് ചെയ്യുക അല്ലെങ്കിൽ ഒരു ഫീച്ചർ നിർദ്ദേശിക്കുക?";
"faq_answer_8" = "ഞാൻ → ഫീഡ്ബാക്ക് തുറന്ന് ബഗ് റിപ്പോർട്ടോ ഫീച്ചർ നിർദ്ദേശമോ തിരഞ്ഞെടുക്കുക. സ്പോർട്സ്, ഘട്ടങ്ങൾ, പ്രതീക്ഷിക്കുന്ന ഫലം, യഥാർത്ഥ ഫലം എന്നിവ ഉൾപ്പെടുത്തുക. ഡിസ്പ്ലേ അല്ലെങ്കിൽ അംഗത്വ പ്രശ്നങ്ങൾക്ക്, ഉപകരണ മോഡൽ, സിസ്റ്റം പതിപ്പ്, ആപ്പ് പതിപ്പ് എന്നിവയും ഉൾപ്പെടുത്തുക.";
"faq_question_10" = "എങ്ങനെയാണ് ഞാൻ എൻ്റെ ഡാറ്റ ബാക്കപ്പ് ചെയ്യുക അല്ലെങ്കിൽ ഒരു പുതിയ ഫോണിലേക്ക് നീക്കുക?";
"faq_answer_10" = "സൂക്ഷിച്ച ടീമിന്റെയും കളിക്കാരുടെയും പേരുകളും സ്ഥലങ്ങളും ഉപകരണങ്ങൾക്കിടയിൽ സമന്വയിപ്പിക്കാൻ സൈൻ ഇൻ ചെയ്യുക. പുതിയ ഫോണിൽ അതേ അക്കൗണ്ടിൽ സൈൻ ഇൻ ചെയ്ത് ഈ പൊതുവായ ഡാറ്റ ലഭ്യമാക്കുക. മത്സര രേഖകളും ടൈമർ രേഖകളും പൂർത്തിയാകാത്ത മത്സരങ്ങളും നിലവിലെ ഉപകരണത്തിൽതന്നെ തുടരും; ഇവയ്ക്ക് ക്ലൗഡ് ബാക്കപ്പും പുനഃസ്ഥാപിക്കലും ലഭ്യമല്ല.";
"faq_question_11" = "എങ്ങനെയാണ് എൻ്റെ ഡാറ്റയും സ്വകാര്യതയും കൈകാര്യം ചെയ്യുന്നത്?";
"faq_answer_11" = "ഏത് ഡാറ്റ എന്തിനാണ് ഉപയോഗിക്കുന്നത് എന്ന് സ്വകാര്യതാ നയം വിശദീകരിക്കുന്നു. വോയ്സ് നോട്ടുകൾ രേഖപ്പെടുത്താൻ മൈക്രോഫോൺ ഉപയോഗിക്കുന്നു. വിശ്വസനീയമായ സൈൻ-ഇൻ QR കോഡുകൾ സ്കാൻ ചെയ്യാനും നിങ്ങളുടെ അവതാറിനായി ഫോട്ടോ എടുക്കാനും ക്യാമറ ഉപയോഗിക്കുന്നു.";
