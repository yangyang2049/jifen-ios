"scoreboard_usage_hint_soft_tennis" = "👆 ഒരു പോയിൻ്റ് രേഖപ്പെടുത്താൻ ഇടത്/വലത് സ്കോർ ഏരിയയിൽ ടാപ്പ് ചെയ്യുക\n↩️ മുമ്പത്തെ പ്രവർത്തനം പഴയപടിയാക്കാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക\n🎾 തിരഞ്ഞെടുത്ത 7- അല്ലെങ്കിൽ 9-ഗെയിം മത്സരം ഉപയോഗിക്കുന്നു; 7-പോയിൻ്റ്, വിൻ-ബൈ-ടു-ടൈബ്രേക്കാണ് അവസാന ഗെയിം തീരുമാനിക്കുന്നത്\n🔄 വശംമാറ്റങ്ങളും വിശ്രമ നിർദ്ദേശങ്ങളും നിലവിലെ മത്സര നിയമം പാലിക്കും";
"scoreboard_usage_hint_padel" = "👆 ഒരു പോയിൻ്റ് രേഖപ്പെടുത്താൻ ഇടത്/വലത് സ്കോർ ഏരിയയിൽ ടാപ്പ് ചെയ്യുക\n↩️ മുമ്പത്തെ പ്രവർത്തനം പഴയപടിയാക്കാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക\n🎾 പോയിൻ്റുകൾ, ഗെയിമുകൾ, സെറ്റുകൾ, തിരഞ്ഞെടുത്ത അഡ്വാന്റേജ്, ഗോൾഡൻ-പോയിൻ്റ് അല്ലെങ്കിൽ സ്റ്റാർ പോയിൻ്റ് ഡ്യൂസ് മോഡ് എന്നിവ യാന്ത്രികമാണ്\n🔄 വശംമാറ്റങ്ങളും വിശ്രമ നിർദ്ദേശങ്ങളും നിലവിലെ മത്സര നിയമം പാലിക്കും";
"scoreboard_usage_hint_football_5v5" = "👆 1 ഗോൾ ചേർക്കാൻ ഇടത്/വലത് സ്കോർ ഏരിയയിൽ ടാപ്പ് ചെയ്യുക\n⬆️ ചേർക്കാൻ മുകളിലേക്ക് സ്വൈപ്പ് ചെയ്യുക\n⬇️ കുറയ്ക്കാൻ താഴേക്ക് സ്വൈപ്പ് ചെയ്യുക\n↩️ പഴയപടിയാക്കാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക\n⏯️ സമയം താൽക്കാലികമായി നിർത്തുന്നതിനോ പുനരാരംഭിക്കുന്നതിനോ ക്ലോക്കിൽ ടാപ്പ് ചെയ്യുക";
