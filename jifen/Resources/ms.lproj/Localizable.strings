"scoreboard_usage_hint_pickleball_doubles" = "👆 Ketik kawasan skor kiri/kanan untuk menambah\n⬆️ Leret ke atas untuk menambah\n⬇️ Leret ke bawah untuk menolak\n↩️ Leret ke kiri untuk membuat asal\n🏁 Skor dan set ikut peraturan pickleball\n👥 Beregu menunjukkan pemain dari tetapan";
"scoreboard_usage_hint_archery" = "👆 Ketik kawasan pesaing, kemudian pilih nilai anak panah untuk merekod setiap anak panah dan siri panahan\n↩️ Leret ke kiri untuk membuat asal kesilapan\n🏹 Mata set mengikut format memanah yang dipilih\n🎯 Pada 5–5, ikuti panahan penentu paling dekat ke tengah pada skrin";
"scoreboard_usage_hint_boxing" = "🥊 Gunakan aksi pusingan untuk memasukkan markah kedua-dua petinju untuk pusingan itu\n📊 Melengkapkan pusingan mengemas kini jumlah mata dan pusingan yang dimenangi\n↩️ Buat asal kesilapan daripada menu\n✏️ Gunakan edit atau selesaikan apabila pembetulan diperlukan";
"scoreboard_usage_hint_billiards" = "👆 Ketik kawasan skor kiri/kanan untuk menambah\n⬆️ Leret ke atas untuk menambah\n⬇️ Leret ke bawah untuk menolak\n↩️ Leret ke kiri untuk membuat asal\n✏️ Gunakan edit atau menu untuk membetulkan, tangkapan skrin atau menyelesaikan";
"scoreboard_usage_hint_eight_ball" = "👆 Ketik kawasan skor kiri/kanan untuk meframeam frame\n⬆️ Leret ke atas untuk menambah 1 frame\n⬇️ Leret ke bawah untuk menolak 1 frame\n↩️ Leret ke kiri untuk membuat asal\n🏁 Perlawanan tamat mengikut frame sasaran";
"scoreboard_usage_hint_nine_ball" = "👆 Ketik pemain, bola atau butang acara untuk merakam mata mengejar\n🎱 Ini adalah latihan mengejar mata; gunakan bola dan acara yang ditunjukkan pada skrin\n↩️ Leret ke kiri atau gunakan Buat asal dahulu apabila kesilapan dilakukan\n✏️ Gunakan edit apabila pembetulan terperinci diperlukan";
"scoreboard_usage_hint_snooker" = "🔴 Ketik butang merah, warna atau markah untuk mencatat mata\n⚠️ Gunakan Foul untuk merekod mata penalti\n🔁 Ketik Tukar giliran untuk menukar pemain yang memukul\n↩️ Buat asal kesilapan dahulu, atau gunakan edit\n☑️ Buka Selesaikan dari menu sebelah kanan bawah apabila diperlukan";
"scoreboard_usage_hint_guandan" = "👆 Gunakan kawalan kiri dan kanan untuk merekod setiap keputusan dan kemajuan tahap\n↕️ Dalam mod edit, leret menegak pada kedua-dua sisi untuk menukar tahapnya dengan cepat\n🅰️ Melepasi A, tetapkan semula, buat asal dan kemasan manual tersedia pada papan atau menu\n↩️ Buat asal kesilapan sebelum meneruskan dari tahap semasa";
"scoreboard_usage_hint_shengji" = "👆 Mulakan dengan mengetik Bida untuk Menjadi Pembahagi untuk mana-mana pasukan\n🏆 Rakam setiap pusingan dengan Jadi Pembahagi atau butang +1, +2 dan +3\n↩️ Buat asal pusingan sebelumnya daripada menu\n✏️ Ketik pensel di bahagian atas sebelah kanan untuk mengedit nama dan tahap pasukan\n🔄 Tetapkan semula atau selesaikan perlawanan secara manual";
"scoreboard_usage_hint_uno" = "👆 Ketik pemain untuk membuka panel pemarkahan pusingan\n✏️ Tekan lama pemain untuk mengedit nama dan skor\n↩️ Buat asal pusingan sebelumnya\n☑️ Kira keputusan atau tamatkan perlawanan secara manual\n🖼️ Tetapan paparan dan tangkapan skrin ada dalam menu";
"scoreboard_usage_hint_doudizhu" = "➕ Ketik butang tambah di bahagian tengah bawah untuk membuka penyelesaian pusingan\n🧮 Pilih markah asas, pengganda dan sama ada seorang pemenang atau semua orang kecuali seorang yang kalah\n↩️ Leret ke kiri atau gunakan menu untuk membuat asal pusingan sebelumnya\n✏️ Ketik pensel di bahagian atas sebelah kanan untuk mengedit pemain dan markah\n🔄 Tetapkan semula atau selesaikan perlawanan secara manual";
"scoreboard_usage_hint_foosball" = "👆 Ketik kawasan skor kiri/kanan untuk menambah 1 gol\n⬆️ Leret ke atas untuk menambah\n⬇️ Leret ke bawah untuk menolak\n↩️ Leret ke kiri untuk membuat asal\n☑️ Gunakan Selesaikan atau Tamatkan apabila perlawanan tamat";
