"scoreboard_usage_hint_eight_ball" = "👆 Tryk på venstre/højre pointområde for at registrere en frame\n⬆️ Stryg op for at tilføje 1 frame\n⬇️ Stryg ned for at trække 1 frame fra\n↩️ Stryg til venstre for at fortryde\n🏁 Kampen slutter, når det krævede antal frames er nået";
"scoreboard_usage_hint_nine_ball" = "👆 Tryk på en spiller-, bold- eller begivenhedsknap for at registrere chase-point\n🎱 Dette er øvelse i chase-point; brug bolde og begivenheder vist på skærmen\n↩️ Stryg til venstre eller brug Fortryd først, når der er begået en fejl\n✏️ Brug redigering, når der er behov for detaljeret rettelse";
"scoreboard_usage_hint_snooker" = "🔴 Tryk på røde, farve- eller scoreknapper for at score\n⚠️ Brug fejl til at optage strafpoint\n🔁 Tryk på Skift tur for at ændre spilleren ved bordet\n↩️ Fortryd fejl først, eller brug redigering\n☑️ Åbn Afslut frame fra menuen nederst til højre, når det er nødvendigt";
