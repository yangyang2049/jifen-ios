"scoreboard_usage_hint_pickleball" = "👆 Tik op het linker/rechter scoregebied om toe te voegen\n⬆️ Veeg omhoog om toe te voegen\n⬇️ Veeg omlaag om af te trekken\n↩️ Veeg naar links om ongedaan te maken\n🏁 Score en sets volgen de pickleball-regels";
"scoreboard_usage_hint_pickleball_doubles" = "👆 Tik op het linker/rechter scoregebied om toe te voegen\n⬆️ Veeg omhoog om toe te voegen\n⬇️ Veeg omlaag om af te trekken\n↩️ Veeg naar links om ongedaan te maken\n🏁 Score en sets volgen de pickleball-regels\n👥 Dubbelspel toont spelers vanaf het instelscherm";
"scoreboard_usage_hint_archery" = "👆 Tik op het vak van een deelnemer en kies een pijlwaarde om elke pijl en het einde vast te leggen\n↩️ Veeg naar links om een fout ongedaan te maken\n🏹 Setpoints volgen het gekozen boogschietformaat\n🎯 Bij 5–5 beslist de shoot-off (dichtst bij het midden)";
"scoreboard_usage_hint_boxing" = "🥊 Gebruik de rondeactie om de scores van beide boksers voor de ronde in te voeren\n📊 Als je een ronde voltooit, wordt het totaal aantal punten en gewonnen rondes bijgewerkt\n↩️ Maak fouten uit het menu ongedaan\n✏️ Gebruik bewerken of voltooien wanneer een correctie nodig is";
"scoreboard_usage_hint_billiards" = "👆 Tik op het linker/rechter scoregebied om toe te voegen\n⬆️ Veeg omhoog om toe te voegen\n⬇️ Veeg omlaag om af te trekken\n↩️ Veeg naar links om ongedaan te maken\n✏️ Gebruik bewerken of menu om te corrigeren, een screenshot te maken of te voltooien";
"scoreboard_usage_hint_eight_ball" = "👆 Tik op het linker/rechter scoregebied om een frame te registreren\n⬆️ Veeg omhoog om 1 frame toe te voegen\n⬇️ Veeg omlaag om 1 frame af te trekken\n↩️ Veeg naar links om ongedaan te maken\n🏁 De wedstrijd eindigt bij het doelaantal frames";
"scoreboard_usage_hint_nine_ball" = "👆 Tik op een speler-, bal- of evenementknop om chasepunten vast te leggen\n🎱 Dit is een oefening in chasepunten; gebruik de ballen en evenementen die op het scherm worden weergegeven\n↩️ Veeg naar links of gebruik eerst Ongedaan maken als er een fout is gemaakt\n✏️ Gebruik bewerken wanneer gedetailleerde correctie nodig is";
"scoreboard_usage_hint_snooker" = "🔴 Tik op de rode, kleur- of scoreknoppen om te scoren\n⚠️ Gebruik Fout om strafpunten te noteren\n🔁 Tik op Beurt wisselen om van beurtspeler te wisselen\n↩️ Maak fouten eerst ongedaan of gebruik bewerken\n☑️ Open Afrekenen vanuit het menu rechtsonder wanneer dat nodig is";
"scoreboard_usage_hint_guandan" = "👆 Gebruik de linker- en rechterbediening om elk resultaat en de voortgang van het niveau vast te leggen\n↕️ Veeg in de bewerkingsmodus verticaal naar beide kanten om het niveau snel te wijzigen\n🅰️ A doorgeven, resetten, ongedaan maken en handmatig voltooien zijn beschikbaar op het bord of menu\n↩️ Maak een fout ongedaan voordat je verdergaat vanaf het huidige niveau";
"scoreboard_usage_hint_shengji" = "👆 Begin door voor een van beide teams op Bieddealer te tikken\n🏆 Registreer elke ronde met Neem Dealer of de +1, +2 en +3 knoppen\n↩️ Maak de vorige ronde ongedaan via het menu\n✏️ Tik op het potlood rechtsboven om teamnamen en niveaus te bewerken\n🔄 Reset of voltooi de wedstrijd handmatig";
"scoreboard_usage_hint_uno" = "👆 Tik op een speler om het rondescorepaneel te openen\n✏️ Druk lang op een speler om de naam en score te bewerken\n↩️ Maak de vorige ronde ongedaan\n☑️ Beëindig of voltooi de wedstrijd handmatig\n🖼️ Weergave-instellingen en screenshots staan in het menu";
"scoreboard_usage_hint_doudizhu" = "➕ Tik op de plusknop middenonder om rondeafrekeningen te openen\n🧮 Kies de basisscore, vermenigvuldiger en één winnaar of iedereen behalve één verliezer\n↩️ Veeg naar links of gebruik het menu om de vorige ronde ongedaan te maken\n✏️ Tik op het potlood rechtsboven om spelers en scores te bewerken\n🔄 Reset of voltooi de wedstrijd handmatig";
"scoreboard_usage_hint_foosball" = "👆 Tik op het linker/rechter scoregebied om 1 doelpunt toe te voegen\n⬆️ Veeg omhoog om toe te voegen\n⬇️ Veeg omlaag om af te trekken\n↩️ Veeg naar links om ongedaan te maken\n☑️ Gebruik Afrekenen of Voltooien wanneer de wedstrijd eindigt";
"scoreboard_usage_hint_foosball_doubles" = "👆 Tik op het linker/rechter scoregebied om 1 doelpunt toe te voegen\n⬆️ Veeg omhoog om toe te voegen\n⬇️ Veeg omlaag om af te trekken\n↩️ Veeg naar links om ongedaan te maken\n👥 2V2-namen worden vóór de wedstrijd vastgelegd\n☑️ Gebruik Afrekenen of Voltooien wanneer de wedstrijd eindigt";
"scoreboard_usage_hint_simple_score" = "👆 Tik op het linker/rechter scoregebied om toe te voegen\n⬆️ Veeg omhoog om toe te voegen\n⬇️ Veeg omlaag om af te trekken\n↩️ Veeg naar links om ongedaan te maken\n✏️ Druk lang of bewerk om namen en scores te wijzigen";
