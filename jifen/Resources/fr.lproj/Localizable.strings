"scoreboard_usage_hint_pickleball" = "👆 Appuyez sur la zone de score gauche/droite pour ajouter\n ⬆️ Faites glisser votre doigt vers le haut pour ajouter\n ⬇️ Faites glisser votre doigt vers le bas pour soustraire\n ↩️ Balayez vers la gauche pour annuler\n 🏁 Les scores et les sets suivent les règles du pickleball";
"scoreboard_usage_hint_pickleball_doubles" = "👆 Touchez la zone de score gauche/droite pour ajouter\n⬆️ Balayez vers le haut pour ajouter\n⬇️ Balayez vers le bas pour soustraire\n↩️ Balayez vers la gauche pour annuler\n🏁 Le score et les sets suivent les règles du pickleball\n👥 En double, les joueurs proviennent de la configuration";
"scoreboard_usage_hint_archery" = "👆 Touchez la zone d’un concurrent, puis choisissez une valeur pour enregistrer chaque flèche et chaque volée\n↩️ Balayez vers la gauche pour annuler une erreur\n🏹 Les points de set suivent le format de tir à l’arc sélectionné\n🎯 À 5–5, suivez à l’écran le barrage de la flèche la plus proche du centre";
"scoreboard_usage_hint_boxing" = "🥊 Utilisez l’action du round pour saisir les scores des deux boxeurs\n📊 Terminer un round met à jour le total des points et les rounds gagnés\n↩️ Annulez les erreurs depuis le menu\n✏️ Utilisez Modifier ou Terminer lorsqu’une correction est nécessaire";
"scoreboard_usage_hint_billiards" = "👆 Touchez la zone de score gauche/droite pour ajouter\n⬆️ Balayez vers le haut pour ajouter\n⬇️ Balayez vers le bas pour soustraire\n↩️ Balayez vers la gauche pour annuler\n✏️ Utilisez Modifier ou le menu pour corriger, faire une capture d’écran ou terminer";
"scoreboard_usage_hint_eight_ball" = "👆 Appuyez sur la zone de score gauche/droite pour enregistrer un rack\n ⬆️ Faites glisser votre doigt vers le haut pour ajouter 1 rack\n ⬇️ Faites glisser votre doigt vers le bas pour soustraire 1 rack\n ↩️ Balayez vers la gauche pour annuler\n 🏁 Le match se termine par les racks cibles";
"scoreboard_usage_hint_nine_ball" = "👆 Touchez un joueur, une bille ou un bouton d’événement pour enregistrer les points de poursuite\n🎱 Cet entraînement utilise les points de poursuite ; servez-vous des billes et événements affichés à l’écran\n↩️ En cas d’erreur, balayez vers la gauche ou utilisez d’abord Annuler\n✏️ Utilisez Modifier pour effectuer une correction détaillée";
"scoreboard_usage_hint_snooker" = "🔴 Touchez les boutons de bille rouge, de couleur ou de score pour marquer\n⚠️ Utilisez Faute pour enregistrer les points de pénalité\n🔁 Touchez Passer la main pour changer de joueur\n↩️ Annulez d’abord les erreurs ou utilisez Modifier\n☑️ Ouvrez Clôturer dans le menu en bas à droite si nécessaire";
"scoreboard_usage_hint_guandan" = "👆 Utilisez les commandes gauche et droite pour enregistrer chaque résultat et progression de niveau\n ↕️ En mode édition, faites glisser votre doigt verticalement de chaque côté pour changer rapidement son niveau\n 🅰️ Passer A, réinitialiser, annuler et terminer manuellement sont disponibles sur le tableau ou dans le menu\n ↩️ Annuler une erreur avant de continuer à partir du niveau actuel";
"scoreboard_usage_hint_shengji" = "👆 Commencez par appuyer sur Bid Dealer pour l'une ou l'autre équipe\n 🏆 Enregistrez chaque tour avec Take Dealer ou les boutons +1, +2 et +3\n ↩️ Annuler le tour précédent depuis le menu\n ✏️ Appuyez sur le crayon en haut à droite pour modifier les noms et les niveaux des équipes\n 🔄 Réinitialiser ou terminer le match manuellement";
"scoreboard_usage_hint_uno" = "👆 Appuyez sur un joueur pour ouvrir le panneau de notation des tours\n ✏️ Appuyez longuement sur un joueur pour modifier le nom et le score\n ↩️ Annuler le tour précédent\n ☑️ Régler ou terminer le match manuellement\n 🖼️ Les paramètres d'affichage et les captures d'écran sont dans le menu";
"scoreboard_usage_hint_doudizhu" = "➕ Touchez le bouton plus en bas au centre pour ouvrir le résultat de la manche\n🧮 Choisissez le score de base, le multiplicateur et soit un vainqueur, soit tous les joueurs sauf un perdant\n↩️ Balayez vers la gauche ou utilisez le menu pour annuler la manche précédente\n✏️ Touchez le crayon en haut à droite pour modifier les joueurs et les scores\n🔄 Réinitialisez ou terminez le match manuellement";
"scoreboard_usage_hint_foosball" = "👆 Touchez la zone de score gauche/droite pour ajouter 1 but\n⬆️ Balayez vers le haut pour ajouter\n⬇️ Balayez vers le bas pour soustraire\n↩️ Balayez vers la gauche pour annuler\n☑️ Utilisez Clôturer ou Terminer à la fin du match";
