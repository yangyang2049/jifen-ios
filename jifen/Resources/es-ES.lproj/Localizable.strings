"scoreboard_usage_hint_got_it" = "Entendido";
"scoreboard_usage_hint_football" = "👆 Toca la zona de puntuación izquierda o derecha para sumar 1 gol\n⬆️ Desliza hacia arriba para sumar\n⬇️ Desliza hacia abajo para restar\n↩️ Desliza hacia la izquierda para deshacer\n⏱️ Abre Tiempo añadido en el menú inferior derecho, elige una duración y después cancela o confirma\n🏁 Tras la segunda parte y el tiempo añadido, un partido empatado puede continuar con dos prórrogas de 15 minutos";
"scoreboard_usage_hint_basketball" = "👆 Toca +1, +2 o +3 para el equipo\n↩️ Desliza hacia la izquierda para deshacer\n🚩 Toca la zona de faltas para sumar una; mantenla pulsada para quitar una\n⏱️ Usa el panel de baloncesto para controlar el reloj, el periodo y los tiempos muertos";
"scoreboard_usage_hint_basketball_training" = "🏀 Toca la zona Fallo o Canasta para registrar un tiro\n↩️ Desliza hacia la izquierda para deshacer el último registro\n⏹️ Reiniciar y Finalizar entrenamiento están en el menú inferior derecho";
"scoreboard_usage_hint_three_basketball" = "👆 Toca un botón de puntuación del equipo\n↩️ Desliza hacia la izquierda para deshacer\n🚩 Toca la zona de faltas para sumar una; mantenla pulsada para quitar una\n⏱️ Usa el panel de baloncesto para controlar el reloj, el periodo y los tiempos muertos";
"scoreboard_usage_hint_volleyball" = "👆 Toca el área de puntuación izquierda/derecha para agregar\n ⬆️ Desliza hacia arriba para agregar\n ⬇️ Desliza hacia abajo para restar\n ↩️ Desliza hacia la izquierda para deshacer\n 🏁 Los sets y los puntos de juego siguen las reglas del voleibol";
"scoreboard_usage_hint_beach_volleyball" = "👆 Toca el área de puntuación izquierda/derecha para agregar\n ⬆️ Desliza hacia arriba para agregar\n ⬇️ Desliza hacia abajo para restar\n ↩️ Desliza hacia la izquierda para deshacer\n 🏁 Los sets y puntos de juego siguen las reglas del voleibol de playa.";
"scoreboard_usage_hint_air_volleyball" = "👆 Toca el área de puntuación izquierda/derecha para agregar\n ⬆️ Desliza hacia arriba para agregar\n ⬇️ Desliza hacia abajo para restar\n ↩️ Desliza hacia la izquierda para deshacer\n 🏁 Los sets y puntos de juego siguen las reglas del voleibol aéreo";
"scoreboard_usage_hint_pingpong" = "👆 Toca el área de puntuación izquierda/derecha para agregar\n ⬆️ Desliza hacia arriba para agregar\n ⬇️ Desliza hacia abajo para restar\n ↩️ Desliza hacia la izquierda para deshacer\n 🏁 Los sets, el punto de juego y el final siguen las reglas del tenis de mesa";
"scoreboard_usage_hint_pingpong_doubles" = "👆 Toca la zona de puntuación izquierda o derecha para sumar\n⬆️ Desliza hacia arriba para sumar\n⬇️ Desliza hacia abajo para restar\n↩️ Desliza hacia la izquierda para deshacer\n🏁 Los sets, el punto de juego y el final siguen las reglas del tenis de mesa\n👥 En dobles se muestran los jugadores y la rotación del saque definidos en la configuración";
"scoreboard_usage_hint_tennis" = "👆 Toca la zona de puntuación izquierda o derecha para registrar un punto\n⬆️ Desliza hacia arriba para sumar\n⬇️ Desliza hacia abajo para restar\n↩️ Desliza hacia la izquierda para deshacer\n🎾 0/15/30/40, iguales, ventaja, juegos y sets se calculan automáticamente";
"scoreboard_usage_hint_tennis_doubles" = "👆 Toca la zona de puntuación izquierda o derecha para registrar un punto\n⬆️ Desliza hacia arriba para sumar\n⬇️ Desliza hacia abajo para restar\n↩️ Desliza hacia la izquierda para deshacer\n🎾 0/15/30/40, iguales, ventaja, juegos y sets se calculan automáticamente\n👥 En dobles se muestran los jugadores definidos en la configuración";
"scoreboard_usage_hint_badminton" = "👆 Toca el área de puntuación izquierda/derecha para agregar\n ⬆️ Desliza hacia arriba para agregar\n ⬇️ Desliza hacia abajo para restar\n ↩️ Desliza hacia la izquierda para deshacer\n 🏁 Los sets y los puntos de juego siguen las reglas del bádminton";
"scoreboard_usage_hint_badminton_doubles" = "👆 Toca el área de puntuación izquierda/derecha para agregar\n ⬆️ Desliza hacia arriba para agregar\n ⬇️ Desliza hacia abajo para restar\n ↩️ Desliza hacia la izquierda para deshacer\n 🏁 Los sets y los puntos de juego siguen las reglas del bádminton\n 👥 Dobles muestra a los jugadores desde la preparación";
"scoreboard_usage_hint_pickleball" = "👆 Toca el área de puntuación izquierda/derecha para agregar\n ⬆️ Desliza hacia arriba para agregar\n ⬇️ Desliza hacia abajo para restar\n ↩️ Desliza hacia la izquierda para deshacer\n 🏁 La puntuación y los conjuntos siguen las reglas del pickleball";
"scoreboard_usage_hint_pickleball_doubles" = "👆 Toca el área de puntuación izquierda/derecha para agregar\n ⬆️ Desliza hacia arriba para agregar\n ⬇️ Desliza hacia abajo para restar\n ↩️ Desliza hacia la izquierda para deshacer\n 🏁 La puntuación y los conjuntos siguen las reglas del pickleball\n 👥 Dobles muestra a los jugadores desde la preparación";
"scoreboard_usage_hint_archery" = "👆 Toca la zona de un competidor y elige el valor de cada flecha para registrar los tiros y la tanda\n↩️ Desliza hacia la izquierda para deshacer un error\n🏹 Los puntos de set siguen el formato de tiro con arco seleccionado\n🎯 Con 5–5, sigue en pantalla el desempate por cercanía al centro";
"scoreboard_usage_hint_boxing" = "🥊 Usa la acción de ronda para introducir las puntuaciones de ambos boxeadores\n📊 Al completar una ronda se actualizan los puntos totales y las rondas ganadas\n↩️ Deshaz los errores desde el menú\n✏️ Usa Editar o Finalizar cuando necesites corregir algo";
"scoreboard_usage_hint_billiards" = "👆 Toca la zona de puntuación izquierda o derecha para sumar\n⬆️ Desliza hacia arriba para sumar\n⬇️ Desliza hacia abajo para restar\n↩️ Desliza hacia la izquierda para deshacer\n✏️ Usa Editar o el menú para corregir, hacer una captura de pantalla o finalizar";
"scoreboard_usage_hint_eight_ball" = "👆 Toca la zona de puntuación izquierda o derecha para registrar una partida\n⬆️ Desliza hacia arriba para sumar 1 partida\n⬇️ Desliza hacia abajo para restar 1 partida\n↩️ Desliza hacia la izquierda para deshacer\n🏁 El encuentro termina al alcanzar el número de partidas fijado";
"scoreboard_usage_hint_nine_ball" = "👆 Toca un jugador, una bola o un botón de evento para registrar puntos de persecución\n🎱 Esta es una práctica de puntos de persecución; usa las bolas y los eventos que aparecen en pantalla\n↩️ Si te equivocas, desliza hacia la izquierda o usa primero Deshacer\n✏️ Usa Editar cuando necesites una corrección detallada";
"scoreboard_usage_hint_snooker" = "🔴 Toca los botones de bola roja, bola de color o puntuación para anotar\n⚠️ Usa Falta para registrar puntos de penalización\n🔁 Toca Cambiar turno para cambiar de jugador\n↩️ Primero deshaz los errores o usa Editar\n☑️ Abre Cerrar en el menú inferior derecho cuando lo necesites";
"scoreboard_usage_hint_guandan" = "👆 Usa los controles izquierdo y derecho para registrar cada resultado y el progreso de nivel\n↕️ En el modo de edición, desliza verticalmente por cualquiera de los lados para cambiar su nivel rápidamente\n🅰️ Pasar A, reiniciar, deshacer y finalizar manualmente están disponibles en el tablero o el menú\n↩️ Deshaz el error antes de continuar desde el nivel actual";
"scoreboard_usage_hint_shengji" = "👆 Comience tocando Oferta Dealer para cualquiera de los equipos\n 🏆 Graba cada ronda con Take Dealer o los botones +1, +2 y +3\n ↩️ Deshacer la ronda anterior desde el menú\n ✏️ Toca el lápiz en la parte superior derecha para editar los nombres y niveles de los equipos\n 🔄 Restablecer o finalizar el partido manualmente";
"scoreboard_usage_hint_uno" = "👆 Toca un jugador para abrir el panel de puntuación de rondas\n ✏️ Mantén presionado un jugador para editar el nombre y la puntuación\n ↩️ Deshacer la ronda anterior\n ☑️ Resuelve o finaliza el partido manualmente\n 🖼️ La configuración de visualización y las capturas de pantalla están en el menú";
"scoreboard_usage_hint_doudizhu" = "➕ Toca el botón más de la parte inferior central para abrir el resultado de la ronda\n🧮 Elige la puntuación base, el multiplicador y un ganador o todos excepto un perdedor\n↩️ Desliza hacia la izquierda o usa el menú para deshacer la ronda anterior\n✏️ Toca el lápiz de la parte superior derecha para editar jugadores y puntuaciones\n🔄 Reinicia o finaliza manualmente la partida";
"scoreboard_usage_hint_foosball" = "👆 Toca el área de puntuación izquierda/derecha para agregar 1 gol\n ⬆️ Desliza hacia arriba para agregar\n ⬇️ Desliza hacia abajo para restar\n ↩️ Desliza hacia la izquierda para deshacer\n ☑️ Usa Resolver o Finalizar cuando termine el partido";
"scoreboard_usage_hint_foosball_doubles" = "👆 Toca el área de puntuación izquierda/derecha para agregar 1 gol\n ⬆️ Desliza hacia arriba para agregar\n ⬇️ Desliza hacia abajo para restar\n ↩️ Desliza hacia la izquierda para deshacer\n 👥 Los nombres 2V2 se establecen antes del partido\n ☑️ Usa Resolver o Finalizar cuando termine el partido";
"scoreboard_usage_hint_simple_score" = "👆 Toca el área de puntuación izquierda/derecha para agregar\n ⬆️ Desliza hacia arriba para agregar\n ⬇️ Desliza hacia abajo para restar\n ↩️ Desliza hacia la izquierda para deshacer\n ✏️ Mantén presionado o edite para cambiar nombres y puntajes";
"scoreboard_usage_hint_multi_scoreboard" = "👆 Toca la ficha de un jugador para sumar 1 punto\n⬆️ Desliza hacia arriba para sumar 1; ⬇️ desliza hacia abajo para restar 1\n↩️ Desliza hacia la izquierda para deshacer\n✏️ Mantén pulsado un jugador para editar el nombre y la puntuación\n🎛️ En el modo de ajuste personalizado, toca un jugador para abrir el panel de ajuste";
