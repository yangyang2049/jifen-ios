"scoreboard_usage_hint_pickleball_doubles" = "👆 ઉમેરવા માટે ડાબે/જમણે સ્કોર વિસ્તારને ટેપ કરો\n⬆️ ઉમેરવા માટે ઉપર સ્વાઈપ કરો\n⬇️ બાદબાકી કરવા માટે નીચે સ્વાઇપ કરો\n↩️ પૂર્વવત્ કરવા માટે ડાબે સ્વાઇપ કરો\n🏁 સ્કોર અને સેટ પિકલબોલના નિયમોનું પાલન કરે છે\n👥 ડબલ્સ ખેલાડીઓને સેટઅપમાંથી બતાવે છે";
"scoreboard_usage_hint_archery" = "👆 પ્રતિસ્પર્ધીના વિસ્તારને ટેપ કરો અને દરેક તીર તથા એન્ડના ગુણ નોંધવા તીરનું મૂલ્ય પસંદ કરો\n↩️ ભૂલ પૂર્વવત્ કરવા ડાબે સ્વાઇપ કરો\n🏹 સેટના ગુણ પસંદ કરેલા તીરંદાજી ફોર્મેટ મુજબ હોય છે\n🎯 5–5 પર સ્ક્રીન પર કેન્દ્રની સૌથી નજીકના તીર માટે શૂટ-ઑફની સૂચનાઓ અનુસરો";
"scoreboard_usage_hint_boxing" = "🥊 રાઉન્ડ માટે બંને બોક્સરના સ્કોર દાખલ કરવા માટે રાઉન્ડ એક્શનનો ઉપયોગ કરો\n📊 રાઉન્ડ પૂર્ણ થતાં કુલ ગુણ અને જીતેલા રાઉન્ડની સંખ્યા અપડેટ થાય છે\n↩️ મેનુમાંથી ભૂલોને પૂર્વવત્ કરો\n✏️ જ્યારે સુધારાની જરૂર હોય ત્યારે સંપાદન અથવા સમાપ્ત કરવાનો ઉપયોગ કરો";
"scoreboard_usage_hint_billiards" = "👆 ઉમેરવા માટે ડાબે/જમણે સ્કોર વિસ્તારને ટેપ કરો\n⬆️ ઉમેરવા માટે ઉપર સ્વાઇપ કરો\n⬇️ બાદબાકી કરવા માટે નીચે સ્વાઇપ કરો\n↩️ પૂર્વવત્ કરવા માટે ડાબે સ્વાઇપ કરો\n✏️ સુધારવા, સ્ક્રીનશૉટ અથવા સમાપ્ત કરવા માટે સંપાદન અથવા મેનૂનો ઉપયોગ કરો";
"scoreboard_usage_hint_eight_ball" = "👆 રેક રેકોર્ડ કરવા માટે ડાબે/જમણે સ્કોર વિસ્તારને ટેપ કરો\n⬆️ 1 રેક ઉમેરવા માટે ઉપર સ્વાઇપ કરો\n⬇️ 1 રેક બાદ કરવા માટે નીચે સ્વાઇપ કરો\n↩️ પૂર્વવત્ કરવા માટે ડાબે સ્વાઇપ કરો\n🏁 મેચ લક્ષ્ય રેક્સ દ્વારા સમાપ્ત થાય છે";
"scoreboard_usage_hint_nine_ball" = "👆 ચેઝ પોઈન્ટ રેકોર્ડ કરવા માટે પ્લેયર, બોલ અથવા ઈવેન્ટ બટનને ટેપ કરો\n🎱 આ ચેઝ-પોઈન્ટ પ્રેક્ટિસ છે; સ્ક્રીન પર બતાવેલ બોલ અને ઇવેન્ટનો ઉપયોગ કરો\n↩️ જ્યારે ભૂલ થાય ત્યારે ડાબે સ્વાઇપ કરો અથવા પહેલા પૂર્વવત્ કરોનો ઉપયોગ કરો\n✏️ જ્યારે વિગતવાર સુધારાની જરૂર હોય ત્યારે સંપાદનનો ઉપયોગ કરો";
"scoreboard_usage_hint_snooker" = "🔴 સ્કોર કરવા માટે લાલ, રંગ અથવા સ્કોર બટન પર ટૅપ કરો\n⚠️ પેનલ્ટી પોઈન્ટ રેકોર્ડ કરવા માટે ફાઉલનો ઉપયોગ કરો\n🔁 સ્ટ્રાઈકર બદલવા માટે સ્વિચ ટર્ન પર ટેપ કરો\n↩️ પહેલા ભૂલોને પૂર્વવત્ કરો અથવા સંપાદનનો ઉપયોગ કરો\n☑️ જ્યારે જરૂર પડે ત્યારે નીચે-જમણા મેનુમાંથી સેટલ ખોલો";
"scoreboard_usage_hint_guandan" = "👆 દરેક પરિણામ અને સ્તરની પ્રગતિને રેકોર્ડ કરવા માટે ડાબા અને જમણા નિયંત્રણોનો ઉપયોગ કરો\n↕️ સંપાદન મોડમાં, તેનું સ્તર ઝડપથી બદલવા માટે બંને બાજુએ ઊભી સ્વાઇપ કરો\n🅰️ A પાસ કરવું, રીસેટ કરવું, પૂર્વવત્ કરવું અને મેન્યુઅલ ફિનિશ બોર્ડ અથવા મેનૂ પર ઉપલબ્ધ છે\n↩️ વર્તમાન સ્તરથી આગળ વધતા પહેલા ભૂલને પૂર્વવત્ કરો";
"scoreboard_usage_hint_shengji" = "👆 કોઈપણ ટીમ માટે ડીલર બનવા બોલી લગાવો ને ટેપ કરીને પ્રારંભ કરો\n🏆 ડીલર બનો અથવા +1, +2 અને +3 બટનો વડે દરેક રાઉન્ડ રેકોર્ડ કરો\n↩️ મેનુમાંથી પાછલા રાઉન્ડને પૂર્વવત્ કરો\n✏️ ટીમના નામ અને સ્તરને સંપાદિત કરવા માટે ઉપર જમણી બાજુએ પેન્સિલને ટેપ કરો\n🔄 મેચને મેન્યુઅલી રીસેટ કરો અથવા સમાપ્ત કરો";
"scoreboard_usage_hint_uno" = "👆 રાઉન્ડ-સ્કોરિંગ પેનલ ખોલવા માટે ખેલાડીને ટેપ કરો\n✏️ નામ અને સ્કોર સંપાદિત કરવા માટે પ્લેયરને લાંબા સમય સુધી દબાવો\n↩️ પાછલા રાઉન્ડને પૂર્વવત્ કરો\n☑️ મેચના ગુણનું મેન્યુઅલી સમાયોજન કરો અથવા સમાપ્ત કરો\n🖼️ ડિસ્પ્લે સેટિંગ્સ અને સ્ક્રીનશોટ મેનુમાં છે";
"scoreboard_usage_hint_doudizhu" = "➕ રાઉન્ડ સેટલમેન્ટ ખોલવા માટે નીચે મધ્યમાં પ્લસ બટનને ટેપ કરો\n🧮 બેઝ સ્કોર, ગુણક અને એક વિજેતા અથવા એક હારેલા સિવાય દરેકને પસંદ કરો\n↩️ પાછલા રાઉન્ડને પૂર્વવત્ કરવા માટે ડાબે સ્વાઇપ કરો અથવા મેનૂનો ઉપયોગ કરો\n✏️ ખેલાડીઓ અને સ્કોર્સને સંપાદિત કરવા માટે ઉપર જમણી બાજુએ પેન્સિલને ટેપ કરો\n🔄 મેચને મેન્યુઅલી રીસેટ કરો અથવા સમાપ્ત કરો";
"scoreboard_usage_hint_foosball" = "👆 1 ગોલ ઉમેરવા માટે ડાબે/જમણે સ્કોર વિસ્તાર પર ટેપ કરો\n⬆️ ઉમેરવા માટે ઉપર સ્વાઈપ કરો\n⬇️ બાદબાકી કરવા માટે નીચે સ્વાઇપ કરો\n↩️ પૂર્વવત્ કરવા માટે ડાબે સ્વાઇપ કરો\n☑️ જ્યારે મેચ સમાપ્ત થાય ત્યારે સેટલ અથવા ફિનિશનો ઉપયોગ કરો";
"scoreboard_usage_hint_foosball_doubles" = "👆 1 ગોલ ઉમેરવા માટે ડાબે/જમણે સ્કોર વિસ્તાર પર ટેપ કરો\n⬆️ ઉમેરવા માટે ઉપર સ્વાઈપ કરો\n⬇️ બાદબાકી કરવા માટે નીચે સ્વાઇપ કરો\n↩️ પૂર્વવત્ કરવા માટે ડાબે સ્વાઇપ કરો\n👥 2V2 નામો મેચ પહેલા સેટ કરવામાં આવ્યા છે\n☑️ જ્યારે મેચ સમાપ્ત થાય ત્યારે સેટલ અથવા ફિનિશનો ઉપયોગ કરો";
"scoreboard_usage_hint_simple_score" = "👆 ઉમેરવા માટે ડાબે/જમણે સ્કોર વિસ્તારને ટેપ કરો\n⬆️ ઉમેરવા માટે ઉપર સ્વાઇપ કરો\n⬇️ બાદબાકી કરવા માટે નીચે સ્વાઇપ કરો\n↩️ પૂર્વવત્ કરવા માટે ડાબે સ્વાઈપ કરો\n✏️ નામ અને સ્કોર્સ બદલવા માટે લાંબા સમય સુધી દબાવો અથવા સંપાદિત કરો";
