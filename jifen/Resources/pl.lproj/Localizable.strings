"scoreboard_usage_hint_billiards" = "👆 Dotknij lewego/prawego obszaru wyniku, aby dodać punkt\n⬆️ Przesuń w górę, aby dodać\n⬇️ Przesuń w dół, aby odjąć\n↩️ Przesuń w lewo, aby cofnąć\n✏️ Użyj edycji lub menu, aby poprawić wynik, zrobić zrzut ekranu lub zakończyć";
"scoreboard_usage_hint_eight_ball" = "👆 Dotknij lewego/prawego obszaru wyniku, aby zapisać partię\n⬆️ Przesuń w górę, aby dodać 1 partię\n⬇️ Przesuń w dół, aby odjąć 1 partię\n↩️ Przesuń w lewo, aby cofnąć\n🏁 Mecz kończy się po osiągnięciu docelowej liczby wygranych partii";
"scoreboard_usage_hint_nine_ball" = "👆 Dotknij gracza, bili lub przycisku zdarzenia, aby zapisać punkty\n🎱 To trening punktacji w dziewiątce; używaj bil i zdarzeń widocznych na ekranie\n↩️ Przy błędzie najpierw przesuń w lewo lub użyj Cofnij\n✏️ Użyj edycji, gdy potrzebna jest dokładniejsza poprawka";
"scoreboard_usage_hint_snooker" = "🔴 Dotknij czerwonej bili, kolorowej bili lub przycisku punktów, aby punktować\n⚠️ Użyj Faul, aby zapisać punkty karne\n🔁 Dotknij Zmień kolejkę, aby zmienić gracza przy stole\n↩️ Najpierw cofnij błąd lub użyj edycji\n☑️ W razie potrzeby otwórz Rozlicz w menu w prawym dolnym rogu";
"scoreboard_usage_hint_guandan" = "👆 Użyj lewych i prawych przycisków, aby zapisać wyniki i awanse poziomu\n↕️ W trybie edycji przesuwaj pionowo po wybranej stronie, aby szybko zmienić jej poziom\n🅰️ Pokonanie poziomu A, reset, cofanie i ręczne zakończenie są na tablicy lub w menu\n↩️ Cofnij błąd przed kontynuowaniem od bieżącego poziomu";
"scoreboard_usage_hint_shengji" = "👆 Zacznij od Licytuj rolę rozdającego dla wybranej drużyny\n🏆 Zapisuj rundy przez Przejmij rolę rozdającego lub przyciski +1, +2 i +3\n↩️ Cofnij poprzednią rundę w menu\n✏️ Dotknij ołówka w prawym górnym rogu, aby zmienić nazwy i poziomy drużyn\n🔄 Zresetuj lub zakończ mecz ręcznie";
"scoreboard_usage_hint_uno" = "👆 Kliknij gracza, aby otworzyć panel punktacji rundy\n ✏️ Naciśnij długo gracza, aby edytować nazwę i wynik\n ↩️ Cofnij poprzednią rundę\n ☑️ Rozstrzygnij lub zakończ mecz ręcznie\n 🖼️ Ustawienia wyświetlania i zrzuty ekranu znajdują się w menu";
"scoreboard_usage_hint_doudizhu" = "➕ Naciśnij przycisk plus w środkowym dolnym rogu, aby otworzyć rozliczenie rundy\n 🧮 Wybierz wynik podstawowy, mnożnik i albo jednego zwycięzcę, albo wszystkich oprócz jednego przegranego\n ↩️ Przesuń w lewo lub użyj menu, aby cofnąć poprzednią rundę\n ✏️ Kliknij ołówek w prawym górnym rogu, aby edytować zawodników i wyniki\n 🔄 Zresetuj lub zakończ mecz ręcznie";
