"scoreboard_usage_hint_badminton_doubles" = "👆 Klepnutím vlevo/vpravo na skóre přidáte bod\n⬆️ Přejetím nahoru přidáte\n⬇️ Přejetím dolů odečtete\n↩️ Přejetím doleva vrátíte akci zpět\n🏁 Sety a setboly se řídí pravidly badmintonu\n👥 Čtyřhra zobrazuje hráče z nastavení";
"scoreboard_usage_hint_pickleball" = "👆 Klepnutím vlevo/vpravo na skóre přidáte bod\n⬆️ Přejetím nahoru přidáte\n⬇️ Přejetím dolů odečtete\n↩️ Přejetím doleva vrátíte akci zpět\n🏁 Skóre a sety se řídí pravidly pickleballu";
"scoreboard_usage_hint_pickleball_doubles" = "👆 Klepnutím vlevo/vpravo na skóre přidáte bod\n⬆️ Přejetím nahoru přidáte\n⬇️ Přejetím dolů odečtete\n↩️ Přejetím doleva vrátíte akci zpět\n🏁 Skóre a sety se řídí pravidly pickleballu\n👥 Čtyřhra zobrazuje hráče z nastavení";
"scoreboard_usage_hint_archery" = "👆 Klepněte na oblast závodníka a vyberte hodnotu šípu pro záznam každého šípu a sady\n↩️ Přejetím doleva opravíte chybu\n🏹 Body za set se řídí zvoleným formátem lukostřelby\n🎯 Při 5–5 postupujte podle rozstřelu na obrazovce; vyhrává šíp nejblíže středu";
"scoreboard_usage_hint_boxing" = "🥊 Pomocí akce kola zadejte skóre obou boxerů pro dané kolo\n📊 Dokončením kola se aktualizuje celkový počet bodů a vyhraná kola\n↩️ Vraťte zpět chyby z nabídky\n✏️ Když je potřeba oprava, použijte upravit nebo dokončit";
"scoreboard_usage_hint_billiards" = "👆 Klepnutím do levé/pravé oblasti skóre přidejte\n⬆️ Chcete-li přidat, přejeďte prstem nahoru\n⬇️ Přejetím dolů odečtete\n↩️ Přejetím doleva akci vrátíte zpět\n✏️ Pro opravu, snímek obrazovky nebo dokončení použijte úpravy nebo nabídku";
"scoreboard_usage_hint_eight_ball" = "👆 Klepnutím vlevo/vpravo na skóre zaznamenáte frame\n⬆️ Přejetím nahoru přidáte 1 frame\n⬇️ Přejetím dolů odečtete 1 frame\n↩️ Přejetím doleva vrátíte akci zpět\n🏁 Zápas končí při cílovém počtu framů";
"scoreboard_usage_hint_nine_ball" = "👆 Klepnutím na hráče, kouli nebo událost zaznamenáte body v bodové honičce\n🎱 Jde o trénink bodové honičky; používejte koule a události na obrazovce\n↩️ Při chybě nejprve přejeďte doleva nebo použijte Vrátit zpět\n✏️ Pro podrobnou opravu použijte úpravy";
"scoreboard_usage_hint_snooker" = "🔴 Bodujte tlačítky červené koule, barevné koule nebo skóre\n⚠️ Trestné body zaznamenáte pomocí Faul\n🔁 Klepnutím na Vystřídat hráče změníte hráče na tahu\n↩️ Chybu nejprve vraťte zpět nebo použijte úpravy\n☑️ V případě potřeby otevřete Vyhodnotit v nabídce vpravo dole";
"scoreboard_usage_hint_guandan" = "👆 Levými a pravými ovládacími prvky zaznamenáte výsledky a postup úrovní\n↕️ V režimu úprav svisle přejeďte na kterékoli straně pro rychlou změnu její úrovně\n🅰️ Úspěšné A, resetování, vrácení zpět a ruční dokončení jsou na tabuli nebo v nabídce\n↩️ Před pokračováním z aktuální úrovně nejprve vraťte chybu zpět";
"scoreboard_usage_hint_shengji" = "👆 Pro některý tým nejprve klepněte na Ucházet se o rozdávání\n🏆 Každé kolo zaznamenáte pomocí Převzít rozdávání nebo tlačítek +1, +2 a +3\n↩️ Předchozí kolo vrátíte zpět z nabídky\n✏️ Tužkou vpravo nahoře upravíte názvy týmů a úrovně\n🔄 Zápas můžete ručně resetovat nebo dokončit";
"scoreboard_usage_hint_uno" = "👆 Klepnutím na hráče otevřete panel bodování\n✏️ Dlouhým stisknutím hráče upravíte jméno a skóre\n↩️ Vraťte zpět předchozí kolo\n☑️ Vyrovnejte nebo ukončete zápas ručně\n🖼️ Nastavení zobrazení a snímky obrazovky jsou v nabídce";
"scoreboard_usage_hint_doudizhu" = "➕ Klepnutím na tlačítko plus uprostřed dole otevřete vypořádání kola\n🧮 Vyberte základní skóre, násobitel a buď jednoho vítěze, nebo všechny kromě jednoho poraženého\n↩️ Chcete-li vrátit zpět předchozí kolo, přejeďte prstem doleva nebo použijte nabídku\n✏️ Klepnutím na tužku vpravo nahoře upravíte hráče a skóre\n🔄 Resetujte nebo ukončete zápas ručně";
"scoreboard_usage_hint_foosball" = "👆 Klepnutím na levou/pravou oblast skóre přidejte 1 gól\n⬆️ Chcete-li přidat, přejeďte prstem nahoru\n⬇️ Přejetím dolů odečtete\n↩️ Přejetím doleva akci vrátíte zpět\n☑️ Po skončení zápasu použijte možnost Vyhodnotit nebo Dokončit";
"scoreboard_usage_hint_foosball_doubles" = "👆 Klepnutím na levou/pravou oblast skóre přidáte 1 gól\n⬆️ Chcete-li přidat, přejeďte prstem nahoru\n⬇️ Přejetím dolů odečtete\n↩️ Přejetím doleva akci vrátíte zpět\n👥 Před zápasem jsou nastavena jména 2V2\n☑️ Po skončení zápasu použijte možnost Vyhodnotit nebo Dokončit";
"scoreboard_usage_hint_simple_score" = "👆 Klepnutím do levé/pravé oblasti skóre přidejte\n⬆️ Chcete-li přidat, přejeďte prstem nahoru\n⬇️ Přejetím dolů odečtete\n↩️ Přejetím doleva akci vrátíte zpět\n✏️ Dlouhým stisknutím nebo úpravou změníte jména a skóre";
"scoreboard_usage_hint_multi_scoreboard" = "👆 Klepnutím na destičku hráče přidáte 1 bod\n⬆️ Přejetím nahoru přidáte 1; ⬇️ přejetím dolů odečtete 1\n↩️ Přejetím doleva akci vrátíte zpět\n✏️ Dlouhým stisknutím hráče upravíte jméno a skóre\n🎛️ V režimu vlastních úprav se klepnutím na hráče otevře panel úprav";
