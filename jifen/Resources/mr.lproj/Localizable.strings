"scoreboard_usage_hint_football" = "👆 1 गोल जोडण्यासाठी डावीकडे/उजवीकडे स्कोअर क्षेत्रावर टॅप करा\n⬆️ जोडण्यासाठी वर स्वाइप करा\n⬇️ वजा करण्यासाठी खाली स्वाइप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n⏱️ खालच्या उजव्या मेनूमधून दुखापतीची वेळ उघडा, कालावधी निवडा, नंतर पूर्ववत करा किंवा पुष्टी करा\n🏁 दुस-या अर्ध्या आणि दुखापतीच्या वेळेनंतर, बरोबरीत सामना दोन 15-मिनिटांच्या अतिरिक्त वेळेपर्यंत चालू ठेवू शकतो";
"scoreboard_usage_hint_basketball" = "👆 संघासाठी +1, +2 किंवा +3 वर टॅप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n🚩 फाऊल जोडण्यासाठी फाऊल क्षेत्रावर टॅप करा; एक काढण्यासाठी लांब दाबा\n⏱️ घड्याळ, कालावधी आणि टाइमआउटसाठी बास्केटबॉल पॅनेल वापरा";
"scoreboard_usage_hint_basketball_training" = "🏀 शॉट रेकॉर्ड करण्यासाठी मिस किंवा यशस्वी झोनवर टॅप करा\n↩️ शेवटचा रेकॉर्ड पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n⏹️ रीसेट आणि प्रशिक्षण पूर्ण करा तळाशी उजव्या मेनूमध्ये आहे";
"scoreboard_usage_hint_three_basketball" = "👆 संघासाठी स्कोअर बटणावर टॅप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n🚩 फाऊल जोडण्यासाठी फाऊल क्षेत्रावर टॅप करा; एक काढण्यासाठी लांब दाबा\n⏱️ घड्याळ, कालावधी आणि टाइमआउटसाठी बास्केटबॉल पॅनेल वापरा";
"scoreboard_usage_hint_volleyball" = "👆 जोडण्यासाठी डाव्या/उजव्या स्कोअर क्षेत्रावर टॅप करा\n⬆️ जोडण्यासाठी वर स्वाइप करा\n⬇️ वजा करण्यासाठी खाली स्वाइप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n🏁 सेट आणि गेम पॉइंट व्हॉलीबॉल नियमांचे पालन करतात";
"scoreboard_usage_hint_beach_volleyball" = "👆 जोडण्यासाठी डाव्या/उजव्या स्कोअर क्षेत्रावर टॅप करा\n⬆️ जोडण्यासाठी वर स्वाइप करा\n⬇️ वजा करण्यासाठी खाली स्वाइप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n🏁 सेट आणि गेम पॉइंट बीच व्हॉलीबॉल नियमांचे पालन करा";
"scoreboard_usage_hint_air_volleyball" = "👆 जोडण्यासाठी डाव्या/उजव्या स्कोअर क्षेत्रावर टॅप करा\n⬆️ जोडण्यासाठी वर स्वाइप करा\n⬇️ वजा करण्यासाठी खाली स्वाइप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n🏁 सेट आणि गेम पॉइंट एअर व्हॉलीबॉल नियमांचे पालन करतात";
"scoreboard_usage_hint_pingpong" = "👆 जोडण्यासाठी डाव्या/उजव्या स्कोअर क्षेत्रावर टॅप करा\n⬆️ जोडण्यासाठी वर स्वाइप करा\n⬇️ वजा करण्यासाठी खाली स्वाइप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n🏁 सेट, गेम पॉइंट आणि फिनिश टेबल टेनिस नियमांचे पालन करा";
"scoreboard_usage_hint_pingpong_doubles" = "👆 जोडण्यासाठी डाव्या/उजव्या स्कोअर क्षेत्रावर टॅप करा\n⬆️ जोडण्यासाठी वर स्वाइप करा\n⬇️ वजा करण्यासाठी खाली स्वाइप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n🏁 सेट, गेम पॉइंट आणि फिनिश टेबल टेनिस नियमांचे पालन करा\n👥 दुहेरी खेळाडूंना दाखवते आणि सेटअपमधून सर्व्हची पाळी दाखवते";
"scoreboard_usage_hint_tennis" = "👆 गुण रेकॉर्ड करण्यासाठी डावीकडे/उजवीकडे स्कोअर क्षेत्रावर टॅप करा\n⬆️ जोडण्यासाठी वर स्वाइप करा\n⬇️ वजा करण्यासाठी खाली स्वाइप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n🎾 0/15/30/40, ड्यूस, अॅडव्हान्टेज, गेम आणि सेट स्वयंचलित आहेत";
"scoreboard_usage_hint_tennis_doubles" = "👆 गुण रेकॉर्ड करण्यासाठी डावीकडे/उजवीकडे स्कोअर क्षेत्रावर टॅप करा\n⬆️ जोडण्यासाठी वर स्वाइप करा\n⬇️ वजा करण्यासाठी खाली स्वाइप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n🎾 0/15/30/40, ड्यूस, अॅडव्हान्टेज, गेम आणि सेट स्वयंचलित आहेत\n👥 दुहेरी सेटअपमधील खेळाडूंना दाखवते";
"scoreboard_usage_hint_badminton" = "👆 जोडण्यासाठी डाव्या/उजव्या स्कोअर क्षेत्रावर टॅप करा\n⬆️ जोडण्यासाठी वर स्वाइप करा\n⬇️ वजा करण्यासाठी खाली स्वाइप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n🏁 सेट आणि गेम पॉइंट बॅडमिंटन नियमांचे पालन करतात";
"scoreboard_usage_hint_badminton_doubles" = "👆 जोडण्यासाठी डाव्या/उजव्या स्कोअर क्षेत्रावर टॅप करा\n⬆️ जोडण्यासाठी वर स्वाइप करा\n⬇️ वजा करण्यासाठी खाली स्वाइप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n🏁 सेट आणि गेम पॉइंट बॅडमिंटन नियमांचे पालन करतात\n👥 दुहेरी सेटअपमधील खेळाडूंना दाखवते";
"scoreboard_usage_hint_pickleball" = "👆 जोडण्यासाठी डाव्या/उजव्या स्कोअर क्षेत्रावर टॅप करा\n⬆️ जोडण्यासाठी वर स्वाइप करा\n⬇️ वजा करण्यासाठी खाली स्वाइप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n🏁 स्कोअर आणि सेट पिकलबॉल नियमांचे पालन करतात";
"scoreboard_usage_hint_pickleball_doubles" = "👆 जोडण्यासाठी डाव्या/उजव्या स्कोअर क्षेत्रावर टॅप करा\n⬆️ जोडण्यासाठी वर स्वाइप करा\n⬇️ वजा करण्यासाठी खाली स्वाइप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n🏁 स्कोअर आणि सेट पिकलबॉल नियमांचे पालन करतात\n👥 दुहेरी सेटअपमधील खेळाडूंना दाखवते";
"scoreboard_usage_hint_archery" = "👆 स्पर्धकाच्या क्षेत्रावर टॅप करून प्रत्येक बाण आणि एंडचे गुण नोंदवण्यासाठी बाणाचे मूल्य निवडा\n↩️ चूक पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n🏹 सेटचे गुण निवडलेल्या धनुर्विद्येच्या स्वरूपानुसार असतात\n🎯 5–5 वर स्क्रीनवरील केंद्राच्या सर्वात जवळच्या बाणाच्या शूट-ऑफ सूचनांचे पालन करा";
"scoreboard_usage_hint_boxing" = "🥊 फेरीसाठी दोन्ही बॉक्सर्सचे स्कोअर प्रविष्ट करण्यासाठी फेरीची क्रिया वापरा\n📊 फेरी पूर्ण केल्यावर एकूण गुण आणि जिंकलेल्या फेऱ्यांची संख्या बदलते\n↩️ मेनूमधील चुका पूर्ववत करा\n✏️ जेव्हा दुरुस्तीची आवश्यकता असेल तेव्हा संपादन किंवा समाप्त वापरा";
"scoreboard_usage_hint_billiards" = "👆 जोडण्यासाठी डाव्या/उजव्या स्कोअर क्षेत्रावर टॅप करा\n⬆️ जोडण्यासाठी वर स्वाइप करा\n⬇️ वजा करण्यासाठी खाली स्वाइप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n✏️ दुरुस्त करण्यासाठी, स्क्रीनशॉट करण्यासाठी किंवा पूर्ण करण्यासाठी संपादन किंवा मेनू वापरा";
"scoreboard_usage_hint_eight_ball" = "👆 रॅक रेकॉर्ड करण्यासाठी डाव्या/उजव्या स्कोअर क्षेत्रावर टॅप करा\n⬆️ 1 रॅक जोडण्यासाठी वर स्वाइप करा\n⬇️ 1 रॅक वजा करण्यासाठी खाली स्वाइप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n🏁 सामना टार्गेट रॅकने संपतो";
"scoreboard_usage_hint_nine_ball" = "👆 चेस पॉइंट रेकॉर्ड करण्यासाठी खेळाडू, बॉल किंवा इव्हेंट बटणावर टॅप करा\n🎱 हा पाठलाग-पॉइंट सराव आहे; स्क्रीनवर दर्शविलेले बॉल आणि कार्यक्रम वापरा\n↩️ चूक झाल्यावर डावीकडे स्वाइप करा किंवा प्रथम पूर्ववत करा वापरा\n✏️ तपशीलवार दुरुस्तीची आवश्यकता असल्यास संपादन वापरा";
"scoreboard_usage_hint_snooker" = "🔴 स्कोअर करण्यासाठी लाल, रंग किंवा स्कोर बटणावर टॅप करा\n⚠️ पेनल्टी पॉइंट रेकॉर्ड करण्यासाठी फाऊल वापरा\n🔁 स्ट्रायकर बदलण्यासाठी स्विच टर्न वर टॅप करा\n↩️ प्रथम चुका पूर्ववत करा किंवा संपादन वापरा\n☑️ जेव्हा गरज असेल तेव्हा तळाशी उजव्या मेनूमधून सेटल उघडा";
"scoreboard_usage_hint_guandan" = "👆 प्रत्येक निकाल आणि पातळीची प्रगती रेकॉर्ड करण्यासाठी डावी आणि उजवी नियंत्रणे वापरा\n↕️ संपादन मोडमध्ये, त्याची पातळी पटकन बदलण्यासाठी दोन्ही बाजूला अनुलंब स्वाइप करा\n🅰️ A पास करणे, रीसेट करणे, पूर्ववत करणे आणि मॅन्युअल फिनिश बोर्ड किंवा मेनूवर उपलब्ध आहेत\n↩️ वर्तमान स्तरावरून पुढे जाण्यापूर्वी चूक पूर्ववत करा";
"scoreboard_usage_hint_shengji" = "👆 कोणत्याही संघासाठी डीलर होण्यासाठी बोली लावा यावर टॅप करून सुरुवात करा\n🏆 डीलर व्हा किंवा +1, +2 आणि +3 बटणांसह प्रत्येक फेरी रेकॉर्ड करा\n↩️ मेनूमधून मागील फेरी पूर्ववत करा\n✏️ संघाची नावे आणि स्तर संपादित करण्यासाठी सर्वात वरती उजवीकडे पेन्सिलवर टॅप करा\n🔄 मॅच मॅन्युअली रीसेट करा किंवा पूर्ण करा";
"scoreboard_usage_hint_uno" = "👆 राउंड-स्कोअरिंग पॅनल उघडण्यासाठी खेळाडूवर टॅप करा\n✏️ नाव आणि स्कोअर संपादित करण्यासाठी खेळाडूला जास्त वेळ दाबा\n↩️ मागील फेरी पूर्ववत करा\n☑️ मॅच मॅन्युअली सेटल करा किंवा पूर्ण करा\n🖼️ डिस्प्ले सेटिंग्ज आणि स्क्रीनशॉट मेनूमध्ये आहेत";
"scoreboard_usage_hint_doudizhu" = "➕ फेरीचे गुण समायोजन उघडण्यासाठी तळाच्या मध्यभागी प्लस बटणावर टॅप करा\n🧮 बेस स्कोअर, गुणक आणि एकतर विजेता किंवा एक पराभूत वगळता प्रत्येकजण निवडा\n↩️ डावीकडे स्वाइप करा किंवा मागील फेरी पूर्ववत करण्यासाठी मेनू वापरा\n✏️ खेळाडू आणि गुण संपादित करण्यासाठी सर्वात वरती उजवीकडे पेन्सिलवर टॅप करा\n🔄 मॅच मॅन्युअली रीसेट करा किंवा पूर्ण करा";
"scoreboard_usage_hint_foosball" = "👆 1 गोल जोडण्यासाठी डावीकडे/उजवीकडे स्कोअर क्षेत्रावर टॅप करा\n⬆️ जोडण्यासाठी वर स्वाइप करा\n⬇️ वजा करण्यासाठी खाली स्वाइप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n☑️ सामना संपल्यावर सेटल किंवा फिनिश वापरा";
"scoreboard_usage_hint_foosball_doubles" = "👆 1 गोल जोडण्यासाठी डावीकडे/उजवीकडे स्कोअर क्षेत्रावर टॅप करा\n⬆️ जोडण्यासाठी वर स्वाइप करा\n⬇️ वजा करण्यासाठी खाली स्वाइप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n👥 2V2 नावे सामन्यापूर्वी सेट केली आहेत\n☑️ सामना संपल्यावर सेटल किंवा फिनिश वापरा";
"scoreboard_usage_hint_simple_score" = "👆 जोडण्यासाठी डाव्या/उजव्या स्कोअर क्षेत्रावर टॅप करा\n⬆️ जोडण्यासाठी वर स्वाइप करा\n⬇️ वजा करण्यासाठी खाली स्वाइप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n✏️ नावे आणि स्कोअर बदलण्यासाठी जास्त वेळ दाबा किंवा संपादित करा";
"scoreboard_usage_hint_multi_scoreboard" = "👆 1 पॉइंट जोडण्यासाठी प्लेअर टाइलवर टॅप करा\n⬆️ 1 जोडण्यासाठी वर स्वाइप करा; ⬇️ 1 वजा करण्यासाठी खाली स्वाइप करा\n↩️ पूर्ववत करण्यासाठी डावीकडे स्वाइप करा\n✏️ नाव आणि स्कोअर संपादित करण्यासाठी खेळाडूला जास्त वेळ दाबून ठेवा\n🎛️ कस्टम ॲडजस्ट मोडमध्ये, प्लेअरवर टॅप केल्याने ॲडजस्टमेंट पॅनल उघडते";
"scoreboard_usage_hint_double_tap_point" = "👆 1 वजा करण्यासाठी एकाच बाजूला दोनदा टॅप करा";
