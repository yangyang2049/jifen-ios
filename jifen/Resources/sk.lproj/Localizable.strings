"scoreboard_usage_hint_pickleball" = "👆 Klepnutím vľavo/vpravo na skóre pridáte bod\n⬆️ Potiahnutím nahor pridáte\n⬇️ Potiahnutím nadol odčítate\n↩️ Potiahnutím doľava vrátite akciu späť\n🏁 Skóre a sety sa riadia pravidlami pickleballu";
"scoreboard_usage_hint_pickleball_doubles" = "👆 Klepnutím vľavo/vpravo na skóre pridáte bod\n⬆️ Potiahnutím nahor pridáte\n⬇️ Potiahnutím nadol odčítate\n↩️ Potiahnutím doľava vrátite akciu späť\n🏁 Skóre a sety sa riadia pravidlami pickleballu\n👥 Štvorhra zobrazuje hráčov z nastavenia";
"scoreboard_usage_hint_archery" = "👆 Klepnite na oblasť súťažiaceho a vyberte hodnotu šípu pre záznam každého šípu a sady\n↩️ Potiahnutím doľava opravíte chybu\n🏹 Body za set sa riadia zvoleným formátom lukostreľby\n🎯 Pri 5–5 postupujte podľa rozstrelu na obrazovke; vyhráva šíp najbližšie k stredu";
"scoreboard_usage_hint_boxing" = "🥊 Použite akciu kola na zadanie skóre oboch boxerov pre dané kolo\n📊 Dokončenie kola aktualizuje celkový počet bodov a vyhrané kolá\n↩️ Vráťte chyby z ponuky\n✏️ Keď je potrebná oprava, použite možnosť upraviť alebo dokončiť";
"scoreboard_usage_hint_billiards" = "👆 Klepnutím na ľavú/pravú oblasť skóre pridajte\n⬆️ Potiahnutím nahor pridáte\n⬇️ Potiahnutím nadol odpočítajte\n↩️ Vrátiť späť potiahnutím doľava\n✏️ Na opravu, snímku obrazovky alebo dokončenie použite úpravu alebo ponuku";
"scoreboard_usage_hint_eight_ball" = "👆 Klepnutím vľavo/vpravo na skóre zaznamenáte frame\n⬆️ Potiahnutím nahor pridáte 1 frame\n⬇️ Potiahnutím nadol odčítate 1 frame\n↩️ Potiahnutím doľava vrátite akciu späť\n🏁 Zápas končí pri cieľovom počte framov";
"scoreboard_usage_hint_nine_ball" = "👆 Klepnutím na hráča, guľu alebo udalosť zaznamenáte body v bodovej naháňačke\n🎱 Ide o tréning bodovej naháňačky; používajte gule a udalosti na obrazovke\n↩️ Pri chybe najprv potiahnite doľava alebo použite Vrátiť späť\n✏️ Pre podrobnú opravu použite úpravy";
"scoreboard_usage_hint_snooker" = "🔴 Bodujte tlačidlami červenej gule, farebnej gule alebo skóre\n⚠️ Trestné body zaznamenáte pomocou Faul\n🔁 Klepnutím na Vystriedať hráča zmeníte hráča na ťahu\n↩️ Chybu najprv vráťte späť alebo použite úpravy\n☑️ V prípade potreby otvorte Vyhodnotiť v ponuke vpravo dole";
"scoreboard_usage_hint_guandan" = "👆 Ľavými a pravými ovládacími prvkami zaznamenáte výsledky a postup úrovní\n↕️ V režime úprav zvislo potiahnite na ktorejkoľvek strane pre rýchlu zmenu jej úrovne\n🅰️ Úspešné A, resetovanie, vrátenie späť a ručné dokončenie sú na tabuli alebo v ponuke\n↩️ Pred pokračovaním z aktuálnej úrovne najprv vráťte chybu späť";
"scoreboard_usage_hint_shengji" = "👆 Pre niektorý tím najprv klepnite na Uchádzať sa o rozdávanie\n🏆 Každé kolo zaznamenáte pomocou Prevziať rozdávanie alebo tlačidiel +1, +2 a +3\n↩️ Predchádzajúce kolo vrátite späť z ponuky\n✏️ Ceruzkou vpravo hore upravíte názvy tímov a úrovne\n🔄 Zápas môžete ručne resetovať alebo dokončiť";
"scoreboard_usage_hint_uno" = "👆 Klepnutím na hráča otvoríte panel hodnotenia kola\n✏️ Dlhým stlačením hráča upravíte meno a skóre\n↩️ Zrušte predchádzajúce kolo\n☑️ Vyrovnajte alebo dokončite zápas manuálne\n🖼️ Nastavenia zobrazenia a snímky obrazovky sú v ponuke";
"scoreboard_usage_hint_doudizhu" = "➕ Klepnutím na tlačidlo plus v strede dole otvoríte vysporiadanie kola\n🧮 Vyberte si základné skóre, násobiteľ a buď jedného víťaza, alebo všetkých okrem jedného porazeného\n↩️ Prejdením prstom doľava alebo pomocou ponuky vrátite späť predchádzajúce kolo\n✏️ Klepnutím na ceruzku vpravo hore upravíte hráčov a skóre\n🔄 Resetujte alebo ukončite zápas manuálne";
"scoreboard_usage_hint_foosball" = "👆 Klepnutím na ľavú/pravú oblasť skóre pridajte 1 gól\n⬆️ Potiahnutím nahor pridáte\n⬇️ Potiahnutím nadol odpočítajte\n↩️ Vrátiť späť potiahnutím doľava\n☑️ Po skončení zápasu použite možnosť Vyhodnotiť alebo Dokončiť";
"scoreboard_usage_hint_foosball_doubles" = "👆 Klepnutím na ľavú/pravú oblasť skóre pridajte 1 gól\n⬆️ Potiahnutím nahor pridáte\n⬇️ Potiahnutím nadol odpočítajte\n↩️ Vrátiť späť potiahnutím doľava\n👥 Pred zápasom sú nastavené mená 2V2\n☑️ Po skončení zápasu použite možnosť Vyhodnotiť alebo Dokončiť";
"scoreboard_usage_hint_simple_score" = "👆 Klepnutím na ľavú/pravú oblasť skóre pridáte\n⬆️ Potiahnutím nahor pridáte\n⬇️ Potiahnutím nadol odpočítajte\n↩️ Vrátiť späť potiahnutím doľava\n✏️ Dlhým stlačením alebo úpravou zmeníte mená a skóre";
"scoreboard_usage_hint_multi_scoreboard" = "👆 Klepnutím na dlaždicu hráča pridáte 1 bod\n⬆️ Potiahnutím nahor pridajte 1; ⬇️ potiahnutím nadol odčítate 1\n↩️ Vrátiť späť potiahnutím doľava\n✏️ Dlhým stlačením hráča upravíte meno a skóre\n🎛️ V režime vlastných úprav klepnutím na hráča otvoríte panel úprav";
