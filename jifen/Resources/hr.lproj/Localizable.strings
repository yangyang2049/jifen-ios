"scoreboard_usage_hint_nine_ball" = "👆 Dodirnite igrača, kuglu ili događaj za bilježenje bodova u lovu na bodove\n🎱 Ovo je trening lova na bodove; koristite kugle i događaje prikazane na zaslonu\n↩️ Pri pogrešci najprije povucite ulijevo ili koristite Poništi\n✏️ Za detaljan ispravak koristite uređivanje";
"scoreboard_usage_hint_snooker" = "🔴 Bodujte gumbima za crvenu kuglu, kugle u boji ili bodove\n⚠️ Kaznene bodove zabilježite pomoću Prekršaj\n🔁 Dodirnite Promijeni igrača za promjenu igrača na potezu\n↩️ Pogrešku najprije poništite ili koristite uređivanje\n☑️ Po potrebi otvorite Obračunaj u donjem desnom izborniku";
"scoreboard_usage_hint_guandan" = "👆 Lijevim i desnim kontrolama bilježite rezultate i napredovanje po razinama\n↕️ U načinu uređivanja povucite okomito na bilo kojoj strani za brzu promjenu njezine razine\n🅰️ Prolaz A, ponovno postavljanje, poništavanje i ručni završetak nalaze se na ploči ili u izborniku\n↩️ Poništite pogrešku prije nastavka s trenutačne razine";
"scoreboard_usage_hint_shengji" = "👆 Najprije za bilo koji tim dodirnite Natječi se za djelitelja\n🏆 Svaku rundu zabilježite pomoću Preuzmi ulogu djelitelja ili gumba +1, +2 i +3\n↩️ Prethodnu rundu poništite u izborniku\n✏️ Olovkom gore desno uredite imena timova i razine\n🔄 Utakmicu možete ručno ponovno postaviti ili završiti";
"scoreboard_usage_hint_uno" = "👆 Dodirnite igrača da biste otvorili ploču za bodovanje\n✏️ Dugo pritisnite igrača za uređivanje imena i rezultata\n↩️ Poništi prethodni krug\n☑️ Ručno riješite ili završite meč\n🖼️ Postavke zaslona i snimke zaslona nalaze se u izborniku";
"scoreboard_usage_hint_doudizhu" = "➕ Dodirnite gumb plus u donjem središtu da biste otvorili obračun runde\n🧮 Odaberite osnovni rezultat, množitelj i ili jednog pobjednika ili sve osim jednog gubitnika\n↩️ Prijeđite prstom ulijevo ili koristite izbornik za poništavanje prethodnog kruga\n✏️ Dodirnite olovku u gornjem desnom kutu za uređivanje igrača i rezultata\n🔄 Resetirajte ili završite meč ručno";
"scoreboard_usage_hint_foosball" = "👆 Dodirnite lijevo/desno područje rezultata da biste dodali 1 gol\n⬆️ Prijeđite prstom prema gore za dodavanje\n⬇️ Prijeđite prstom prema dolje za oduzimanje\n↩️ Prijeđite prstom ulijevo za poništavanje\n☑️ Koristite Obračunaj ili Završi kada utakmica završi";
"scoreboard_usage_hint_foosball_doubles" = "👆 Dodirnite lijevo/desno područje rezultata da biste dodali 1 gol\n⬆️ Prijeđite prstom prema gore za dodavanje\n⬇️ Prijeđite prstom prema dolje za oduzimanje\n↩️ Prijeđite prstom ulijevo za poništavanje\n👥 2V2 imena postavljaju se prije utakmice\n☑️ Koristite Obračunaj ili Završi kada utakmica završi";
"scoreboard_usage_hint_simple_score" = "👆 Dodirnite lijevo/desno područje rezultata za dodavanje\n⬆️ Prijeđite prstom prema gore za dodavanje\n⬇️ Prijeđite prstom prema dolje za oduzimanje\n↩️ Prijeđite prstom ulijevo za poništavanje\n✏️ Dugo pritisnite ili uredite za promjenu imena i rezultata";
