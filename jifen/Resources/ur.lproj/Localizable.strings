"faq_answer_2" = "گیند والے کھیلوں میں عموماً پوائنٹ دینے کے لیے بائیں/دائیں یا اوپر/نیچے کی جانب ٹیپ کیا جاتا ہے، جبکہ سیٹس، سرو اور سائیڈ کی تبدیلی کھیل کے قواعد کے مطابق ہوتی ہے۔ باسکٹ بال، فٹ بال اور سادہ اسکور بورڈ عام پوائنٹ قدریں دکھاتے ہیں۔ بلیئرڈ، تیر اندازی، باکسنگ اور تاش کے کھیل اسکور، راؤنڈ یا نتیجے کے پینل استعمال کرتے ہیں۔\n\nغلطی ہو جائے تو پہلے واپس لیں یا واپس جائیں استعمال کریں۔ دستی اصلاح کے لیے اسکور بورڈ سے ترمیم یا ترتیبات کھولیں۔ ہر کھیل میں الگ جمع اور منفی بٹن نہیں ہوتے۔";
"faq_question_3" = "میں اسکور بورڈ سے نکل گیا ہوں۔ اسے جاری یا دوبارہ کیسے دیکھوں؟";
"faq_answer_3" = "ہوم ٹیب پر نامکمل میچ کے لیے نیچے ایک بینر (میچ جاری رکھیں) دکھائی دیتا ہے؛ جہاں چھوڑا تھا وہیں سے اسکورنگ جاری رکھنے کے لیے اسے ٹیپ کریں۔ مکمل اور محفوظ میچ ریکارڈز میں دستیاب ہوتے ہیں۔\n\nاگر اندراج موجود نہیں تو ممکن ہے میچ ختم یا حذف ہو چکا ہو، یا مقامی ڈیٹا صاف کر دیا گیا ہو۔ ریکارڈز بنیادی طور پر نتائج دیکھنے کے لیے ہیں اور ممکن ہے ان سے اصل میچ دوبارہ جاری نہ کیا جا سکے۔";
"faq_question_4" = "میں ریکارڈ کو کیسے حذف کروں یا ڈیٹا کو صاف کروں؟";
"faq_answer_4" = "میچ کے دوران، اگر کھیل اجازت دے تو واپس لیں، واپس جائیں یا ترمیم کا اختیار استعمال کریں۔\n\nمحفوظ میچ کے لیے ریکارڈز میں متعلقہ اندراج کھول کر اسے حذف کریں۔ میرا اکاؤنٹ ← ڈیٹا صاف کریں سے مقامی اسکورنگ، ٹائمر، نامکمل میچ، محفوظ ریکارڈ اور بعض مقامی ترتیبات کا ڈیٹا ہٹ جاتا ہے۔ اسے واپس نہیں لیا جا سکتا۔";
"faq_question_5" = "میں ڈسپلے یا دوسرے فون کو کیسے جوڑ سکتا ہوں؟";
"faq_answer_5" = "دو آلات ایک ساتھ استعمال کریں: ایک اسکور رکھتا ہے، دوسرا اسے پوری اسکرین دکھاتا ہے۔ اسکور شیئر کرنے والا آلہ: سائن ان کریں اور 6 ہندسوں کا کوڈ حاصل کرنے کے لیے مطابقت پذیری شروع کریں۔ ڈسپلے والا آلہ: سائن ان کریں اور شیئرنگ ڈیوائس سے 6 ہندسوں کا کوڈ درج کریں۔ اسکور کرنا شروع کریں — سکور خود بخود مطابقت پذیر ہو جاتا ہے۔\n\nAirPlay اسکرین مررنگ تجویز کی جاتی ہے۔ کنکشن قائم اور شناخت ہونے کے بعد اسکور بورڈ خود بخود بڑی اسکرین پر دکھائی دیتا ہے۔ کنٹرول سینٹر کھولیں اور اسکرین مررنگ پر ٹیپ کریں (AirPlay)۔ پہلے سسٹم کی ترتیبات میں AirPlay کنکشن قائم کریں۔ ایپ ایک وقت میں صرف ایک منسلک ڈسپلے استعمال کر سکتی ہے اور خود ٹی وی یا پروجیکٹر تلاش نہیں کر سکتی۔ AirPlay منقطع کرنے سے کاسٹ سیشن بھی ختم ہو جاتا ہے۔";
"faq_question_6" = "مجھے اپنا کھیل نہیں مل سکتا۔میں کیا کروں؟";
"faq_answer_6" = "سب سے ملتے جلتے کھیل سے شروع کریں۔ اگر صرف نام، سیٹس، ٹیمیں یا ابتدائی ترتیب مختلف ہو تو انہیں گیم سیٹ اپ میں بدلیں اور اس سیٹ اپ کو فوری آغاز میں شامل کریں۔\n\nاگر موجودہ کھیل قواعد پورے نہ کرتے ہوں تو کھیل کا نام، عام فارمیٹ، اسکورنگ کا طریقہ اور مطلوبہ طریقۂ کار شامل کرکے تاثرات بھیجیں۔";
"faq_question_7" = "رکنیت، سائن ان، اور نئے آلات کیسے کام کرتے ہیں؟";
"faq_answer_7" = "رکنیت کے فوائد اور خریداری کے ریکارڈ موجودہ اکاؤنٹ سے منسلک ہوتے ہیں۔ رکنیت خریدنے، کوڈ استعمال کرنے یا بحال کرنے سے پہلے سائن ان کریں۔ نئے آلے پر اسی اکاؤنٹ سے سائن ان کرکے رکنیت مرکز تازہ کریں۔\n\nادائیگی کامیاب ہونے کے باوجود رکنیت فعال نہ ہو تو پہلے رکنیت کا صفحہ تازہ کریں۔ مسئلہ برقرار رہے تو آرڈر نمبر، خریداری کا وقت اور سائن ان شدہ اکاؤنٹ شامل کرکے تاثرات بھیجیں۔";
"faq_question_8" = "میں کسی مسئلے کی اطلاع کیسے دوں یا فیچر تجویز کروں؟";
"faq_answer_8" = "میرا اکاؤنٹ ← تاثرات کھولیں اور خرابی کی رپورٹ یا خصوصیت کی تجویز منتخب کریں۔ کھیل، اقدامات، متوقع نتیجہ اور اصل نتیجہ شامل کریں۔ ڈسپلے یا رکنیت کے مسئلے میں آلے کا ماڈل، سسٹم ورژن اور ایپ ورژن بھی شامل کریں۔";
"faq_question_10" = "میں اپنے ڈیٹا کا بیک اپ کیسے لے سکتا ہوں یا اسے نئے فون میں کیسے منتقل کروں؟";
"faq_answer_10" = "محفوظ ٹیموں اور کھلاڑیوں کے نام اور مقامات کو مختلف آلات پر ہم وقت کرنے کے لیے سائن ان کریں۔ نئے فون پر یہی مشترکہ ڈیٹا حاصل کرنے کے لیے اسی اکاؤنٹ سے سائن ان کریں۔ میچ کے ریکارڈ، ٹائمر کے ریکارڈ اور نامکمل میچ موجودہ آلے پر رہتے ہیں؛ ان ریکارڈوں کا کلاؤڈ بیک اپ اور بحالی دستیاب نہیں ہے۔";
"faq_question_11" = "میرے ڈیٹا اور رازداری کا انتظام کیسے کیا جاتا ہے؟";
"faq_answer_11" = "رازداری کی پالیسی بتاتی ہے کہ کون سا ڈیٹا کیوں استعمال ہوتا ہے۔ مائیکروفون صوتی نوٹ ریکارڈ کرنے کے لیے استعمال ہوتا ہے۔ کیمرے کا استعمال قابل اعتماد لاگ ان QR کوڈز کو اسکین کرنے اور پروفائل تصویر لینے کے لیے کیا جاتا ہے۔";
