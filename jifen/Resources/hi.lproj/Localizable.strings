"faq_answer_1" = "होम पर, कोई खेल चुनें, या अधिक विकल्पों के लिए नया मैच खोलें। त्वरित शुरुआत में अक्सर खेले जाने वाले खेल और सेटअप जोड़ें ताकि अगला मैच तेजी से खुले।\n\nजिन खेलों के लिए टीम के नाम, सेट, प्रारूप या सर्व के नियमों की आवश्यकता होती है, वे पहले गेम सेटअप खोलें। पुष्टि करने के बाद स्कोरबोर्ड खुलता है; कुछ सेटिंग्स को स्कोरिंग के दौरान अभी भी समायोजित किया जा सकता है।";
"faq_question_2" = "स्कोर कैसे दर्ज करूँ और गलतियाँ कैसे ठीक करूँ?";
"faq_answer_2" = "बॉल स्पोर्ट्स आमतौर पर आपको एक अंक देने के लिए बाएं/दाएं या ऊपर/नीचे की ओर टैप करने देता है, जबकि सेट, सर्व और साइड परिवर्तन नियमों का पालन करते हैं। बास्केटबॉल, फ़ुटबॉल और साधारण स्कोरबोर्ड आम अंक मान दिखाते हैं। बिलियर्ड्स, तीरंदाजी, मुक्केबाजी और कार्ड गेम स्कोर, राउंड या परिणाम पैनल का उपयोग करते हैं।\n\nयदि आप कोई गलती करते हैं, तो पहले पूर्ववत करें या वापस का उपयोग करें। मैन्युअल सुधार के लिए, स्कोरबोर्ड से संपादन/सेटिंग्स प्रविष्टि खोलें। हर खेल में अलग-अलग प्लस और माइनस बटन नहीं होते हैं।";
"faq_question_3" = "मैंने स्कोरबोर्ड छोड़ दिया। मैं इसे कैसे जारी रखूँ या इसकी समीक्षा कैसे करूँ?";
"faq_answer_3" = "होम टैब पर, एक अधूरा मैच एक निचला बैनर दिखाता है (मैच जारी रखें); स्कोरिंग वहीं से शुरू करने के लिए इसे टैप करें जहां आपने छोड़ा था। समाप्त और सहेजे गए मैच रिकॉर्ड्स में उपलब्ध हैं।\n\nयदि प्रविष्टि समाप्त हो गई है, तो मैच समाप्त हो गया होगा, हटा दिया गया होगा, या स्थानीय डेटा साफ़ हो गया होगा। रिकॉर्ड मुख्य रूप से परिणामों की समीक्षा के लिए हैं और मूल मैच प्रक्रिया को जारी रखने का समर्थन नहीं कर सकते हैं।";
"faq_question_4" = "मैं रिकॉर्ड कैसे हटाऊं या डेटा साफ़ करूं?";
"faq_answer_4" = "किसी मैच के दौरान, यदि वर्तमान खेल इसका समर्थन करता है, तो पूर्ववत करें, वापस जाएं या संपादन प्रविष्टि का उपयोग करें।\n\nसहेजे गए मैचों के लिए, रिकॉर्ड्स में आइटम खोलें और इसे वहां हटा दें। मैं → डेटा साफ़ करें स्थानीय स्कोरिंग, टाइमर, अधूरा मैच, सहेजा गया रिकॉर्ड और कुछ स्थानीय सेटिंग डेटा हटा देता है। इसे पूर्ववत नहीं किया जा सकता।";
"faq_question_5" = "मैं डिस्प्ले या अन्य फोन कैसे कनेक्ट करूं?";
"faq_answer_5" = "दो डिवाइस एक साथ इस्तेमाल करें: एक पर स्कोर दर्ज होता है और दूसरे पर स्कोर पूरी स्क्रीन में दिखता है। शेयरिंग डिवाइस: साइन इन करके सिंक शुरू करें और 6 अंकों का कोड प्राप्त करें। डिस्प्ले डिवाइस: साइन इन करके शेयरिंग डिवाइस का 6 अंकों का कोड दर्ज करें। स्कोर दर्ज करना शुरू करें — स्कोर अपने-आप सिंक होगा।\n\nAirPlay स्क्रीन मिररिंग की सलाह दी जाती है। कनेक्शन मिलने पर स्कोरबोर्ड बड़ी स्क्रीन पर अपने-आप दिखता है। कंट्रोल सेंटर खोलें और स्क्रीन मिररिंग (AirPlay) चुनें। पहले सिस्टम में AirPlay कनेक्शन बनाएँ; ऐप एक समय में केवल एक जुड़े हुए डिस्प्ले का इस्तेमाल कर सकता है और टीवी या प्रोजेक्टर स्वयं नहीं खोज सकता। AirPlay डिस्कनेक्ट करने पर कास्ट सत्र भी समाप्त होता है।";
"faq_question_6" = "मुझे अपना खेल नहीं मिल रहा है। मुझे क्या करना चाहिए?";
"faq_answer_6" = "निकटतम खेल से शुरुआत करें। यदि केवल नाम, सेट, टीम या आरंभिक क्रम भिन्न है, तो उन्हें गेम सेटअप में समायोजित करें और सेटअप को त्वरित प्रारंभ में जोड़ें।\n\nयदि वर्तमान खेल नियमों को कवर नहीं कर सकते हैं, तो खेल के नाम, सामान्य प्रारूप, स्कोरिंग विधि और अपेक्षित प्रवाह के साथ फीडबैक भेजें।";
"faq_question_7" = "सदस्यता, साइन-इन और नए उपकरण कैसे काम करते हैं?";
"faq_answer_7" = "सदस्यता लाभ और खरीद रिकॉर्ड चालू खाते से जुड़े हुए हैं। सदस्यता खरीदने, रिडीम करने या बहाल करने से पहले साइन इन करें। नए डिवाइस पर, उसी खाते से साइन इन करें और सदस्यता केंद्र को रीफ्रेश करें।\n\nयदि भुगतान सफल हो जाता है लेकिन सदस्यता सक्रिय नहीं है, तो पहले सदस्यता पृष्ठ को ताज़ा करें। यदि यह अभी भी गलत है, तो ऑर्डर नंबर, खरीदारी का समय और साइन-इन खाते के साथ फीडबैक भेजें।";
"faq_question_8" = "मैं किसी समस्या की रिपोर्ट कैसे करूँ या किसी सुविधा का सुझाव कैसे दूँ?";
"faq_answer_8" = "मैं → प्रतिक्रिया खोलें और बग रिपोर्ट या फीचर सुझाव चुनें। खेल, कदम, अपेक्षित परिणाम और वास्तविक परिणाम शामिल करें। प्रदर्शन या सदस्यता संबंधी समस्याओं के लिए, डिवाइस मॉडल, सिस्टम संस्करण और ऐप संस्करण भी शामिल करें।";
"faq_question_10" = "मैं अपने डेटा का बैकअप कैसे ले सकता हूं या इसे नए फोन में कैसे ले जा सकता हूं?";
"faq_answer_10" = "डिवाइसों के बीच सहेजे गए टीम और खिलाड़ियों के नाम तथा स्थान सिंक करने के लिए साइन इन करें। नए फ़ोन पर वही खाता इस्तेमाल करके यह डेटा प्राप्त करें। मैच रिकॉर्ड, टाइमर रिकॉर्ड और अधूरे मैच वर्तमान डिवाइस पर ही रहते हैं; इनके लिए क्लाउड बैकअप और पुनर्स्थापन उपलब्ध नहीं है।";
"faq_question_11" = "मेरा डेटा और गोपनीयता कैसे संभाली जाती है?";
"faq_answer_11" = "गोपनीयता नीति बताती है कि कौन-सा डेटा इस्तेमाल होता है और क्यों। माइक्रोफ़ोन वॉयस नोट रिकॉर्ड करने के लिए इस्तेमाल होता है। कैमरा विश्वसनीय साइन-इन QR कोड स्कैन करने और प्रोफ़ाइल फ़ोटो लेने के लिए इस्तेमाल होता है।";
