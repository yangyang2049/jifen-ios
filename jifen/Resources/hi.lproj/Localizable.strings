"scoreboard_usage_hint_football" = "👆 1 गोल जोड़ने के लिए बाएँ/दाएँ स्कोर क्षेत्र पर टैप करें\n⬆️ जोड़ने के लिए ऊपर की ओर स्वाइप करें\n⬇️ घटाने के लिए नीचे स्वाइप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n⏱️ नीचे-दाएं मेनू से चोट का समय खोलें, एक अवधि चुनें, फिर पूर्ववत करें या पुष्टि करें\n🏁 दूसरे हाफ और चोट के समय के बाद, एक टाई मैच 15 मिनट के दो अतिरिक्त हाफ तक जारी रह सकता है";
"scoreboard_usage_hint_basketball" = "👆 टीम के लिए +1, +2, या +3 टैप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n🚩 फाउल जोड़ने के लिए फाउल क्षेत्र पर टैप करें; एक को हटाने के लिए देर तक दबाएँ\n⏱️ घड़ी, अवधि और टाइमआउट के लिए बास्केटबॉल पैनल का उपयोग करें";
"scoreboard_usage_hint_basketball_training" = "🏀 शॉट रिकॉर्ड करने के लिए मिस या सफल ज़ोन पर टैप करें\n↩️ पिछले रिकॉर्ड को पूर्ववत करने के लिए बाएं स्वाइप करें\n⏹️ रीसेट और प्रशिक्षण समाप्त करें नीचे-दाएं मेनू में हैं";
"scoreboard_usage_hint_three_basketball" = "👆 टीम के लिए स्कोर बटन पर टैप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n🚩 फाउल जोड़ने के लिए फाउल क्षेत्र पर टैप करें; एक को हटाने के लिए देर तक दबाएँ\n⏱️ घड़ी, अवधि और टाइमआउट के लिए बास्केटबॉल पैनल का उपयोग करें";
"scoreboard_usage_hint_volleyball" = "👆 जोड़ने के लिए बाएँ/दाएँ स्कोर क्षेत्र पर टैप करें\n⬆️ जोड़ने के लिए ऊपर की ओर स्वाइप करें\n⬇️ घटाने के लिए नीचे स्वाइप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n🏁 सेट और गेम पॉइंट वॉलीबॉल नियमों का पालन करते हैं";
"scoreboard_usage_hint_beach_volleyball" = "👆 जोड़ने के लिए बाएँ/दाएँ स्कोर क्षेत्र पर टैप करें\n⬆️ जोड़ने के लिए ऊपर की ओर स्वाइप करें\n⬇️ घटाने के लिए नीचे स्वाइप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n🏁 सेट और गेम पॉइंट बीच वॉलीबॉल नियमों का पालन करते हैं";
"scoreboard_usage_hint_air_volleyball" = "👆 जोड़ने के लिए बाएँ/दाएँ स्कोर क्षेत्र पर टैप करें\n⬆️ जोड़ने के लिए ऊपर की ओर स्वाइप करें\n⬇️ घटाने के लिए नीचे स्वाइप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n🏁 सेट और गेम पॉइंट एयर वॉलीबॉल नियमों का पालन करते हैं";
"scoreboard_usage_hint_pingpong" = "👆 जोड़ने के लिए बाएँ/दाएँ स्कोर क्षेत्र पर टैप करें\n⬆️ जोड़ने के लिए ऊपर की ओर स्वाइप करें\n⬇️ घटाने के लिए नीचे स्वाइप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n🏁 सेट, गेम प्वाइंट और फिनिश टेबल टेनिस नियमों का पालन करें";
"scoreboard_usage_hint_pingpong_doubles" = "👆 जोड़ने के लिए बाएँ/दाएँ स्कोर क्षेत्र पर टैप करें\n⬆️ जोड़ने के लिए ऊपर की ओर स्वाइप करें\n⬇️ घटाने के लिए नीचे स्वाइप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n🏁 सेट, गेम प्वाइंट और फिनिश टेबल टेनिस नियमों का पालन करें\n👥 डबल्स सेटअप के खिलाड़ियों और सर्व की बारी को दिखाता है";
"scoreboard_usage_hint_tennis" = "👆 एक अंक रिकॉर्ड करने के लिए बाएं/दाएं स्कोर क्षेत्र पर टैप करें\n⬆️ जोड़ने के लिए ऊपर की ओर स्वाइप करें\n⬇️ घटाने के लिए नीचे स्वाइप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n🎾 0/15/30/40, ड्यूस, एडवांटेज, गेम्स और सेट स्वचालित हैं";
"scoreboard_usage_hint_tennis_doubles" = "👆 एक अंक रिकॉर्ड करने के लिए बाएं/दाएं स्कोर क्षेत्र पर टैप करें\n⬆️ जोड़ने के लिए ऊपर की ओर स्वाइप करें\n⬇️ घटाने के लिए नीचे स्वाइप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n🎾 0/15/30/40, ड्यूस, एडवांटेज, गेम्स और सेट स्वचालित हैं\n👥डबल्स खिलाड़ियों को सेटअप से दिखाता है";
"scoreboard_usage_hint_badminton" = "👆 जोड़ने के लिए बाएँ/दाएँ स्कोर क्षेत्र पर टैप करें\n⬆️ जोड़ने के लिए ऊपर की ओर स्वाइप करें\n⬇️ घटाने के लिए नीचे स्वाइप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n🏁 सेट और गेम पॉइंट बैडमिंटन नियमों का पालन करते हैं";
"scoreboard_usage_hint_badminton_doubles" = "👆 जोड़ने के लिए बाएँ/दाएँ स्कोर क्षेत्र पर टैप करें\n⬆️ जोड़ने के लिए ऊपर की ओर स्वाइप करें\n⬇️ घटाने के लिए नीचे स्वाइप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n🏁 सेट और गेम पॉइंट बैडमिंटन नियमों का पालन करते हैं\n👥डबल्स खिलाड़ियों को सेटअप से दिखाता है";
"scoreboard_usage_hint_pickleball" = "👆 जोड़ने के लिए बाएँ/दाएँ स्कोर क्षेत्र पर टैप करें\n⬆️ जोड़ने के लिए ऊपर की ओर स्वाइप करें\n⬇️ घटाने के लिए नीचे स्वाइप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n🏁स्कोर और सेट पिकलबॉल नियमों का पालन करते हैं";
"scoreboard_usage_hint_pickleball_doubles" = "👆 जोड़ने के लिए बाएँ/दाएँ स्कोर क्षेत्र पर टैप करें\n⬆️ जोड़ने के लिए ऊपर की ओर स्वाइप करें\n⬇️ घटाने के लिए नीचे स्वाइप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n🏁स्कोर और सेट पिकलबॉल नियमों का पालन करते हैं\n👥डबल्स खिलाड़ियों को सेटअप से दिखाता है";
"scoreboard_usage_hint_archery" = "👆 प्रतियोगी के क्षेत्र पर टैप करें और हर तीर तथा एंड के अंक दर्ज करने के लिए तीर का मान चुनें\n↩️ गलती पूर्ववत करने के लिए बाएँ स्वाइप करें\n🏹 सेट अंक चुने गए तीरंदाजी प्रारूप के अनुसार होते हैं\n🎯 5–5 पर स्क्रीन पर केंद्र के सबसे पास वाले तीर का शूट-ऑफ़ करें";
"scoreboard_usage_hint_boxing" = "🥊 राउंड के लिए दोनों मुक्केबाजों के स्कोर दर्ज करने के लिए राउंड एक्शन का उपयोग करें\n📊 एक राउंड पूरा करने पर जीते गए कुल अंक और राउंड अपडेट होते हैं\n↩️ मेनू से गलतियों को पूर्ववत करें\n✏️ सुधार की आवश्यकता होने पर संपादित करें या समाप्त करें का उपयोग करें";
"scoreboard_usage_hint_billiards" = "👆 जोड़ने के लिए बाएँ/दाएँ स्कोर क्षेत्र पर टैप करें\n⬆️ जोड़ने के लिए ऊपर की ओर स्वाइप करें\n⬇️ घटाने के लिए नीचे स्वाइप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n✏️ सही करने, स्क्रीनशॉट लेने या ख़त्म करने के लिए संपादन या मेनू का उपयोग करें";
"scoreboard_usage_hint_eight_ball" = "👆 रैक रिकॉर्ड करने के लिए बाएं/दाएं स्कोर क्षेत्र पर टैप करें\n⬆️ 1 रैक जोड़ने के लिए ऊपर की ओर स्वाइप करें\n⬇️ 1 रैक घटाने के लिए नीचे स्वाइप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n🏁 मैच लक्ष्य रैक द्वारा समाप्त होता है";
"scoreboard_usage_hint_nine_ball" = "👆 चेज़ पॉइंट रिकॉर्ड करने के लिए किसी खिलाड़ी, गेंद या इवेंट बटन पर टैप करें\n🎱 यह चेज़-प्वाइंट अभ्यास है; स्क्रीन पर दिखाई गई गेंदों और घटनाओं का उपयोग करें\n↩️ गलती होने पर पहले बाईं ओर स्वाइप करें या पूर्ववत करें का उपयोग करें\n✏️ विस्तृत सुधार की आवश्यकता होने पर संपादन का उपयोग करें";
"scoreboard_usage_hint_snooker" = "🔴 स्कोर करने के लिए लाल, रंग या स्कोर बटन पर टैप करें\n⚠️ पेनल्टी पॉइंट रिकॉर्ड करने के लिए फाउल का उपयोग करें\n🔁 स्ट्राइकर बदलने के लिए स्विच टर्न पर टैप करें\n↩️ पहले गलतियाँ पूर्ववत करें, या संपादन का उपयोग करें\n☑️ जरूरत पड़ने पर नीचे-दाएं मेनू से सेटल खोलें";
"scoreboard_usage_hint_guandan" = "👆 प्रत्येक परिणाम और स्तर की प्रगति को रिकॉर्ड करने के लिए बाएं और दाएं नियंत्रण का उपयोग करें\n↕️ संपादन मोड में, इसके स्तर को तुरंत बदलने के लिए दोनों तरफ लंबवत स्वाइप करें\n🅰️ पासिंग ए, रीसेट, पूर्ववत और मैन्युअल फिनिश बोर्ड या मेनू पर उपलब्ध हैं\n↩️ मौजूदा स्तर से आगे बढ़ने से पहले गलती को पूर्ववत करें";
"scoreboard_usage_hint_shengji" = "👆 किसी भी टीम के लिए डीलर बनने की बोली लगाएँ पर टैप करके शुरुआत करें\n🏆 डीलर बनें या +1, +2, और +3 बटन के साथ प्रत्येक राउंड को रिकॉर्ड करें\n↩️ मेनू से पिछले राउंड को पूर्ववत करें\n✏️ टीम के नाम और स्तर संपादित करने के लिए ऊपर दाईं ओर पेंसिल पर टैप करें\n🔄 मैच को मैन्युअल रूप से रीसेट या समाप्त करें";
"scoreboard_usage_hint_uno" = "👆 राउंड-स्कोरिंग पैनल खोलने के लिए किसी खिलाड़ी को टैप करें\n✏️ नाम और स्कोर संपादित करने के लिए किसी खिलाड़ी को देर तक दबाकर रखें\n↩️ पिछले राउंड को पूर्ववत करें\n☑️ मैच को मैन्युअल रूप से निपटाएं या समाप्त करें\n🖼️ डिस्प्ले सेटिंग्स और स्क्रीनशॉट मेनू में हैं";
"scoreboard_usage_hint_doudizhu" = "➕ राउंड सेटलमेंट खोलने के लिए नीचे केंद्र में प्लस बटन पर टैप करें\n🧮 आधार स्कोर, गुणक और एक विजेता या एक हारने वाले को छोड़कर सभी को चुनें\n↩️ पिछले राउंड को पूर्ववत करने के लिए बाएं स्वाइप करें या मेनू का उपयोग करें\n✏️ खिलाड़ियों और स्कोर को संपादित करने के लिए ऊपर दाईं ओर पेंसिल पर टैप करें\n🔄 मैच को मैन्युअल रूप से रीसेट या समाप्त करें";
"scoreboard_usage_hint_foosball" = "👆 1 गोल जोड़ने के लिए बाएँ/दाएँ स्कोर क्षेत्र पर टैप करें\n⬆️ जोड़ने के लिए ऊपर की ओर स्वाइप करें\n⬇️ घटाने के लिए नीचे स्वाइप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n☑️ मैच ख़त्म होने पर सेटल या फ़िनिश का उपयोग करें";
"scoreboard_usage_hint_foosball_doubles" = "👆 1 गोल जोड़ने के लिए बाएँ/दाएँ स्कोर क्षेत्र पर टैप करें\n⬆️ जोड़ने के लिए ऊपर की ओर स्वाइप करें\n⬇️ घटाने के लिए नीचे स्वाइप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n👥 2V2 नाम मैच से पहले सेट किए गए हैं\n☑️ मैच ख़त्म होने पर सेटल या फ़िनिश का उपयोग करें";
"scoreboard_usage_hint_simple_score" = "👆 जोड़ने के लिए बाएँ/दाएँ स्कोर क्षेत्र पर टैप करें\n⬆️ जोड़ने के लिए ऊपर की ओर स्वाइप करें\n⬇️ घटाने के लिए नीचे स्वाइप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n✏️ नाम और स्कोर बदलने के लिए देर तक दबाकर रखें या संपादित करें";
"scoreboard_usage_hint_multi_scoreboard" = "👆 1 अंक जोड़ने के लिए प्लेयर टाइल पर टैप करें\n⬆️ 1 जोड़ने के लिए ऊपर की ओर स्वाइप करें; ⬇️ 1 घटाने के लिए नीचे स्वाइप करें\n↩️ पूर्ववत करने के लिए बाएं स्वाइप करें\n✏️ नाम और स्कोर संपादित करने के लिए किसी खिलाड़ी को देर तक दबाकर रखें\n🎛️ कस्टम एडजस्ट मोड में, किसी प्लेयर को टैप करने से एडजस्टमेंट पैनल खुल जाता है";
