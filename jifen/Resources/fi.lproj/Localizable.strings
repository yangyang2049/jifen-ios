"scoreboard_usage_hint_snooker" = "🔴 Napauta punaisia, väri- tai tulospainikkeita saadaksesi pisteet\n⚠️ Käytä virhettä rangaistuspisteiden kirjaamiseen\n🔁 Napauta Vaihda vuoroa vaihtaaksesi lyöntivuorossa olevaa pelaajaa\n↩️ Kumoa ensin virheet tai käytä muokkausta\n☑️ Avaa Päätä freimi tarvittaessa oikeasta alakulmasta";
"scoreboard_usage_hint_guandan" = "👆 Käytä vasenta ja oikeaa säädintä tallentaaksesi jokaisen tuloksen ja tason edistymisen\n↕️ Pyyhkäise muokkaustilassa pystysuunnassa molemmin puolin muuttaaksesi sen tasoa nopeasti\n🅰️ A-tason läpäisy, nollaus, kumoaminen ja manuaalinen viimeistely ovat käytettävissä taululla tai valikosta\n↩️ Kumoa virhe ennen kuin jatkat nykyiseltä tasolta";
"scoreboard_usage_hint_shengji" = "👆 Aloita napauttamalla jommankumman joukkueen Tarjoa jakajan roolista\n🏆 Tallenna jokainen kierros Ota jakajan rooli -painikkeella tai +1-, +2- ja +3-painikkeilla\n↩️ Kumoa edellinen kierros valikosta\n✏️ Napauta oikeassa yläkulmassa olevaa kynää muokataksesi joukkueiden nimiä ja tasoja\n🔄 Nollaa tai viimeistele ottelu manuaalisesti";
"scoreboard_usage_hint_uno" = "👆 Napauta pelaajaa avataksesi kierroksen pisteytyspaneelin\n✏️ Paina pelaajaa pitkään muokataksesi nimeä ja tulosta\n↩️ Kumoa edellinen kierros\n☑️ Selvitä tai viimeistele ottelu manuaalisesti\n🖼️ Näyttöasetukset ja kuvakaappaukset ovat valikossa";
"scoreboard_usage_hint_doudizhu" = "➕ Napauta pluspainiketta alhaalla keskellä avataksesi kierroksen pistejaon\n🧮 Valitse peruspisteet, kerroin ja joko yksi voittaja tai kaikki paitsi yksi häviäjä\n↩️ Pyyhkäise vasemmalle tai käytä valikkoa peruuttaaksesi edellinen kierros\n✏️ Napauta oikeassa yläkulmassa olevaa kynää muokataksesi pelaajia ja tuloksia\n🔄 Nollaa tai viimeistele ottelu manuaalisesti";
"scoreboard_usage_hint_foosball" = "👆 Napauta vasenta/oikeaa tulosaluetta lisätäksesi 1 maalin\n⬆️ Lisää pyyhkäisemällä ylös\n⬇️ Vähennä pyyhkäisemällä alas\n↩️ Kumoa pyyhkäisemällä vasemmalle\n☑️ Käytä Päätä tai Lopeta, kun ottelu päättyy";
