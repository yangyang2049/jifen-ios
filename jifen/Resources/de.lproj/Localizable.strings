"scoreboard_usage_hint_badminton" = "👆 Zum Hinzufügen in den linken oder rechten Punktebereich tippen\n⬆️ Zum Hinzufügen nach oben wischen\n⬇️ Zum Abziehen nach unten wischen\n↩️ Zum Rückgängigmachen nach links wischen\n🏁 Sätze und Satzbälle folgen den Badmintonregeln";
"scoreboard_usage_hint_badminton_doubles" = "👆 Zum Hinzufügen in den linken oder rechten Punktebereich tippen\n⬆️ Zum Hinzufügen nach oben wischen\n⬇️ Zum Abziehen nach unten wischen\n↩️ Zum Rückgängigmachen nach links wischen\n🏁 Sätze und Satzbälle folgen den Badmintonregeln\n👥 Im Doppel werden die Spieler aus den Einstellungen angezeigt";
"scoreboard_usage_hint_pickleball" = "👆 Zum Hinzufügen in den linken oder rechten Punktebereich tippen\n⬆️ Zum Hinzufügen nach oben wischen\n⬇️ Zum Abziehen nach unten wischen\n↩️ Zum Rückgängigmachen nach links wischen\n🏁 Punktestand und Sätze folgen den Pickleballregeln";
"scoreboard_usage_hint_pickleball_doubles" = "👆 Zum Hinzufügen in den linken oder rechten Punktebereich tippen\n⬆️ Zum Hinzufügen nach oben wischen\n⬇️ Zum Abziehen nach unten wischen\n↩️ Zum Rückgängigmachen nach links wischen\n🏁 Punktestand und Sätze folgen den Pickleballregeln\n👥 Im Doppel werden die Spieler aus den Einstellungen angezeigt";
"scoreboard_usage_hint_archery" = "👆 Auf einen Teilnehmer tippen und anschließend den Pfeilwert wählen, um jeden Pfeil und jede Passe zu erfassen\n↩️ Zum Rückgängigmachen eines Fehlers nach links wischen\n🏹 Die Satzpunkte folgen dem gewählten Bogenschießformat\n🎯 Bei 5:5 dem angezeigten Stechen „Am nächsten zur Mitte“ folgen";
"scoreboard_usage_hint_boxing" = "🥊 Über die Rundenaktion die Wertungen beider Boxer für die Runde eingeben\n📊 Beim Abschluss einer Runde werden Gesamtpunkte und gewonnene Runden aktualisiert\n↩️ Fehler über das Menü rückgängig machen\n✏️ Für Korrekturen „Bearbeiten“ oder „Beenden“ verwenden";
"scoreboard_usage_hint_billiards" = "👆 Zum Hinzufügen in den linken oder rechten Punktebereich tippen\n⬆️ Zum Hinzufügen nach oben wischen\n⬇️ Zum Abziehen nach unten wischen\n↩️ Zum Rückgängigmachen nach links wischen\n✏️ Zum Korrigieren, Erstellen eines Screenshots oder Beenden „Bearbeiten“ oder das Menü verwenden";
"scoreboard_usage_hint_eight_ball" = "👆 Zum Erfassen eines Racks in den linken oder rechten Punktebereich tippen\n⬆️ Zum Hinzufügen eines Racks nach oben wischen\n⬇️ Zum Abziehen eines Racks nach unten wischen\n↩️ Zum Rückgängigmachen nach links wischen\n🏁 Das Spiel endet bei der festgelegten Anzahl Racks";
"scoreboard_usage_hint_nine_ball" = "👆 Auf einen Spieler, Ball oder eine Ereignisschaltfläche tippen, um Punkte der Punktejagd zu erfassen\n🎱 Dies ist ein Punktejagd-Training; verwenden Sie die angezeigten Bälle und Ereignisse\n↩️ Bei einem Fehler zunächst nach links wischen oder „Rückgängig“ verwenden\n✏️ Für detaillierte Korrekturen „Bearbeiten“ verwenden";
"scoreboard_usage_hint_snooker" = "🔴 Zum Punkten auf Rot, eine Farbe oder eine Punkteschaltfläche tippen\n⚠️ Strafpunkte über „Foul“ erfassen\n🔁 Über „Spieler wechseln“ den Spieler am Tisch ändern\n↩️ Fehler zunächst rückgängig machen oder „Bearbeiten“ verwenden\n☑️ Bei Bedarf unten rechts im Menü „Abrechnen“ öffnen";
"scoreboard_usage_hint_guandan" = "👆 Mit den Bedienelementen links und rechts jedes Ergebnis und den Stufenfortschritt erfassen\n↕️ Im Bearbeitungsmodus auf einer Seite vertikal wischen, um deren Stufe schnell zu ändern\n🅰️ A bestehen, Zurücksetzen, Rückgängig und manuelles Beenden sind auf dem Punktestand oder im Menü verfügbar\n↩️ Fehler rückgängig machen, bevor Sie von der aktuellen Stufe aus fortfahren";
"scoreboard_usage_hint_shengji" = "👆 Zunächst für eines der Teams auf „Geber ansagen“ tippen\n🏆 Jede Runde über „Geber übernehmen“ oder +1, +2 und +3 erfassen\n↩️ Die vorherige Runde über das Menü rückgängig machen\n✏️ Oben rechts auf den Stift tippen, um Teamnamen und Stufen zu bearbeiten\n🔄 Das Spiel manuell zurücksetzen oder beenden";
"scoreboard_usage_hint_uno" = "👆 Auf einen Spieler tippen, um die Rundenabrechnung zu öffnen\n✏️ Einen Spieler lange drücken, um Name und Punktzahl zu bearbeiten\n↩️ Die vorherige Runde rückgängig machen\n☑️ Eine Runde abrechnen oder das Spiel manuell beenden\n🖼️ Anzeigeeinstellungen und Screenshots befinden sich im Menü";
"scoreboard_usage_hint_doudizhu" = "➕ Unten in der Mitte auf Plus tippen, um die Rundenabrechnung zu öffnen\n🧮 Basispunktzahl, Multiplikator und entweder einen Sieger oder alle bis auf einen Verlierer wählen\n↩️ Zum Rückgängigmachen der vorherigen Runde nach links wischen oder das Menü verwenden\n✏️ Oben rechts auf den Stift tippen, um Spieler und Punktzahlen zu bearbeiten\n🔄 Das Spiel manuell zurücksetzen oder beenden";
"scoreboard_usage_hint_foosball" = "👆 Zum Hinzufügen eines Tors in den linken oder rechten Punktebereich tippen\n⬆️ Zum Hinzufügen nach oben wischen\n⬇️ Zum Abziehen nach unten wischen\n↩️ Zum Rückgängigmachen nach links wischen\n☑️ Am Spielende „Abrechnen“ oder „Beenden“ verwenden";
