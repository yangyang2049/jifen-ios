"scoreboard_usage_hint_snooker" = "🔴 স্কোর করতে লাল, রঙ বা স্কোর বোতামে ট্যাপ করুন\n⚠️ পেনাল্টি পয়েন্ট রেকর্ড করতে ফাউল ব্যবহার করুন\n🔁 স্ট্রাইকার পরিবর্তন করতে সুইচ টার্নে ট্যাপ করুন\n↩️ প্রথমে ভুলগুলি পূর্বাবস্থায় ফেরান, অথবা সম্পাদনা ব্যবহার করুন৷\n☑️ প্রয়োজনে নীচে-ডান মেনু থেকে সেটেল খুলুন";
"scoreboard_usage_hint_guandan" = "👆 প্রতিটি ফলাফল এবং স্তরের অগ্রগতি রেকর্ড করতে বাম এবং ডান নিয়ন্ত্রণগুলি ব্যবহার করুন\n↕️ সম্পাদনা মোডে, এর স্তর দ্রুত পরিবর্তন করতে উভয় পাশে উল্লম্বভাবে সোয়াইপ করুন\n🅰️ A পাস করা, রিসেট, পূর্বাবস্থায় ফেরানো এবং ম্যানুয়াল ফিনিশ বোর্ড বা মেনুতে পাওয়া যায়\n↩️ বর্তমান স্তর থেকে চালিয়ে যাওয়ার আগে একটি ভুল পূর্বাবস্থায় ফেরান";
