  "designRules": [
    "复杂业务与多步表单进入同一个 NavigationStack 的独立页面，避免 sheet 内再 sheet",
    "短确认、日期/时间选择、扫码、登录、系统分享可以继续用适合的系统/品牌浮层",
    "原生 TextField/DatePicker 可以继续承担输入与无障碍行为；需替换的是原生 Form/List 的外观和布局，非重造输入系统",
    "统一字段标题、必填标记、输入灰底、错误提示、计数、固定底部提交；校验语义取现有模型和服务端能力"
  ],
  "groups": [
    "入口与通知",
    "概览",
    "活动",
    "战绩",
    "成员与管理",
    "历史兼容"
  ],
  "decisions": [
    {
      "topic": "独立页与弹层",
      "difference": "旧 Android 10-09 表单稿和 10-12 活动稿仍把复杂流程放 dialog/sheet；当前 Android/鸿蒙已将主要业务移入页面。",
      "decision": "按当前实现对齐：手机复杂业务 push；短确认、日期、扫码和系统分享保留适合的浮层。iPad 可继续同一表单的居中适配。",
      "status": "建议采用"
    },
    {
      "topic": "表单输入外观",
      "difference": "Android 创建活动是浅底自绘字段，创建/修改小组仍是 Material 描边；鸿蒙更多白底描边，iOS 已有动态灰底输入 token。",
      "decision": "统一字段结构、标签、间距、选择状态和底部操作；iOS 复用 Theme.inputFieldBackground 与现有圆角，不照搬尚未统一的 Material 外观。",
      "status": "建议采用"
    },
    {
      "topic": "队员选择",
      "difference": "iOS 当前主要 push 到选择名单；Android/鸿蒙已支持席位下内联选择。",
      "decision": "对阵编辑使用内联名单，保留完整姓名、禁选已占用者和搜索；转让等单一选择仍可独立页/短选择层。",
      "status": "建议采用"
    },
    {
      "topic": "规则编辑",
      "difference": "Android 点摘要开自定义浮层，鸿蒙本页可折叠；iOS 再开一张 Form sheet。",
      "decision": "常用规则就地展开、选项立即生效；高级规则才进子页，冻结规则只读。",
      "status": "建议采用"
    },
    {
      "topic": "战绩要不要子 tab",
      "difference": "三端当前都主要是同页分段，单双打是榜单筛选，不是真正子 tab。",
      "decision": "本轮13页预览采用现有分段，不新增子 tab；后续如需新增分层，应单独评审且不改变统计口径。",
      "status": "可选后续方案"
    },
    {
      "topic": "报名管理",
      "difference": "Android/鸿蒙在独立活动页切管理模式；iOS sheet 内 push 预览，已有草稿与离开保护。",
      "decision": "iOS 使用活动详情 → 报名管理的同栈路径，底栏显示变更/容量并直接保存；保留草稿退出保护与必要版本冲突复核。",
      "status": "建议采用"
    },
    {
      "topic": "训练组与旧综合稿",
      "difference": "旧综合稿包含训练/轮转/联赛；创建已限定 peer，但存量 coaching 仍有兼容路径。",
      "decision": "本轮只改熟人组。保留训练源码的边界标注，不把旧原型演示当作当前功能承诺。",
      "status": "维持现有范围"
    }
  ],
  "stages": [
    {
      "name": "先修页面承载与成功后的返回路径",
      "description": "创建/加入、开始/补记、创建活动、直接排赛、报名管理、排赛、纠正上传迁移到同一个导航栈。先解决创建或加入后整组浏览仍被装在 sheet 的问题。",
      "acceptance": "逐条验证进入、返回、成功跳转、取消与草稿；原页面的 tab 和滚动位置保持。"
    },
    {
      "name": "提取共用表单，再替换 13 处熟人组系统 Form",
      "description": "复用现有卡片、主题输入底色、选项网格、比分快捷控件和确认 dialog。共用字段标题/提示/错误/计数、选择行、人数步进、日期行与底部动作区；替换覆盖 13 处熟人组可用 Form 的系统布局（管理 Form 包含多个模式）。",
      "acceptance": "深浅色、320/390 宽、大字号、键盘遮挡、长姓名/地点和提交中状态均可操作。"
    },
    {
      "name": "收齐 tab 内的列表与短操作",
      "description": "活动详情分成信息/报名/场次卡；战绩保留已有结果卡并统一纠正上传；成员按最新审批双按钮和分段列表统一。短状态动作改统一确认 dialog。",
      "acceptance": "排行/记录筛选独立、报名容量、权限、冻结场次、离线与账号切换等原行为不回退。"
    },
    {
      "name": "单独评审可选信息架构变化",
      "description": "在主要表单和导航统一后，再决定战绩是否拆比赛记录/排行榜两个子 tab。旧 HTML 的多个候选方案只当比较材料。",
      "acceptance": "不借 UI 改造新增训练/轮转/联赛或改变容量、排行、确认和结果契约。"
    }
  ],
