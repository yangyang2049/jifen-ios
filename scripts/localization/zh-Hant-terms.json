{
  "replacements": [
    { "from": "屏幕", "to": "螢幕" },
    { "from": "投屏", "to": "投影" },
    { "from": "默認", "to": "預設" },
    { "from": "添加", "to": "新增" },
    { "from": "連接", "to": "連線" },
    { "from": "數據", "to": "資料" },
    { "from": "設備", "to": "裝置" },
    { "from": "反饋", "to": "回饋" },
    { "from": "用戶", "to": "使用者" },
    { "from": "網絡", "to": "網路" },
    { "from": "視頻", "to": "影片" },
    { "from": "音頻", "to": "音訊" },
    { "from": "菜單", "to": "選單" },
    { "from": "占先", "to": "佔先" }
  ],
  "protectedSpans": [
    {
      "pattern": "行動數據",
      "why": "台灣對 mobile data 的通行說法，「數據→資料」會把它誤傷成「行動資料」。"
    },
    {
      "pattern": "《[^》]*(?:華為|鴻蒙|Apple|Google)[^》]*》",
      "why": "他方文件與協議的正式名稱，照抄，不按本端術語表改寫。"
    },
    {
      "pattern": "（如無線投屏[^）]*）",
      "why": "這一句的作用就是列舉系統裡實際顯示的開關名稱，改寫後使用者反而找不到入口。"
    }
  ],
  "platformKeyPrefixes": ["^cast_", "^airplay", "^share_", "^account_", "^apple_", "^login"],
  "simplifiedResidue": ["连","数","据","设","备","为","与","国","际","网","优","显","条","应","图","窗","页","员","单","机","组","级","颜","订","阅","传","简","类","统","杂","预","识","话","询","报","归","当","击","广","盘","点","录","发","变","团","队","长","门","问","阳","阴","云","电","号","占"]
}
